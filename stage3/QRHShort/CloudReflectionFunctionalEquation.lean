open OAI.CubicEisenstein

/-- The literal negative native-frequency phase at one fixed Fourier residue. -/
def quotientReflectionDatum (B : O) (σ : ThetaCusp) (d₀ : O) (hd₀ : d₀ ≠ 0)
    (a : O ⧸ principal B) : ReflectionDatum where
  cusp := σ
  phase m := breve (-cuspFrequency m *
    (3 * embedding (residueLift (principal B) a) / embedding B))
  phase_add m n := by
    have he : -cuspFrequency (m + n) *
        (3 * embedding (residueLift (principal B) a) / embedding B) =
      -cuspFrequency m * (3 * embedding (residueLift (principal B) a) / embedding B) +
      -cuspFrequency n * (3 * embedding (residueLift (principal B) a) / embedding B) := by
      simp only [cuspFrequency, map_add, add_div]
      ring
    rw [he, ThetaRealizationProof.breve_add]
  phase_norm m := by rw [breve_eq_breveE, breveE_norm]
  denominator := d₀
  denominator_ne_zero := hd₀

def cuspZTerm (σ : ThetaCusp) (φ : O → ℂ) (v : ℝ) (m : O) : ℂ :=
  latticeBesselTerm (embedding lambda ^ (-4 : ℤ)) (cuspZCoefficient σ φ) 0 v m

theorem cuspZTerm_mul (σ : ThetaCusp) (φ χ : O → ℂ) (v : ℝ) (m : O) :
    cuspZTerm σ (fun m => φ m * χ m) v m = φ m * cuspZTerm σ χ v m := by
  by_cases hm : m = 0
  · simp only [cuspZTerm, latticeBesselTerm, hm, ite_true, mul_zero]
  · simp only [cuspZTerm, latticeBesselTerm, ite_eq_right hm, cuspZCoefficient]
    ring

/-- The actual cusp derivative coefficient retains polynomial growth of the multiplier. -/
theorem cuspZCoefficient_polynomial_multiplier_bound (σ : ThetaCusp)
    (χ : O → ℂ) (C : ℝ) (p : ℕ)
    (hχ : ∀ m : O, m ≠ 0 → ‖χ m‖ ≤ C * ‖embedding m‖ ^ p)
    (m : O) (hm : m ≠ 0) :
    ‖cuspZCoefficient σ χ m‖ ≤ (18 * Real.pi * C) * ‖embedding m‖ ^ (p + 2) := by
  have h := cuspZCoefficient_polynomial_bound σ (fun _ => χ m)
    (C * ‖embedding m‖ ^ p) (fun _ => hχ m hm) m
  calc
    _ ≤ (18 * Real.pi * (C * ‖embedding m‖ ^ p)) * ‖embedding m‖ ^ 2 := h
    _ = _ := by rw [pow_add]; ring

/-- Genuine absolute convergence at every positive height, before any finite Fourier exchange. -/
theorem cuspZTerm_summable_polynomial (σ : ThetaCusp) (χ : O → ℂ)
    (C : ℝ) (p : ℕ) (hC : 0 ≤ C)
    (hχ : ∀ m : O, m ≠ 0 → ‖χ m‖ ≤ C * ‖embedding m‖ ^ p)
    (v : ℝ) (hv : 0 < v) : Summable (cuspZTerm σ χ v) := by
  obtain ⟨g, hg, _, hbound⟩ := latticeBessel_majorant_above v hv
    (embedding lambda ^ (-4 : ℤ)) dual_scale_ne_zero (cuspZCoefficient σ χ)
    (18 * Real.pi * C) (p + 2) (by positivity)
    (cuspZCoefficient_polynomial_multiplier_bound σ χ C p hχ)
  exact hg.of_norm_bounded (fun m => hbound m 0 v le_rfl)

/-- The exact identity is valid for an arbitrary finite multiplier; all transformed
rows are summable, and the only growth premise concerns the original chi factor. -/
theorem cuspZProfile_finite_fourier (B : O) (hB : B ≠ 0)
    (ψ : (O ⧸ principal B) → ℂ) (σ : ThetaCusp) (d₀ : O) (hd₀ : d₀ ≠ 0)
    (χ : O → ℂ) (C : ℝ) (p : ℕ) (hC : 0 ≤ C)
    (hχ : ∀ m : O, m ≠ 0 → ‖χ m‖ ≤ C * ‖embedding m‖ ^ p)
    (v : ℝ) (hv : 0 < v) :
    letI : Finite (O ⧸ principal B) := Ring.HasFiniteQuotients.finiteQuotient (principal_ne_bot B hB)
    letI : Fintype (O ⧸ principal B) := Fintype.ofFinite _
    cuspZProfile σ (fun m => ψ (Ideal.Quotient.mk (principal B) m) * χ m) v =
      ∑ a : O ⧸ principal B, sourceFourierWeight B hB ψ a *
        cuspZProfile σ (fun m => (quotientReflectionDatum B σ d₀ hd₀ a).phase m * χ m) v := by
  letI : Finite (O ⧸ principal B) := Ring.HasFiniteQuotients.finiteQuotient (principal_ne_bot B hB)
  letI : Fintype (O ⧸ principal B) := Fintype.ofFinite _
  have hf := cuspZTerm_summable_polynomial σ χ C p hC hχ v hv
  calc
    _ = ∑' m : O, ψ (Ideal.Quotient.mk (principal B) m) * cuspZTerm σ χ v m := by
      change (∑' m : O, cuspZTerm σ (fun m => ψ (Ideal.Quotient.mk (principal B) m) * χ m) v m) = _
      exact tsum_congr (fun m => cuspZTerm_mul σ _ χ v m)
    _ = ∑ a : O ⧸ principal B, sourceFourierWeight B hB ψ a *
        ∑' m : O, (quotientReflectionDatum B σ d₀ hd₀ a).phase m * cuspZTerm σ χ v m :=
      source_finite_fourier_tsum B hB ψ _ hf
    _ = _ := by
      apply Finset.sum_congr rfl
      intro a _
      congr 1
      change (∑' m : O, (quotientReflectionDatum B σ d₀ hd₀ a).phase m * cuspZTerm σ χ v m) =
        ∑' m : O, cuspZTerm σ (fun m => (quotientReflectionDatum B σ d₀ hd₀ a).phase m * χ m) v m
      exact tsum_congr (fun m => (cuspZTerm_mul σ _ χ v m).symm)

theorem finite_fourier_multiplier_summable (B : O) (hB : B ≠ 0)
    (ψ : (O ⧸ principal B) → ℂ) (σ : ThetaCusp) (χ : O → ℂ)
    (C : ℝ) (p : ℕ) (hC : 0 ≤ C)
    (hχ : ∀ m : O, m ≠ 0 → ‖χ m‖ ≤ C * ‖embedding m‖ ^ p)
    (v : ℝ) (hv : 0 < v) :
    Summable (cuspZTerm σ (fun m => ψ (Ideal.Quotient.mk (principal B) m) * χ m) v) := by
  have hf := quotient_multiplier_summable B hB ψ _
    (cuspZTerm_summable_polynomial σ χ C p hC hχ v hv)
  exact hf.congr (fun m => (cuspZTerm_mul σ
    (fun m => ψ (Ideal.Quotient.mk (principal B) m)) χ v m).symm)

theorem quotientReflectionDatum_term_summable (B : O) (σ : ThetaCusp) (d₀ : O)
    (hd₀ : d₀ ≠ 0) (a : O ⧸ principal B) (χ : O → ℂ)
    (C : ℝ) (p : ℕ) (hC : 0 ≤ C)
    (hχ : ∀ m : O, m ≠ 0 → ‖χ m‖ ≤ C * ‖embedding m‖ ^ p)
    (v : ℝ) (hv : 0 < v) :
    Summable (cuspZTerm σ (fun m => (quotientReflectionDatum B σ d₀ hd₀ a).phase m * χ m) v) := by
  have hf := (cuspZTerm_summable_polynomial σ χ C p hC hχ v hv).norm
  apply hf.of_norm_bounded
  intro m
  rw [cuspZTerm_mul, norm_mul, (quotientReflectionDatum B σ d₀ hd₀ a).phase_norm, one_mul]

/-- The Fourier weights have the same bound as psi, in particular one for a
unit-bounded finite multiplier. No bound is asserted for arbitrary unbounded psi. -/
theorem sourceFourierWeight_norm_le_one (B : O) (hB : B ≠ 0)
    (ψ : (O ⧸ principal B) → ℂ) (hψ : ∀ x, ‖ψ x‖ ≤ 1)
    (a : O ⧸ principal B) : ‖sourceFourierWeight B hB ψ a‖ ≤ 1 :=
  sourceFourierWeight_norm_bound B hB ψ 1 hψ a

/-- The pool, including its cusp, denominator and all phases, is fixed before
psi and before every moving multiplier or positive height. -/
theorem exists_finite_quotient_reflection_pool (B : O) (hB : B ≠ 0)
    (σ : ThetaCusp) (d₀ : O) (hd₀ : d₀ ≠ 0) :
    ∃ (N : ℕ) (data : Fin N → ReflectionDatum) (e : Fin N ≃ (O ⧸ principal B)),
      N = Nat.card (O ⧸ principal B) ∧
      (∀ i, (data i).cusp = σ ∧ (data i).denominator = d₀) ∧
      (∀ i m, (data i).phase m = (quotientReflectionDatum B σ d₀ hd₀ (e i)).phase m) := by
  letI : Finite (O ⧸ principal B) := Ring.HasFiniteQuotients.finiteQuotient (principal_ne_bot B hB)
  letI : Fintype (O ⧸ principal B) := Fintype.ofFinite _
  let e := (Fintype.equivFin (O ⧸ principal B)).symm
  exact ⟨Fintype.card (O ⧸ principal B), fun i => quotientReflectionDatum B σ d₀ hd₀ (e i),
    e, Nat.card_eq_fintype_card.symm, (fun _ => ⟨rfl, rfl⟩), (fun _ _ => rfl)⟩

theorem cuspZProfile_finite_fourier_fin (B : O) (hB : B ≠ 0)
    (ψ : (O ⧸ principal B) → ℂ) (σ : ThetaCusp) (d₀ : O) (hd₀ : d₀ ≠ 0)
    {N : ℕ} (e : Fin N ≃ (O ⧸ principal B))
    (χ : O → ℂ) (C : ℝ) (p : ℕ) (hC : 0 ≤ C)
    (hχ : ∀ m : O, m ≠ 0 → ‖χ m‖ ≤ C * ‖embedding m‖ ^ p)
    (v : ℝ) (hv : 0 < v) :
    cuspZProfile σ (fun m => ψ (Ideal.Quotient.mk (principal B) m) * χ m) v =
      ∑ i : Fin N, sourceFourierWeight B hB ψ (e i) *
        cuspZProfile σ (fun m => (quotientReflectionDatum B σ d₀ hd₀ (e i)).phase m * χ m) v := by
  letI : Finite (O ⧸ principal B) := Ring.HasFiniteQuotients.finiteQuotient (principal_ne_bot B hB)
  letI : Fintype (O ⧸ principal B) := Fintype.ofFinite _
  exact (cuspZProfile_finite_fourier B hB ψ σ d₀ hd₀ χ C p hC hχ v hv).trans
    (e.sum_comp (fun a : O ⧸ principal B => sourceFourierWeight B hB ψ a *
      cuspZProfile σ (fun m => (quotientReflectionDatum B σ d₀ hd₀ a).phase m * χ m) v)).symm

end QRHShort.CloudBatch.ReflectionDualFiniteMultiplier











end
end

