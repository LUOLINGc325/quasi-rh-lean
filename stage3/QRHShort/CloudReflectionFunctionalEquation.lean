  rw [deriv_fun_sub (h1 q₁ hq₁) ((h1 q₂ hq₂).const_mul κ),
    deriv_fun_sub (liftedConjugateResidual_line_differentiable q₁ hq₁ B hB ψ z Complex.I v hv)
      ((liftedConjugateResidual_line_differentiable q₂ hq₂ B hB ψ z Complex.I v hv).const_mul κ)]
  simp_rw [deriv_const_mul_field]
  ring

/-- The ramified difference has two genuinely different finite conductors.
