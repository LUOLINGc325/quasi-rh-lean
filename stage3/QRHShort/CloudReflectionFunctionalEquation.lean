      ∀ a r : O, IsCoprime r (M * c₀) → IsCoprime a (c₀ * r) →
        ∃ i : Fin N, ∃ g : SL(2, O), ∃ G : LevelThree,
          g 0 0 = ((pool i).unit : O) * a ∧
          g 1 0 = ((pool i).unit : O) * (c₀ * r) ∧
          M * c₀ ∣ a - (pool i).representative.val.1 ∧
          M * c₀ ∣ r - (pool i).representative.val.2 ∧
          M * (((pool i).unit : O) * c₀) ∣ g 1 1 - (pool i).base 1 1 ∧
          g = (G : SL(2, O)) * rationalMatrix (pool i).rational *
            manuscriptCuspMatrix (pool i).cusp := by
  obtain ⟨N, reps, hreps⟩ := exists_fixed_cusp_completion_pool M c₀ hM hc₀
  choose pool hpool using fun i : Fin N => exists_cuspPoolDatum M c₀ (reps i)
  refine ⟨N, pool, ?_⟩
  intro a r hr har
  obtain ⟨i, _, _, _, ha, hrr, _, _⟩ := hreps a r hr har
  rw [← hpool i] at ha hrr
  let d := pool i
  let u : O := d.unit
  have hu : IsUnit u := d.unit.isUnit
  have huc₀ : u * c₀ ≠ 0 := mul_ne_zero hu.ne_zero hc₀
