    (OAI.ReflectionFEJacobi.three_dvd_primary_sub_one n hnsp.2)
  have hb : IsPrimary b := (isPrimary_iff_three_dvd b).mpr
    (OAI.ReflectionFEJacobi.three_dvd_primary_sub_one b hbsp.2)
