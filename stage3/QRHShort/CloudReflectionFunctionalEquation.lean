private theorem tauLattice_neg (h : O) : tauLattice (-h) = tauLattice h := by
  simp only [tauLattice, embedding_neg, mul_neg, tau_neg]

/-- The same fixed coefficients work for all six units, not only the three
positive cubic roots. -/
theorem ramifiedDifference_unit_primary_modes_finite_span :
    ∃ C : RamifiedNineGroup → ℂ, ∀ (u : Oˣ) (m : ℕ) (n b : O),
      PrimaryCubeData n b →
      ramifiedDifferenceCoefficient ((u : O) * lambda ^ m * (n * b ^ 3)) =
        ∑ j : RamifiedNineGroup, C j *
          star (cubicSymbol (principal n) (ramifiedUpShift j)) *
          tauLattice (ramifiedUpShift j * ((u : O) * lambda ^ m * (n * b ^ 3))) := by
  obtain ⟨C, hC⟩ := ramifiedDifference_all_primary_modes_finite_span
  refine ⟨C, ?_⟩
  intro u m n b hnb
  obtain ⟨a, ha | ha⟩ := OAI.CubicEisenstein.unit_eq_sign_omega u
  · change (u : O) = omega ^ a.val at ha
    simpa only [ha, ZMod.val_natCast, Nat.mod_eq_of_lt a.isLt] using
      hC (a.val : ZMod 3) m n b hnb
  · change (u : O) = -omega ^ a.val at ha
    rw [ha, neg_mul, neg_mul, ramifiedDifference_neg]
    simp only [mul_neg, tauLattice_neg]
    simpa only [ZMod.val_natCast, Nat.mod_eq_of_lt a.isLt] using
      hC (a.val : ZMod 3) m n b hnb

/-- Changing from the paper's trace generator to the ring generator only
changes the genuine unit factor; it does not change the fixed coefficient pool. -/
theorem ramifiedDifference_ring_unit_modes_finite_span :
    ∃ C : RamifiedNineGroup → ℂ, ∀ (u : Oˣ) (m : ℕ) (n b : O),
      PrimaryCubeData n b →
      ramifiedDifferenceCoefficient
        ((u : O) * OAI.ActualEisensteinCubic.lambda ^ m * (n * b ^ 3)) =
        ∑ j : RamifiedNineGroup, C j *
          star (cubicSymbol (principal n) (ramifiedUpShift j)) *
          tauLattice (ramifiedUpShift j *
            ((u : O) * OAI.ActualEisensteinCubic.lambda ^ m * (n * b ^ 3))) := by
  obtain ⟨C, hC⟩ := ramifiedDifference_unit_primary_modes_finite_span
  refine ⟨C, ?_⟩
  intro u m n b hnb
  let v : Oˣ := -(OAI.CubicEisenstein.ramifiedOmegaUnit ^ 2)
  have hval : (v : O) = -omega ^ 2 := by
    simp only [v, Units.val_neg, Units.val_pow_eq_pow_val,
      OAI.CubicEisenstein.ramifiedOmegaUnit_val]
    rfl
  have hl : OAI.ActualEisensteinCubic.lambda = (v : O) * lambda := by
    rw [hval]
    have hw : omega ^ 3 = (1 : O) := OAI.ActualEisensteinCubic.omega_primitive.pow_eq_one
    change omega - 1 = (-omega ^ 2) * (1 + 2 * omega)
    linear_combination omega_sq_add_omega_add_one + 2 * hw
  have he : (u : O) * OAI.ActualEisensteinCubic.lambda ^ m =
      ((u * v ^ m : Oˣ) : O) * lambda ^ m := by
    rw [hl, mul_pow, Units.val_mul, Units.val_pow_eq_pow_val]
    ring
  rw [he]
  exact hC (u * v ^ m) m n b hnb

