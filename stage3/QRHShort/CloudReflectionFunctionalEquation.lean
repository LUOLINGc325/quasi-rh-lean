  unfold primaryWeightedZeroRow
  apply tsum_congr
  intro r
  rw [residueAdditive_swap h, residueAdditive_swap k, residueAdditive_congr _ c h k hc hhk]

theorem primaryRowNormBound_nonneg (c : O) (hc : c ≠ 0) (h₃ : (3 : O) ∣ c)
