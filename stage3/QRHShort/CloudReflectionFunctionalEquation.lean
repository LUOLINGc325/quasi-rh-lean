  rw [geometricRowWeight, norm_mul, norm_div, norm_mul,
    Complex.norm_of_nonneg hN, norm_pow]
  rw [normElement_eq_embedding_sq, normElement_eq_embedding_sq, embedding_mul, norm_mul, mul_pow]
  field_simp [hcN]

