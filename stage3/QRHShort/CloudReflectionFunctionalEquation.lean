/-- The bad-prime factor is fixed before the varying set of ordinary primes. -/
def fullSourcePeriod (c : ArithmeticContext) (P : Finset (Ideal O)) : O :=
  badPrimePeriod c * ∏ p ∈ P, primaryGenerator p

theorem fullSourcePeriod_ne_zero (c : ArithmeticContext) (P : Finset (Ideal O))
    (hP : PrimeTwistSet c.S P) : fullSourcePeriod c P ≠ 0 := by
  apply mul_ne_zero (badPrimePeriod_ne_zero c)
  apply Finset.prod_ne_zero_iff.mpr
  intro p hp
  have hout := prime_outside c (hP p hp).1 (hP p hp).2
  have hs := primaryGenerator_spec_outside c hout
  intro hz
  apply hout.1
  rw [← hs.1, hz]
  simp only [principal, Ideal.span_singleton_zero]

theorem fullSourcePeriod_le_bad (c : ArithmeticContext) (P : Finset (Ideal O)) :
    principal (fullSourcePeriod c P) ≤ principal (badPrimePeriod c) := by
  apply Ideal.span_singleton_le_span_singleton.mpr
  exact dvd_mul_right _ _

theorem fullSourcePeriod_le_prime (c : ArithmeticContext) (P : Finset (Ideal O))
    (hP : PrimeTwistSet c.S P) (p : Ideal O) (hp : p ∈ P) :
    principal (fullSourcePeriod c P) ≤ p := by
  have hout := prime_outside c (hP p hp).1 (hP p hp).2
  rw [← (primaryGenerator_spec_outside c hout).1]
  apply Ideal.span_singleton_le_span_singleton.mpr
  exact dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem (fun q => primaryGenerator q) hp) _

def fullToBad (c : ArithmeticContext) (P : Finset (Ideal O)) :
    (O ⧸ principal (fullSourcePeriod c P)) →+* (O ⧸ principal (badPrimePeriod c)) :=
  Ideal.Quotient.factor (fullSourcePeriod_le_bad c P)

def fullToPrime (c : ArithmeticContext) (P : Finset (Ideal O))
    (hP : PrimeTwistSet c.S P) (p : Ideal O) (hp : p ∈ P) :
    (O ⧸ principal (fullSourcePeriod c P)) →+* (O ⧸ p) :=
  Ideal.Quotient.factor (fullSourcePeriod_le_prime c P hP p hp)

theorem fullToBad_mk (c : ArithmeticContext) (P : Finset (Ideal O)) (m : O) :
    fullToBad c P (Ideal.Quotient.mk (principal (fullSourcePeriod c P)) m) =
      Ideal.Quotient.mk (principal (badPrimePeriod c)) m :=
  Ideal.Quotient.factor_mk _ _

theorem fullToPrime_mk (c : ArithmeticContext) (P : Finset (Ideal O))
    (hP : PrimeTwistSet c.S P) (p : Ideal O) (hp : p ∈ P) (m : O) :
    fullToPrime c P hP p hp (Ideal.Quotient.mk (principal (fullSourcePeriod c P)) m) =
