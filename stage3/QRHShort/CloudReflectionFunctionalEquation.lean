      (upperTranslationLevel (((ramifiedTopUnit η a : O) * lam ^ r) * d - b) : SL(2, O)) *
        rationalMatrix (integerInversion * integerLower N) * manuscriptCuspMatrix j := by
  rw [map_mul, rationalMatrix_integerLower, rationalMatrix_integerInversion]
  apply Subtype.ext
  change (!![ramifiedTopElement η a r m, -1; 1, 0] : Matrix (Fin 2) (Fin 2) O) =
    !![1, 3 * (((ramifiedTopUnit η a : O) * lam ^ r) * d - b); 0, 1] *
      (!![0, -1; 1, 0] * !![1, 0; (N : O), 1]) *
      !![1, 0; manuscriptCuspParameter j, 1]
  apply Matrix.ext
  intro i k
  fin_cases i <;> fin_cases k <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
  unfold ramifiedTopElement
  linear_combination -hbase + ((ramifiedTopUnit η a : O) * lam ^ r) * hd

theorem exists_fixed_top_cusp (η : Oˣ) (a r : ℕ) :
    ∃ N : ℤ, ∃ b : O, ∃ j : Fin 3,
      -((ramifiedTopUnit η a : O) * lam ^ r) =
        (N : O) + 3 * b + manuscriptCuspParameter j ∧
      ∀ m : O, IsPrimary m → ∃ d : O, m - 1 = 3 * d ∧
        kubotaMultiplier (upperTranslationLevel
          (((ramifiedTopUnit η a : O) * lam ^ r) * d - b)) = 1 ∧
        weylCuspMatrix (ramifiedTopElement η a r m) =
          (upperTranslationLevel (((ramifiedTopUnit η a : O) * lam ^ r) * d - b) : SL(2, O)) *
            rationalMatrix (integerInversion * integerLower N) * manuscriptCuspMatrix j := by
  obtain ⟨N, b, j, hj⟩ :=
    exists_manuscript_translation_class (-((ramifiedTopUnit η a : O) * lam ^ r))
  refine ⟨N, b, j, hj, ?_⟩
