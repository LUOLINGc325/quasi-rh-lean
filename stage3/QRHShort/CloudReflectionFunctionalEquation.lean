      localCharacterPower p (-(j.val : ℤ) - 2) q * thetaLocalFactor p j m := by
  have hmem : q * m ∈ p ↔ m ∈ p := by
    constructor
    · intro hm
      exact ((Ideal.isPrime_of_prime hp).mem_or_mem hm).resolve_left hq
    · intro hm
      exact p.mul_mem_left q hm
  by_cases hj0 : j.val = 0
  · have he : -(j.val : ℤ) - 2 = -(2 : ℤ) := by omega
    simp only [thetaLocalFactor, if_pos hj0, he]
    have hmul : localCharacterPower p (-2) (q * m) =
        localCharacterPower p (-2) q * localCharacterPower p (-2) m := by
      simpa only [Nat.cast_ofNat] using localCharacterPower_neg_mul c hp hout 2 q m
    rw [hmul]
    ring
  · by_cases hj4 : j.val = 4
    · have he : localCharacterPower p (-(j.val : ℤ) - 2) q = 1 := by
        rw [show -(j.val : ℤ) - 2 = (-6 : ℤ) by omega]
