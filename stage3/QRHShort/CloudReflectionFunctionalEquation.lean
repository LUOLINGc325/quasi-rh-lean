private theorem upShift_frequency_all_modes (j : RamifiedNineGroup) (a : ZMod 3) (m : ℕ) :
    ramifiedUpShift j * (omega ^ a.val * lambda ^ m) =
      omega ^ (a - j.1).val * lambda ^ (m + (-j.2).val) := by
  have hw : omega ^ (-j.1).val * omega ^ a.val = omega ^ (a - j.1).val := by
    have hc : omega ^ (3 : ℕ) = 1 := OAI.ActualEisensteinCubic.omega_primitive.pow_eq_one
    rw [← pow_add, pow_eq_pow_mod _ hc, ← ZMod.val_add]
    congr 1
    abel
  unfold ramifiedUpShift
  calc
    _ = (omega ^ (-j.1).val * omega ^ a.val) * lambda ^ (m + (-j.2).val) := by
      rw [pow_add]
      ring
    _ = _ := by rw [hw]

/-- The fixed integral shifts have unit cubic-symbol values against every primary denominator. -/
theorem ramifiedUpShift_symbol_unit (j : RamifiedNineGroup) (n : O) (hn : IsPrimary n) :
    star (cubicSymbol (principal n) (ramifiedUpShift j)) *
        cubicSymbol (principal n) (ramifiedUpShift j) = 1 := by
  have hc := ramified_unit_power_coprime_primary (-j.1).val (-j.2).val n hn
  have hnorm := norm_cubicSymbol_primary n (ramifiedUpShift j) hn hc
  change (starRingEnd ℂ) (cubicSymbol (principal n) (ramifiedUpShift j)) *
    cubicSymbol (principal n) (ramifiedUpShift j) = 1
  rw [← Complex.normSq_eq_conj_mul_self, Complex.normSq_eq_norm_sq, hnorm]
  norm_num

private theorem tauLattice_upShift_primary (j : RamifiedNineGroup) (a : ZMod 3) (m : ℕ)
    (n b : O) (hnb : PrimaryCubeData n b) :
    tauLattice (ramifiedUpShift j * (omega ^ a.val * lambda ^ m * (n * b ^ 3))) =
      (‖embedding b‖ : ℂ) *
        (cubicSymbol (principal n) (ramifiedUpShift j * (omega ^ a.val * lambda ^ m)) *
          star (cubicGauss 1 n) / (‖embedding n‖ : ℂ)) *
        tauLattice (ramifiedUpShift j * (omega ^ a.val * lambda ^ m)) := by
  rw [← mul_assoc, upShift_frequency_all_modes]
  exact tauLattice_ramified_primary ⟨(a - j.1).val, ZMod.val_lt _⟩ _ n b hnb

/-- A single fixed nine-term family expresses the actual growing residual mode
on every ordinary squarefree/cube frequency.  The only extra factor is the
literal cubic character of each fixed ramified shift. -/
theorem ramifiedDifference_all_primary_modes_finite_span :
    ∃ C : RamifiedNineGroup → ℂ, ∀ (a : ZMod 3) (m : ℕ) (n b : O),
      PrimaryCubeData n b →
      ramifiedDifferenceCoefficient (omega ^ a.val * lambda ^ m * (n * b ^ 3)) =
        ∑ j : RamifiedNineGroup, C j *
          star (cubicSymbol (principal n) (ramifiedUpShift j)) *
          tauLattice (ramifiedUpShift j * (omega ^ a.val * lambda ^ m * (n * b ^ 3))) := by
  obtain ⟨C, hC⟩ := ramifiedDifference_all_seeds_finite_span
  refine ⟨C, ?_⟩
  intro a m n b hnb
  have hc := ramified_unit_power_coprime_primary a.val m n hnb.2.2.1
  rw [show omega ^ a.val * lambda ^ m * (n * b ^ 3) =
      (omega ^ a.val * lambda ^ m * n) * b ^ 3 by ring,
    ramifiedDifference_primary_cube b _ hnb.2.2.2.1,
    ramifiedDifference_squarefree n _ hnb.2.2.1 hnb.2.2.2.2 hc,
    hC, Finset.mul_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j hj
  have ht := tauLattice_upShift_primary j a m n b hnb
  rw [show (omega ^ a.val * lambda ^ m * n) * b ^ 3 =
      omega ^ a.val * lambda ^ m * (n * b ^ 3) by ring]
  rw [ht, cubicSymbol_primary_mul n (ramifiedUpShift j)
    (omega ^ a.val * lambda ^ m) hnb.2.2.1]
  have hu := ramifiedUpShift_symbol_unit j n hnb.2.2.1
  calc
    _ = (‖embedding b‖ : ℂ) *
        (cubicSymbol (principal n) (omega ^ a.val * lambda ^ m) *
          star (cubicGauss 1 n) / (‖embedding n‖ : ℂ)) *
        (C j * tauLattice (ramifiedUpShift j * (omega ^ a.val * lambda ^ m))) *
        (star (cubicSymbol (principal n) (ramifiedUpShift j)) *
          cubicSymbol (principal n) (ramifiedUpShift j)) := by rw [hu, mul_one]; ring
    _ = _ := by ring

