Mellin continuation; the cusp scales may differ from term to term. -/
theorem finite_cusp_mellin_entire {ι : Type*} [Fintype ι]
    (f : ℝ → ℂ) (g : ι → ℝ → ℂ) (A : ι → ℂ) (Q : ι → ℝ)
    (hQ : ∀ i, 0 < Q i) (hf : ContinuousOn f (Ioi 0))
    (hg : ∀ i, ContinuousOn (g i) (Ioi 0))
    (hfexp : ∃ d : ℝ, 0 < d ∧ f =O[atTop] (fun v : ℝ => Real.exp (-d * v)))
    (hgexp : ∀ i, ∃ d : ℝ, 0 < d ∧ g i =O[atTop] (fun v : ℝ => Real.exp (-d * v)))
    (hfg : ∀ v : ℝ, 0 < v → f v =
      ∑ i, A i * ((v : ℂ) ^ (-2 : ℂ) * g i ((Q i * v)⁻¹))) :
