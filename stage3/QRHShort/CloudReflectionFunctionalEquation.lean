        ((9 * Real.sqrt 3 / 2 : ℝ) : ℂ) := by
  have hb : ramifiedFrequencyBound (lowRamifiedFrequency a 0) = 4 := by
    rw [ramifiedFrequencyBound, lowRamifiedFrequency_absNorm]
