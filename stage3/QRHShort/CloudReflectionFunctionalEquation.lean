theorem embeddedMatrix_horizontalFlip (g : LevelThree) :
    embeddedMatrix (horizontalFlipLevel g : SL(2, O)) =
      horizontalFlipMatrix (embeddedMatrix (g : SL(2, O))) :=
  (horizontalFlipMatrix_map embeddingHom (g : SL(2, O))).symm

