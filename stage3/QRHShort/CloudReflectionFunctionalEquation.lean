namespace QRHShort.CloudBatch.ReflectionRamifiedCuspProfile
open ReflectionFE ReflectionResidual ReflectionSourceProjectionScale
open ReflectionDualShiftReindex ReflectionDualBesselProfile
open ReflectionSourceProjectionLift ReflectionSourceProjectionOrthogonality
open OAI.CubicEisenstein

def ramifiedProfileShift (side : Bool) (i : RamifiedSixBranch) (j : RamifiedNineGroup) : O :=
  ramifiedUpShift j * ramifiedCuspDifferenceShift side i

theorem ramifiedProfileShift_ne_zero (side : Bool) (i : RamifiedSixBranch)
    (j : RamifiedNineGroup) : ramifiedProfileShift side i j ≠ 0 :=
  mul_ne_zero (ramifiedUpShift_ne_zero j) (ramifiedCuspDifferenceShift_ne_zero side i)

def ramifiedProfileMultiplier (C : RamifiedNineGroup → ℂ) (side : Bool)
    (i : RamifiedSixBranch) (j : RamifiedNineGroup) (z : ℂ) (h : O) : ℂ :=
  star (ramifiedCuspTauWeight C side i j h) *
    breve (ThetaRealizationProof.frequency h * (z / 3))

/-- The native cusp has height and horizontal scale three. Converting the
native frequency sign leaves exactly one third of the literal Z mode. -/
theorem ramified_sourceCuspZTerm_literal (side : Bool) (z : ℂ) (v : ℝ)
    (hv : 0 < v) (h : O) (hh : h ≠ 0) :
    sourceCuspZTerm (if side then 2 else 1) z v h =
      (1 / 3 : ℂ) * (((2 * Real.pi : ℝ) : ℂ) * Complex.I) *
        ThetaRealizationProof.frequency h * star (ramifiedBesselValue side h) *
        breve (ThetaRealizationProof.frequency h * (z / 3)) *
        thetaMode (ThetaRealizationProof.frequency h) 0 (v / 3) := by
  have hs : sourceCuspScale (if side then 2 else 1) = 3 := by cases side <;> rfl
  have hc : (sourceCuspCoefficients (if side then 2 else 1)).value h =
      ramifiedBesselValue side h := by cases side <;> rfl
  have harg : 0 < 4 * Real.pi * ‖cuspFrequency h‖ * (v / 3) :=
    mul_pos (mul_pos (mul_pos (by norm_num) Real.pi_pos)
      (norm_pos_iff.mpr (cuspFrequency_ne_zero h hh))) (by positivity)
  have hb0 : breve (0 : ℂ) = 1 := by simp [breve]
  rw [sourceCuspZTerm_bessel _ z v hv h hh, hs, hc]
  simp only [literal_frequency_eq_neg_native]
  simp only [thetaMode, norm_neg, mul_zero, hb0, mul_one, Complex.ofReal_mul]
