      (∏ p ∈ P, localCharacterPower p ((j p).val : ℤ) (primaryGenerator a)) *
        (∏ p ∈ P, localCharacterPower p ((j p).val : ℤ) (primaryGenerator b)) := by
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro p hp
    exact localCharacterPower_mul c (hP p hp).1
      (prime_outside c (hP p hp).1 (hP p hp).2) _ _ _
  rw [hprod]
  ring

theorem productTwist_cube (c : ArithmeticContext) (ξ : RayCharacter c)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    {a : Ideal O} (ha : Outside c.S a) :
    productTwist c ξ P j (a ^ 3) = productTwist c ξ P j a ^ 3 := by
  rw [show a ^ 3 = a * a * a by ring,
    productTwist_mul c ξ P j hP (outside_mul c ha ha) ha,
    productTwist_mul c ξ P j hP ha ha]
  ring

theorem productTwist_norm_le_one (c : ArithmeticContext) (ξ : RayCharacter c)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
