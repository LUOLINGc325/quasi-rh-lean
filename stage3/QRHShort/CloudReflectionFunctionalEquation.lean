open ReflectionCuspPrimaryConstantClass
local notation "Eis" => OAI.ActualEisensteinCubic.O
local notation "lam" => OAI.ActualEisensteinCubic.lambda
local notation "w" => OAI.ActualEisensteinCubic.omega

private def smallCoordinates (j : Fin 3) (n : Fin 2) : ℤ × ℤ :=
  if n = 0 then if j = 0 then (1,0) else if j = 1 then (0,1) else (-1,-1)
  else if j = 0 then (-1,1) else if j = 1 then (-1,-2) else (2,1)

private theorem smallCoordinates_eq (j : Fin 3) (n : Fin 2) :
    w ^ j.val * lam ^ n.val = ((smallCoordinates j n).1 : Eis) +
      ((smallCoordinates j n).2 : Eis) * w := by
  have hω : w ^ 2 + w + 1 = 0 := ramified_omega_relation
  have hω3 : w ^ 3 = 1 := OAI.ActualEisensteinCubic.omega_primitive.pow_eq_one
  fin_cases j <;> fin_cases n <;>
    norm_num [smallCoordinates, OAI.ActualEisensteinCubic.lambda] <;>
    first | (ring; done) | (linear_combination hω; done) | linear_combination hω3 - hω

private theorem ramifiedLinearChar_coordinates (u : Eisˣ) (n j : ℕ)
    (hu : (u : Eis) = w ^ j ∨ (u : Eis) = -(w ^ j)) (A B : ℤ) :
    ramifiedLinearChar u n ((A : Eis) + (B : Eis) * w) =
      eisEmbedding ((cubicExp (2*A-B)) ^ j * (cubicExp A) ^ n) := by
  change eisEmbedding (symbol (u.val * lam ^ n) (1 + 3 * _)) = _
  have he : 1 + 3 * ((A : Eis) + (B : Eis) * w) = primaryCoord A B := by
    rw [primaryCoord_eq]; ring
  rw [he, ramified_symbol_primaryCoord u n j hu]

private theorem small_self_ne_one (s : Bool) (j : Fin 3) (n : Fin 2)
    (h : n = 0 → j ≠ 0) :
    ramifiedLinearChar (signedOmegaUnit s j) n.val
      ((signedOmegaUnit s j : Eis) * lam ^ n.val) ≠ 1 := by
  have hu : (signedOmegaUnit s j : Eis) = w ^ j.val ∨
      (signedOmegaUnit s j : Eis) = -(w ^ j.val) := by
    cases s <;> simp [signedOmegaUnit_val]
  have hω : eisEmbedding w ≠ 1 := by
    intro he
    exact OAI.ActualEisensteinCubic.omega_primitive.ne_one (by decide)
      (eisEmbedding_injective (by simpa using he))
  have hω2 : eisEmbedding (w ^ 2) ≠ 1 := by
    intro he
    have hh := eisEmbedding_injective (show eisEmbedding (w ^ 2) = eisEmbedding 1 by simpa using he)
    have h3 : w ^ 3 = 1 := OAI.ActualEisensteinCubic.omega_primitive.pow_eq_one
    have hw : w = 1 := by linear_combination h3 - w * hh
    exact OAI.ActualEisensteinCubic.omega_primitive.ne_one (by decide) hw
  have hωzero : eisEmbedding w ≠ 0 := by
    intro he
    exact OAI.ActualEisensteinCubic.omega_primitive.ne_zero (by decide)
      (eisEmbedding_injective (show eisEmbedding w = eisEmbedding 0 by simpa using he))
