    intro m
    apply (latticeBesselTerm_height_continuousOn scale hscale coeff z m).mono
    intro v hv
    exact (show 0 < v₀ / 2 by positivity).trans hv
  have hsum := continuousOn_tsum hcont hg (fun m v hv => hbound m z v hv.le)
  exact (hsum.continuousAt (Ioi_mem_nhds (by linarith))).continuousWithinAt

