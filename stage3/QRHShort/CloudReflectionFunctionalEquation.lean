    have he := congrArg (Ideal.Quotient.mk (principal q)) hab
    simpa only [map_add, map_mul, map_one, hq0, mul_zero, zero_mul, add_zero, mul_comm] using he
  exact isUnit_iff_exists_inv.mpr ⟨_, he⟩

theorem cubicSymbol_primary_residue_congr (q a b : O) (hq : IsPrimary q)
    (hab : Ideal.Quotient.mk (principal q) a = Ideal.Quotient.mk (principal q) b) :
    cubicSymbol (principal q) a = cubicSymbol (principal q) b := by
  rw [cubicSymbol_primary q a hq, cubicSymbol_primary q b hq]
  apply congrArg embedding
  exact OAI.CubicJacobiGlobal.symbol_congr
    (Ideal.mem_span_singleton.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem a b).mp hab))

theorem cubicSymbol_primary_mul (q a b : O) (hq : IsPrimary q) :
    cubicSymbol (principal q) (a * b) =
      cubicSymbol (principal q) a * cubicSymbol (principal q) b := by
  rw [cubicSymbol_primary _ _ hq, cubicSymbol_primary _ _ hq,
    cubicSymbol_primary _ _ hq,
    OAI.CubicJacobiGlobal.symbol_mul_numerator _ _ _ (primary_compat hq), embedding_mul]

/-- This equality includes every residue and every primary modulus, including
the prime over two and composite moduli.  The lambda factor comes from an
actual permutation of the quotient, not a change of character convention. -/
theorem primary_trace_gauss_eq_lambda_twist (q r : O) (hq : q ≠ 0)
    (hprimary : IsPrimary q) [Fintype (O ⧸ principal q)] :
    (∑ x : O ⧸ principal q,
      cubicSymbol (principal q) (residueLift (principal q) x) *
        ((reflectionTraceChar q hq).mulShift
          (Ideal.Quotient.mk (principal q) r)) x) =
      cubicSymbol (principal q) lambda * cubicGauss r q := by
  obtain ⟨u, hu⟩ := lambda_unit_primary_quotient q hprimary
  have hchar (x : O ⧸ principal q) :
      cubicSymbol (principal q) (residueLift (principal q)
        (Ideal.Quotient.mk (principal q) lambda * x)) =
      cubicSymbol (principal q) lambda *
        cubicSymbol (principal q) (residueLift (principal q) x) := by
    rw [← cubicSymbol_primary_mul _ _ _ hprimary]
    apply cubicSymbol_primary_residue_congr _ _ _ hprimary
    rw [residueLift_spec, map_mul, residueLift_spec]
  have hphase (x : O ⧸ principal q) :
      ((reflectionTraceChar q hq).mulShift (Ideal.Quotient.mk (principal q) r))
          (Ideal.Quotient.mk (principal q) lambda * x) =
        breve (embedding (r * residueLift (principal q) x) / embedding q) := by
    have he := canonical_cubicGauss_additive_phase q r
      (residueLift (principal q) x) hq
    simpa only [AddChar.mulShift_apply, map_mul, residueLift_spec, mul_assoc,
      mul_left_comm, mul_comm] using he
  have hqP : principal q ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hq
  rw [cubicGauss, dif_pos hqP, Finset.mul_sum]
  calc
    _ = ∑ x : O ⧸ principal q,
        cubicSymbol (principal q) (residueLift (principal q) (u.mulLeft x)) *
          ((reflectionTraceChar q hq).mulShift
            (Ideal.Quotient.mk (principal q) r)) (u.mulLeft x) :=
      (Equiv.sum_comp u.mulLeft _).symm
    _ = _ := by
      apply Finset.sum_congr (by ext x; simp)
      intro x hx
      simp only [Units.mulLeft_apply, hu, hchar, hphase, mul_assoc]

theorem primary_trace_gauss_normalization_cancels (q r : O) (hq : q ≠ 0)
    (hprimary : IsPrimary q) [Fintype (O ⧸ principal q)] :
    cubicSymbol (principal q) lambda *
        star (∑ x : O ⧸ principal q,
          cubicSymbol (principal q) (residueLift (principal q) x) *
            ((reflectionTraceChar q hq).mulShift
              (Ideal.Quotient.mk (principal q) r)) x) =
      star (cubicGauss r q) := by
  rw [primary_trace_gauss_eq_lambda_twist q r hq hprimary, star_mul]
