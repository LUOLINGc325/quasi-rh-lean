theorem latticeBesselProfile_height_continuousOn (scale : ℂ) (hscale : scale ≠ 0)
    (coeff : O → ℂ) (C : ℝ) (p : ℕ) (hC : 0 ≤ C)
    (hcoeff : ∀ m : O, m ≠ 0 → ‖coeff m‖ ≤ C * ‖embedding m‖ ^ p)
    (z : ℂ) : ContinuousOn (fun v : ℝ => latticeBesselProfile scale coeff z v) (Ioi 0) := by
  intro v₀ hv₀
  change 0 < v₀ at hv₀
  obtain ⟨g, hg, _, hbound⟩ := latticeBessel_majorant_above (v₀ / 2)
    (by positivity) scale hscale coeff C p hC hcoeff
  have hcont : ∀ m : O, ContinuousOn (fun v : ℝ => latticeBesselTerm scale coeff z v m)
