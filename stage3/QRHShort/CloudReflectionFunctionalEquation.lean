/-- The bound is chosen before all arithmetic contexts, characters, and twists. -/
theorem sourceDirichlet_uniform_right_bound (a : ℝ) (ha : 2 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (c : ArithmeticContext) (ξ : RayCharacter c)
      (P : Finset (Ideal O)) (j : Ideal O → Fin 6), PrimeTwistSet c.S P →
      ∀ s : ℂ, a ≤ s.re →
