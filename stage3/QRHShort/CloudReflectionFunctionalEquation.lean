theorem cubicGauss_one (r : O) : cubicGauss r 1 = 1 := by
  have hp : principal (1 : O) = ⊤ := by simp [principal]
  have hp0 : principal (1 : O) ≠ ⊥ := hp ▸ top_ne_bot
  letI : Subsingleton (O ⧸ principal (1 : O)) := by rw [hp]; infer_instance
