/-- Conjugation by diag(-1,1), written without placing that determinant-minus-one
matrix in SL₂. This is the change of action forced by the opposite Fourier sign. -/
def horizontalFlipMatrix {R : Type*} [CommRing R] (g : SL(2, R)) : SL(2, R) :=
  ⟨!![g 0 0, -g 0 1; -g 1 0, g 1 1], by
    have hd : g 0 0 * g 1 1 - g 0 1 * g 1 0 = 1 := by
      simpa only [Matrix.det_fin_two] using g.property
    simpa [Matrix.det_fin_two] using hd⟩

theorem horizontalFlipMatrix_involutive {R : Type*} [CommRing R] (g : SL(2, R)) :
    horizontalFlipMatrix (horizontalFlipMatrix g) = g := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [horizontalFlipMatrix, Matrix.of_apply]

theorem horizontalFlipMatrix_mul {R : Type*} [CommRing R] (g h : SL(2, R)) :
    horizontalFlipMatrix (g * h) = horizontalFlipMatrix g * horizontalFlipMatrix h := by
  apply Subtype.ext
  change (horizontalFlipMatrix (g * h) : Matrix (Fin 2) (Fin 2) R) =
    (horizontalFlipMatrix g : Matrix (Fin 2) (Fin 2) R) *
      (horizontalFlipMatrix h : Matrix (Fin 2) (Fin 2) R)
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [horizontalFlipMatrix, Matrix.SpecialLinearGroup.coe_mul,
      Matrix.SpecialLinearGroup.coe_mk, Matrix.of_apply,
      Matrix.mul_apply, Fin.sum_univ_two] <;> ring

theorem horizontalFlipMatrix_map {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (g : SL(2, R)) :
    horizontalFlipMatrix (Matrix.SpecialLinearGroup.map f g) =
      Matrix.SpecialLinearGroup.map f (horizontalFlipMatrix g) := by
  ext i j
  fin_cases i <;> fin_cases j
  · rfl
  · exact (map_neg f (g 0 1)).symm
  · exact (map_neg f (g 1 0)).symm
  · rfl

theorem horizontalFlipMatrix_mem_levelThree (g : LevelThree) :
    horizontalFlipMatrix (g : SL(2, O)) ∈ OAI.ReflectionFEKubota.levelThree := by
  apply (mem_levelThree_iff_entries _).mpr
  intro i j
