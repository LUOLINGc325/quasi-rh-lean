coefficient support, periodicity and summability inputs have been discharged. -/
theorem exists_fixed_ramified_cusp_original_profiles :
    ∃ C : RamifiedNineGroup → ℂ, ∀ (side : Bool) (z : ℂ) (v : ℝ), 0 < v →
      sourceCuspZFamily (if side then 2 else 1) z v =
        (1 / 3 : ℂ) * ∑ i : RamifiedSixBranch, ∑ j : RamifiedNineGroup,
          ((‖embedding (ramifiedProfileShift side i j)‖ : ℂ) /
            embedding (ramifiedProfileShift side i j)) *
          cuspZProfile .zero
