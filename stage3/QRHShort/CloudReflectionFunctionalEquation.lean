/- Frozen actual pools and pure ramified profiles fragment ReflectionCuspZeroPool.lean SHA256 7f99cb836d753d0ae86f1eb9ecdc8a789053f931f9fc0b6c60e80fdd7d41ac1a -/



noncomputable section
open Classical
open scoped BigOperators

namespace QRHShort.CloudBatch.ReflectionCuspZeroPool
open ReflectionFE ReflectionResidual ReflectionCuspIntegralScale ReflectionCuspProjectedGeometry
open ReflectionCuspZeroMasks ReflectionCuspZeroProfiles ReflectionZeroTruncatedProfile
open ReflectionCuspOperatorPool ReflectionCuspOperatorNormalization ReflectionZeroCuspPhysicalScale
open ReflectionDualLiftTwists ReflectionDualProjectionTwists ReflectionDualBesselProfile
open ReflectionActualProfilesAnalytic OAI.CubicEisenstein

/-- A bounded-valuation piece of the actual physical zero-cusp row. Its
ramified cutoff and bad quotient are fixed before all active prime data. -/
def zeroTruncatedPhysicalRow (K : ℕ) (q c₀ B : O)
    (ψ : (O ⧸ principal B) → ℂ) (A : Finset (Ideal O))
    (j : Ideal O → Fin 6) (γ : ℂ) (v : ℝ) : ℂ :=
  (-embedding q / (embedding (c₀ * ∏ p ∈ A, primaryGenerator p) ^ 2 * (v : ℂ) ^ 2)) *
    (γ * truncatedZeroFamily K
      (fun h => ψ (Ideal.Quotient.mk (principal B) h) *
        ∏ p ∈ A, thetaLocalFactor p (j p) (lambda * h)) 0
      ((effectiveScale (embedding q) (embedding (c₀ * ∏ p ∈ A, primaryGenerator p)) * v)⁻¹))

/-- Every fixed bounded-valuation part of the actual zero row admits an
original reflection-data pool. The actual coefficient expansion is obtained
internally. K, B, the pool and its bound all precede P and j; no assertion
about the untruncated high-valuation tail is made. -/
theorem exists_actual_truncated_zero_reflection_pool (K₀ : ℕ)
    (u₀ : Oˣ) (n : ℕ) (c₀ B₀ : O) (hc₀ : c₀ ≠ 0) (hB₀ : B₀ ≠ 0)
    (G W₀ : ℝ) (hG : 0 ≤ G) (hW₀ : 0 ≤ W₀) :
    ∃ (N : ℕ) (data : Fin N → ReflectionDatum) (K : ℝ), 0 ≤ K ∧
      ∀ (c : ArithmeticContext) (P : Finset (Ideal O)) (j : Ideal O → Fin 6)
        (hP : PrimeTwistSet c.S P) (A : Finset (Ideal O)) (hA : A ⊆ P)
        (ψ₀ : (O ⧸ principal B₀) → ℂ) (hψ₀ : ∀ a, ‖ψ₀ a‖ ≤ W₀)
        (γ : ℂ) (hγ : ‖γ‖ ≤ G),
      ∃ β : Fin N → ℂ, (∀ i, ‖β i‖ ≤ K) ∧
        ∀ v : ℝ, 0 < v →
          zeroTruncatedPhysicalRow K₀ ((u₀ : O) * lambda ^ n) c₀ B₀ ψ₀ A j γ v =
            ∑ i : Fin N,
              (-β i / (normElement (reflectionDenominator (data i) A) : ℂ)) *
                ((v : ℂ) ^ (-2 : ℂ) * dualProfile (data i) A j
                  ((normElement (reflectionDenominator (data i) A) * v)⁻¹)) := by
  obtain ⟨C, hC⟩ := source_bounded_valuation_residue_span K₀
  let q : O := (u₀ : O) * lambda ^ n
  let B : RamifiedNineGroup → O := fun i => zeroTemplateDecimation i n * zeroBadModulus K₀ B₀
  let d : RamifiedNineGroup → O := fun i => zeroTemplateDenominator c₀ i n
  let L : RamifiedNineGroup → O := fun i => denominatorRamifiedShift (zeroTemplateExponent i) n
  have hB (i : RamifiedNineGroup) : B i ≠ 0 :=
    mul_ne_zero (zeroTemplateDecimation_ne_zero i n) (zeroBadModulus_ne_zero K₀ B₀ hB₀)
  have hd (i : RamifiedNineGroup) : d i ≠ 0 := zeroTemplateDenominator_ne_zero c₀ hc₀ i n
  have hL (i : RamifiedNineGroup) : L i ≠ 0 := pow_ne_zero _ lambda_prime.ne_zero
  have hNL (i : RamifiedNineGroup) : 0 ≤ normElement (L i) := by
    rw [normElement_eq_embedding_sq]
    positivity
  let M : ℝ := ∑ i : RamifiedNineGroup, (‖embedding q‖ * normElement (L i)) * G
  let W : ℝ := ∑ i : RamifiedNineGroup, zeroCoefficientBound K₀ C i * W₀
  have hM : 0 ≤ M := Finset.sum_nonneg
    (fun i _ => mul_nonneg (mul_nonneg (norm_nonneg _) (hNL i)) hG)
  have hW : 0 ≤ W := Finset.sum_nonneg
    (fun i _ => mul_nonneg (zeroCoefficientBound_nonneg K₀ C i) hW₀)
  obtain ⟨N, data, K, hK, hpool⟩ := exists_fixed_operator_pool B hB (fun _ => .zero) d hd M W hM hW
  refine ⟨N, data, K, hK, ?_⟩
  intro c P j hP A hA ψ₀ hψ₀ γ hγ
  let R : O := ∏ p ∈ A, primaryGenerator p
  have hcR : c₀ * R ≠ 0 :=
    actualReflectionDenominator_ne_zero c P hP A hA
      (ReflectionDualFiniteMultiplier.quotientReflectionDatum c₀ .zero c₀ hc₀ 0)
  let α : RamifiedNineGroup → ℂ := fun i => γ * dualProjectionTwistScalar A j lambda *
    zeroTemplateScalar i n * (dualProjectionTwistScalar A j (zeroTemplateDecimation i n))⁻¹
  let μ : RamifiedNineGroup → ℂ := fun i => geometricRowWeight (embedding q) (c₀ * R) (L i) (α i)
  let ψ : ∀ i : RamifiedNineGroup, (O ⧸ principal (B i)) → ℂ := fun i =>
    zeroLiftedResidue K₀ C i n B₀ ψ₀
  have hα (i : RamifiedNineGroup) : ‖α i‖ ≤ G := by
    have hLam := dualProjectionTwistScalar_norm c P j hP A hA lambda (supported_trace_lambda c)
    have hδ := dualProjectionTwistScalar_inv_norm c P j hP A hA
      (zeroTemplateDecimation i n) (supported_zero_decimation c i n)
    dsimp only [α]
    rw [norm_mul, norm_mul, norm_mul, hLam, hδ, mul_one, mul_one]
    exact (mul_le_mul hγ (zeroTemplateScalar_norm_le_one i n) (norm_nonneg _) hG).trans_eq (mul_one G)
  have hμ (i : RamifiedNineGroup) : ‖μ i‖ ≤ M := by
    dsimp only [μ]
    rw [geometricRowWeight_norm _ _ _ hcR]
    calc
      _ ≤ (‖embedding q‖ * normElement (L i)) * G :=
        mul_le_mul_of_nonneg_left (hα i) (mul_nonneg (norm_nonneg _) (hNL i))
      _ ≤ M := Finset.single_le_sum
        (fun i _ => mul_nonneg (mul_nonneg (norm_nonneg _) (hNL i)) hG) (Finset.mem_univ i)
  have hψ (i : RamifiedNineGroup) (a : O ⧸ principal (B i)) : ‖ψ i a‖ ≤ W :=
    (zeroLiftedResidue_norm_bound K₀ C i n B₀ ψ₀ W₀ hW₀ hψ₀ a).trans
      (Finset.single_le_sum (fun i _ => mul_nonneg (zeroCoefficientBound_nonneg K₀ C i) hW₀)
        (Finset.mem_univ i))
  obtain ⟨β, hβ, hrows⟩ := hpool c P j hP A hA μ hμ ψ hψ
  refine ⟨β, hβ, ?_⟩
  intro v hv
  apply Eq.trans _ (hrows v hv)
  let Z : RamifiedNineGroup → ℂ := fun i => cuspZProfile .zero
    (fun H => ψ i (Ideal.Quotient.mk (principal (B i)) H) * ∏ p ∈ A, thetaLocalFactor p (j p) H)
    ((normElement (d i * R) * v)⁻¹)
  have he (i : RamifiedNineGroup) : (c₀ * R) * L i = d i * R := by
    simp only [L, d, zeroTemplateDenominator]
    ring
  have hentry (i : RamifiedNineGroup) :
      (-embedding q / (embedding (c₀ * R) ^ 2 * (v : ℂ) ^ 2)) * (α i * Z i) =
        physicalOperatorRow (B i) (d i) .zero (ψ i) (μ i) A j v := by
    have hh := geometricRowWeight_physical (embedding q) (c₀ * R) (L i) hcR (hL i) (α i) (Z i) v
    rw [he i] at hh
    exact hh
  calc
    _ = (-embedding q / (embedding (c₀ * R) ^ 2 * (v : ℂ) ^ 2)) *
        (γ * (dualProjectionTwistScalar A j lambda * ∑ i : RamifiedNineGroup,
          (zeroTemplateScalar i n * (dualProjectionTwistScalar A j (zeroTemplateDecimation i n))⁻¹) *
            Z i)) := by
      unfold zeroTruncatedPhysicalRow
      rw [(weighted_zero_fixed_quotient_profiles K₀ C hC u₀ n c₀ hc₀ B₀ ψ₀ W₀ hW₀ hψ₀
        c P A j hP hA v hv).2]
    _ = ∑ i : RamifiedNineGroup,
        (-embedding q / (embedding (c₀ * R) ^ 2 * (v : ℂ) ^ 2)) * (α i * Z i) := by
      simp only [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp only [α]
      ring
    _ = _ := Finset.sum_congr rfl (fun i _ => hentry i)

end QRHShort.CloudBatch.ReflectionCuspZeroPool


