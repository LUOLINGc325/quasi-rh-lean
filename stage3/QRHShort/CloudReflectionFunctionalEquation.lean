    (lambda_coprime_primary q hprimary)
  have hunit : cubicSymbol (principal q) lambda *
      star (cubicSymbol (principal q) lambda) = 1 := by
    change cubicSymbol (principal q) lambda *
      (starRingEnd ℂ) (cubicSymbol (principal q) lambda) = 1
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, hnorm]
    norm_num
  calc
    _ = (cubicSymbol (principal q) lambda * star (cubicSymbol (principal q) lambda)) *
        star (cubicGauss r q) := by ring
    _ = _ := by rw [hunit, one_mul]

