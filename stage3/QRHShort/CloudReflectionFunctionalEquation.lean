padding L and q, while the complete active denominator c cancels. -/
theorem geometricRowWeight_physical (q : ℂ) (c L : O) (hc : c ≠ 0) (hL : L ≠ 0)
    (α z : ℂ) (v : ℝ) :
    (-q / (embedding c ^ 2 * (v : ℂ) ^ 2)) * (α * z) =
      (-geometricRowWeight q c L α / (normElement (c * L) : ℂ)) *
        ((v : ℂ) ^ (-2 : ℂ) * z) := by
  have hcE := embedding_eq_zero.not.mpr hc
  have hCL : 0 < normElement (c * L) := by
    rw [normElement_eq_embedding_sq]
    exact sq_pos_of_ne_zero (norm_ne_zero_iff.mpr (embedding_eq_zero.not.mpr (mul_ne_zero hc hL)))
  have hN : (normElement (c * L) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hCL.ne'
  rw [geometricRowWeight, Complex.cpow_neg, Complex.cpow_two]
  simp only [div_eq_mul_inv, mul_inv_rev]
  field_simp [hcE, hN]
  <;> ring

/-- The scalar introduced by the 1/3 auxiliary coefficient, the unit Kubota
factor, upward padding and the local-character cancellation is uniformly bounded. -/
theorem auxiliary_scalar_norm_le_one (γ α δ : ℂ)
    (hγ : ‖γ‖ ≤ 1) (hα : ‖α‖ ≤ 1) (hδ : ‖δ‖ = 1) :
    ‖γ * (1 / 3 : ℂ) * α * δ‖ ≤ 1 := by
