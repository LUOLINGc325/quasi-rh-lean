  rw [← residueLift_spec ((Ideal.span {phaseModulus c₀} : Ideal O)) q, fixedResiduePhase_mk,
    breve_eq_breveE]
  exact breveE_norm _

def phaseDatum (c₀ : O) (hc₀ : c₀ ≠ 0) (σ : ThetaCusp)
    (q : O ⧸ (Ideal.span {phaseModulus c₀} : Ideal O)) : ReflectionDatum where
  cusp := σ
  phase := fixedResiduePhase c₀ hc₀ q
  phase_add := fixedResiduePhase_add c₀ hc₀ q
  phase_norm := fixedResiduePhase_norm c₀ hc₀ q
  denominator := c₀
  denominator_ne_zero := hc₀

/-- This is a pool of the original ReflectionDatum, chosen before every
varying inverse residue, active factor, and finite local exponent. -/
theorem exists_fixed_phase_datum_pool (c₀ : O) (hc₀ : c₀ ≠ 0) :
    ∃ N : ℕ, ∃ data : Fin N → ReflectionDatum,
      (∀ i, (data i).denominator = c₀) ∧
      ∀ (σ : ThetaCusp) (d U : O), ∃ i : Fin N,
        (data i).cusp = σ ∧ ∀ m : O,
          (data i).phase m =
            breve (-(embedding d * embedding U *
              (embedding QRHShort.lambda ^ (-4 : ℤ) * embedding m)) / embedding c₀) := by
  have hI : (Ideal.span {phaseModulus c₀} : Ideal O) ≠ ⊥ :=
    Ideal.span_singleton_eq_bot.not.mpr (phaseModulus_ne_zero c₀ hc₀)
  letI : Finite (O ⧸ (Ideal.span {phaseModulus c₀} : Ideal O)) := Ring.HasFiniteQuotients.finiteQuotient hI
  let Q := ThetaCusp × (O ⧸ (Ideal.span {phaseModulus c₀} : Ideal O))
  letI : Fintype Q := Fintype.ofFinite Q
  let e : Fin (Fintype.card Q) ≃ Q := (Fintype.equivFin Q).symm
  let data : Fin (Fintype.card Q) → ReflectionDatum :=
    fun i => phaseDatum c₀ hc₀ (e i).1 (e i).2
  refine ⟨Fintype.card Q, data, fun _ => rfl, ?_⟩
  intro σ d U
  let q : Q := (σ, Ideal.Quotient.mk _ (-d * U))
  refine ⟨e.symm q, ?_, ?_⟩
  · change (e (e.symm q)).1 = σ
    rw [e.apply_symm_apply]
  · intro m
    change fixedResiduePhase c₀ hc₀ (e (e.symm q)).2 m = _
    rw [e.apply_symm_apply]
    change fixedResiduePhase c₀ hc₀ (Ideal.Quotient.mk _ (-d * U)) m = _
    rw [fixedResiduePhase_mk, embedding_mul, embedding_neg]
    congr 1
    ring

section
variable {R : Type*} [CommRing R]

theorem inverse_weight_residue_congr (B r r₀ d d₀ U U₀ : R)
    (hr : IsCoprime B r) (hrr : B ∣ r - r₀) (hdd : B ∣ d - d₀)
    (hU : B ∣ U * r - 1) (hU₀ : B ∣ U₀ * r₀ - 1) :
    B ∣ d * U - d₀ * U₀ := by
  have hUr : B ∣ (U - U₀) * r := by
    have hh := dvd_sub (dvd_sub hU hU₀) (dvd_mul_of_dvd_right hrr U₀)
    convert hh using 1 <;> ring
  have hdiff : B ∣ U - U₀ := hr.dvd_of_dvd_mul_right hUr
  have hh := dvd_add (dvd_mul_of_dvd_right hdiff d) (dvd_mul_of_dvd_left hdd U₀)
  convert hh using 1 <;> ring

end

theorem fixedResiduePhase_inverse_sector (c₀ : O) (hc₀ : c₀ ≠ 0)
    (r r₀ d d₀ U U₀ : O)
    (hr : IsCoprime (phaseModulus c₀) r)
    (hrr : phaseModulus c₀ ∣ r - r₀) (hdd : phaseModulus c₀ ∣ d - d₀)
    (hU : phaseModulus c₀ ∣ U * r - 1) (hU₀ : phaseModulus c₀ ∣ U₀ * r₀ - 1) :
    fixedResiduePhase c₀ hc₀ (Ideal.Quotient.mk _ (-d * U)) =
      fixedResiduePhase c₀ hc₀ (Ideal.Quotient.mk _ (-d₀ * U₀)) := by
  congr 1
  apply Ideal.Quotient.eq.mpr
  apply Ideal.mem_span_singleton.mpr
  have hh := dvd_neg.mpr (inverse_weight_residue_congr
    (phaseModulus c₀) r r₀ d d₀ U U₀ hr hrr hdd hU hU₀)
  convert hh using 1 <;> ring

end QRHShort.CloudBatch.ReflectionCuspPhasePool








