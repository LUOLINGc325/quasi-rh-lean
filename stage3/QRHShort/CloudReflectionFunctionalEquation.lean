  · rw [productTwist, if_pos ha, norm_mul, norm_prod]
    have hξ : ‖rayValue ξ.val a‖ ≤ 1 := by
      letI : Finite (O ⧸ ξ.val.modulus) :=
        Ring.HasFiniteQuotients.finiteQuotient ξ.val.modulus_ne_bot
      exact finite_mulChar_norm_le_one ξ.val.residue _
    have hprod : ∏ p ∈ P, ‖localCharacterPower p ((j p).val : ℤ)
