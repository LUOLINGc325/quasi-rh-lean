theorem ramifiedDifference_primary_support (a r : Fin 3) (m : O) (hm : IsPrimary m)
    (hE : ramifiedDifferenceCoefficient (lowRamifiedFrequency a r * m) ≠ 0) :
    ∃ n b : O, PrimaryCubeData n b ∧ m = n * b ^ 3 := by
