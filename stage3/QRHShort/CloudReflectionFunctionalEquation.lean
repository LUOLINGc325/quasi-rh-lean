theorem zeroBadResidue_mk (K : ℕ) (C : Fin (K + 1) → RamifiedNineGroup → ℂ)
    (i : RamifiedNineGroup) (B : O) (ψ : (O ⧸ principal B) → ℂ) (h : O) :
