      embedding ((u : O) * lambda ^ r * m)) z := by
    by_contra hh
    exact ht (by simp only [tauLattice, tau, dif_neg hh])
  obtain ⟨z, n, b, hnb, s, hs, hcase⟩ := hex
  have hN : IsPrimary (n * b ^ 3) := primary_mul n (b ^ 3) hnb.2.2.1
    (primary_pow b hnb.2.2.2.1 3)
  have hfreq (v : O) (e : ℕ)
      (he : embedding lambda ^ (-3 : ℤ) * embedding ((u : O) * lambda ^ r * m) =
        embedding v * embedding lambda ^ ((e : ℤ) - 3) * embedding (n * b ^ 3)) :
      (u : O) * lambda ^ r * m = v * lambda ^ e * (n * b ^ 3) := by
    have hshift : -ThetaRealizationProof.frequency (-((u : O) * lambda ^ r * m)) =
        embedding v * embedding lambda ^ ((e : ℤ) - 3) * embedding (n * b ^ 3) := by
      simpa only [ThetaRealizationProof.frequency, embedding_neg, mul_neg, neg_neg] using he
    simpa only [neg_neg] using ThetaRealizationProof.frequency_shift_integral _ _ v e hshift
  rcases hs with rfl | rfl
  all_goals rcases hcase with hc | hc
  · rcases hc with ⟨k, j, hk, he, _⟩
    have he' := hfreq (omega ^ j.val) (3 * k - 1) (by
      have hc : ((3 * k - 1 : ℕ) : ℤ) - 3 = 3 * (k : ℤ) - 4 := by omega
      simpa only [embedding_pow, one_mul, hc] using he)
