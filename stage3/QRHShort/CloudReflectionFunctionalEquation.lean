    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (a r : Fin 3) (z : O ⧸ principal (fullSourcePeriod c P)) :
    ‖fullProjectionResidue c ξ P j hP a r z‖ ≤ 1 :=
