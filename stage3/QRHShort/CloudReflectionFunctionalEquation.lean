theorem ramifiedLinearChar_self_ne_one_of_noninteger
    (m : Eis) (u : Eisˣ) (n : ℕ) (hm : lam ^ 2 ∣ m - 1)
    (hbad : ¬ IntegerModThree (m * ((u : Eis) * lam ^ n))) :
    ramifiedLinearChar u n (m * ((u : Eis) * lam ^ n)) ≠ 1 := by
  have h3 : (3 : Eis) ∣ lam ^ 2 := by
    refine ⟨-w, ?_⟩
    change (w - 1) ^ 2 = 3 * -w
    linear_combination ramified_omega_relation
  have hn : n < 2 := by
    by_contra hn
    have hd : (3 : Eis) ∣ m * ((u : Eis) * lam ^ n) :=
      dvd_mul_of_dvd_right (dvd_mul_of_dvd_right
        (h3.trans (pow_dvd_pow lam (by omega : 2 ≤ n))) _) _
    exact hbad ⟨0, by simpa using hd⟩
  have he : ramifiedLinearChar u n (m * ((u : Eis) * lam ^ n)) =
      ramifiedLinearChar u n ((u : Eis) * lam ^ n) := by
    have hd : m * ((u : Eis) * lam ^ n) - (u : Eis) * lam ^ n ∈ Ideal.span {(3 : Eis)} := by
      apply Ideal.mem_span_singleton.mpr
      convert dvd_mul_of_dvd_left (three_dvd_primary_sub_one _ hm) ((u : Eis) * lam ^ n) using 1 <;> ring
    have hh := (ramifiedLinearChar u n).map_add_eq_mul
      (m * ((u : Eis) * lam ^ n) - (u : Eis) * lam ^ n) ((u : Eis) * lam ^ n)
    rw [sub_add_cancel, ramifiedLinearChar_period u n _ hd, one_mul] at hh
    exact hh
  rw [he]
  obtain ⟨⟨s,j⟩, rfl⟩ := signedOmegaUnit_surjective u
  apply small_self_ne_one s j ⟨n, hn⟩
  intro hn0 hj0
  have hn' : n = 0 := congrArg Fin.val hn0
  subst j
  have hm3 := three_dvd_primary_sub_one _ hm
  apply hbad
  cases s
  · refine ⟨1, ?_⟩
    simpa [signedOmegaUnit_val, hn'] using hm3
  · refine ⟨-1, ?_⟩
    simpa [signedOmegaUnit_val, hn', sub_eq_add_neg, add_comm] using dvd_neg.mpr hm3

/-- Genuine numerator factorization and cubic reciprocity isolate the
ramified additive character in every translated primary denominator. -/
theorem symbol_primary_shift_factor (a m : Eis) (u : Eisˣ) (n : ℕ)
    (ha : lam ^ 2 ∣ a - 1) (hm : lam ^ 2 ∣ m - 1) (q : Eis) :
    eisEmbedding (symbol (m * ((u : Eis) * lam ^ n))
      (a + 3 * q * (m * ((u : Eis) * lam ^ n)))) =
    eisEmbedding (symbol (m * ((u : Eis) * lam ^ n)) a) *
      ramifiedLinearChar u n (q * (m * ((u : Eis) * lam ^ n))) := by
  let c := m * ((u : Eis) * lam ^ n)
  have hx : lam ^ 2 ∣ a + 3 * q * c - 1 := primary_add_multiple_three a c q ha
  have hord : symbol m (a + 3 * q * c) = symbol m a := by
    have he : a + 3 * q * c = a + 3 * (q * ((u : Eis) * lam ^ n)) * m := by dsimp [c]; ring
    rw [he, symbol_three_shift_primary m a _ hm ha]
  have hram : eisEmbedding (symbol ((u : Eis) * lam ^ n) (a + 3 * q * c)) =
      eisEmbedding (symbol ((u : Eis) * lam ^ n) a) * ramifiedLinearChar u n (q*c) := by
    obtain ⟨t, ht⟩ := three_dvd_primary_sub_one a ha
    have he : a = 1 + 3 * t := by linear_combination ht
    have he' : a + 3 * q * c = 1 + 3 * (t + q*c) := by rw [he]; ring
    rw [he', he]
    exact (ramifiedLinearChar u n).map_add_eq_mul _ _
  change eisEmbedding (symbol c (a + 3*q*c)) = eisEmbedding (symbol c a) * _
  dsimp only [c]
  rw [symbol_mul_numerator _ _ _ hx, symbol_mul_numerator _ _ _ ha,
    map_mul, map_mul, hord, hram]
  ring

end QRHShort.CloudBatch.ReflectionCuspRamifiedCharacter



