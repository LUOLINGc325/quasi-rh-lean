      simp only [thetaLocalFactor, if_neg hj0, if_neg hj4, he]
      exact localCharacterPower_neg_mul c hp hout (j.val + 2) q m

def dualProjectionTwistScalar (A : Finset (Ideal O)) (j : Ideal O → Fin 6) (q : O) : ℂ :=
  ∏ p ∈ A, localCharacterPower p (-((j p).val : ℤ) - 2) q

theorem dualProjectionTwistScalar_norm (c : ArithmeticContext)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (A : Finset (Ideal O)) (hA : A ⊆ P) (q : O)
    (hsupport : ∀ p : Ideal O, Prime p → p ∣ principal q → p ∈ c.S) :
    ‖dualProjectionTwistScalar A j q‖ = 1 := by
