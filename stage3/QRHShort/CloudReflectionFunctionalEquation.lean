  obtain ⟨n, rfl⟩ := Ideal.Quotient.mk_surjective y
  rw [quotientMul_mk, quotientMul_mk] at hxy
  obtain ⟨k, hk⟩ := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq.mp hxy)
  apply Ideal.Quotient.eq.mpr
  apply Ideal.mem_span_singleton.mpr
  refine ⟨k, mul_left_cancel₀ hq ?_⟩
  calc
    q * (m - n) = q * m - q * n := mul_sub q m n
    _ = (q * B) * k := hk
    _ = q * (B * k) := by ring

