the auxiliary cusps. No vanishing or identification with a zero cusp is assumed. -/
theorem top_source_actual_derivative (η : Oˣ) (a r : ℕ) :
    ∃ j : Fin 3, ∀ n : ℕ, ∀ m : O, IsPrimary m → ∀ v : ℝ, ∀ hv : 0 < v,
      wirtingerBar (fun z => star (cubicSourceResidualFunction (upperPoint z v hv)))
        ((-(3 : ℂ) * embedding (((η : O) * lam ^ (n + 2 + r)) * m)) /
          (9 * embedding (omega ^ a * lam ^ n))) =
      (-1 / (v : ℂ) ^ 2) * wirtingerZ (fun z => star (sourceCuspFunction j
        (upperPoint z (1 / v) (one_div_pos.mpr hv)))) 0 := by
  obtain ⟨N, b, j, hbase, hclass⟩ := exists_fixed_top_cusp η a r
