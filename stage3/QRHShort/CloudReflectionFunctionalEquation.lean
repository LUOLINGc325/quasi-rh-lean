theorem latticeBessel_majorant_above (vLo : ℝ) (hvLo : 0 < vLo)
    (scale : ℂ) (hscale : scale ≠ 0) (coeff : O → ℂ)
    (C : ℝ) (p : ℕ) (hC : 0 ≤ C)
    (hcoeff : ∀ m : O, m ≠ 0 → ‖coeff m‖ ≤ C * ‖embedding m‖ ^ p) :
