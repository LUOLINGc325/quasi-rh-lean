    ramifiedOmegaUnit_val]

def fullProjectionResidue (c : ArithmeticContext) (ξ : RayCharacter c)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (a r : Fin 3) : (O ⧸ principal (fullSourcePeriod c P)) → ℂ :=
