      ∑ i, A i * ((v : ℂ) ^ (-2 : ℂ) * g i ((Q i * v)⁻¹))) :
    mellin f (2 * s) = ∑ i, A i * (Q i : ℂ) ^ (2 - 2 * s) * mellin (g i) (2 - 2 * s) := by
  have hint (i : ι) : MellinConvergent (reflectedCuspProfile (A i) (Q i) (g i)) (2 * s) :=
    reflectedCuspProfile_mellinConvergent (g i) (A i) (2 * s) (Q i) (hQ i) (hg i)
  calc
    _ = ∫ v : ℝ in Ioi 0,
        ∑ i, (v : ℂ) ^ (2 * s - 1) * reflectedCuspProfile (A i) (Q i) (g i) v := by
      unfold mellin
      apply integral_congr_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with v hv
      rw [hfg v hv]
      simp only [smul_eq_mul, Finset.mul_sum, reflectedCuspProfile]
    _ = ∑ i, mellin (reflectedCuspProfile (A i) (Q i) (g i)) (2 * s) := by
      simpa only [mellin, smul_eq_mul] using
        integral_finsetSum Finset.univ (fun i _ => hint i)
    _ = _ := by
      apply Finset.sum_congr rfl
      intro i hi
      exact reflectedCuspProfile_mellin (g i) (A i) (2 * s) (Q i) (hQ i)

