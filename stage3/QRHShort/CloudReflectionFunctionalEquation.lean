supplied: this gives the three exact interfaces required by the original FE. -/
theorem reflection_interfaces_of_literal_profiles (c : ArithmeticContext) (ξ : RayCharacter c)
    {N : ℕ} (data : Fin N → ReflectionDatum) (P : Finset (Ideal O))
    (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (β : Fin N → Finset (Ideal O) → ℂ)
    (hgeometry : LiteralProfileReflection c ξ data P j β) :
    SourceContinuation c (productTwist c ξ P j) (sourceFunction c ξ P j) ∧
      DualDirichletConvergence data P j ∧
      HasReflectionEquation data P j (fun h A => (-Complex.I / 81) * β h A)
        (sourceFunction c ξ P j) := by
  have hEq := hasReflectionEquation_of_literal_profiles c ξ data P j hP β hgeometry
  have hDual := dualDirichletConvergence_proved c P j hP data
