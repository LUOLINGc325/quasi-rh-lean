  have a0 : 3 * ninthRoot * unramifiedGaussResidue om =
      unramifiedGaussResidue 1 + ninthRoot⁻¹ * unramifiedGaussResidue (om ^ 2) +
        3 * fourthWeight * unramifiedGaussResidue (om * lam) := by
    norm_num only [zpow_neg, zpow_natCast, zpow_one] at e0
    field_simp [hz] at e0 ⊢
    linear_combination e0
  have a1 : 3 * ninthRoot⁻¹ * unramifiedGaussResidue (om ^ 2) =
      unramifiedGaussResidue 1 + ninthRoot * unramifiedGaussResidue om +
        3 * fourthWeight * unramifiedGaussResidue (om * lam) := by
    field_simp [hz] at e1 ⊢
    linear_combination e1
  have a2 : 3 * unramifiedGaussResidue 1 =
      ninthRoot * unramifiedGaussResidue om + ninthRoot⁻¹ * unramifiedGaussResidue (om ^ 2) +
        3 * fourthWeight * unramifiedGaussResidue (om * lam) := by
    norm_num only [zpow_neg, zpow_natCast, zpow_one] at e2
    linear_combination 3 * e2
  have h01 : ninthRoot * unramifiedGaussResidue om = unramifiedGaussResidue 1 := by
    linear_combination (1 / 4 : ℂ) * a0 - (1 / 4 : ℂ) * a2
  have h02 : ninthRoot⁻¹ * unramifiedGaussResidue (om ^ 2) = unramifiedGaussResidue 1 := by
    linear_combination (1 / 4 : ℂ) * a1 - (1 / 4 : ℂ) * a2
  refine ⟨?_, ?_, ?_⟩
  · apply mul_left_cancel₀ hz
    rw [h01, ← mul_assoc, mul_inv_cancel₀ hz, one_mul]
  · apply mul_left_cancel₀ (inv_ne_zero hz)
    rw [h02, ← mul_assoc, inv_mul_cancel₀ hz, one_mul]
  · linear_combination a2 + h01 + h02

end QRHShort.CloudBatch.ReflectionCuspPoleMatrix



