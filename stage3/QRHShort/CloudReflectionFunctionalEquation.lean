primary numerator m is chosen. The level-three translation is explicit. -/
theorem top_weyl_factorization (η : Oˣ) (a r : ℕ) (N : ℤ) (b : O) (j : Fin 3)
    (hbase : -((ramifiedTopUnit η a : O) * lam ^ r) =
      (N : O) + 3 * b + manuscriptCuspParameter j) (m d : O)
    (hd : m - 1 = 3 * d) :
