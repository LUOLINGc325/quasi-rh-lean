    (ξ : RayCharacter c) (P : Finset (Ideal O)) (j : Ideal O → Fin 6)
    (hP : PrimeTwistSet c.S P) (a : ℝ) (ha : 2 < a) :
    DifferentiableOn ℂ (fun s : ℂ => ∑' nb : Ideal O × Ideal O,
      sourceDirichletTerm c (productTwist c ξ P j) s nb) {s : ℂ | a < s.re} := by
  have hu : Summable (fun nb : Ideal O × Ideal O =>
      normIdeal nb.1 ^ (-a) * normIdeal nb.2 ^ (-3 * a + 1 / 2)) := by
    simpa only [Complex.ofReal_re] using
      sourceDirichlet_majorant_summable (a : ℂ) ha
  exact Complex.differentiableOn_tsum_of_summable_norm hu
    (fun nb => (sourceDirichletTerm_differentiable c (productTwist c ξ P j) nb).differentiableOn)
    (isOpen_lt continuous_const Complex.continuous_re)
    (fun nb s hs => sourceDirichletTerm_norm_bound_of_re_ge c ξ P j hP a s hs.le nb)

/-- Holomorphy on the original open half-plane, without a convergence premise. -/
theorem sourceDirichlet_differentiableOn (c : ArithmeticContext)
    (ξ : RayCharacter c) (P : Finset (Ideal O)) (j : Ideal O → Fin 6)
    (hP : PrimeTwistSet c.S P) :
    DifferentiableOn ℂ (fun s : ℂ => ∑' nb : Ideal O × Ideal O,
      sourceDirichletTerm c (productTwist c ξ P j) s nb) {s : ℂ | 2 < s.re} := by
  intro s hs
  change 2 < s.re at hs
  let a : ℝ := (s.re + 2) / 2
  have ha : 2 < a := by dsimp [a]; linarith
  have hsa : s ∈ {w : ℂ | a < w.re} := by dsimp [a]; linarith
  have hd := sourceDirichlet_differentiableOn_halfplane c ξ P j hP a ha
  have ho : IsOpen {w : ℂ | a < w.re} :=
    isOpen_lt continuous_const Complex.continuous_re
  exact ((hd s hsa).differentiableAt (ho.mem_nhds hsa)).differentiableWithinAt

theorem sourceDirichlet_analyticOnNhd (c : ArithmeticContext)
    (ξ : RayCharacter c) (P : Finset (Ideal O)) (j : Ideal O → Fin 6)
    (hP : PrimeTwistSet c.S P) :
    AnalyticOnNhd ℂ (fun s : ℂ => ∑' nb : Ideal O × Ideal O,
      sourceDirichletTerm c (productTwist c ξ P j) s nb) {s : ℂ | 2 < s.re} :=
  (sourceDirichlet_differentiableOn c ξ P j hP).analyticOnNhd
    (isOpen_lt continuous_const Complex.continuous_re)

end QRHShort.CloudBatch.ReflectionSourceDirichletAnalytic
