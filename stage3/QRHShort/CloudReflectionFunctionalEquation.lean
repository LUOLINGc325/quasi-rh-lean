    AddMonoidAlgebra.single (0, 2) (((3 : ℝ) ^ (-(1 / 3 : ℝ)) : ℝ) : ℂ) +
    AddMonoidAlgebra.single (1, 2)
      ((((3 : ℝ) ^ (-(1 / 3 : ℝ)) : ℝ) : ℂ) * ninthPhase (1 : Fin 3)) +
    AddMonoidAlgebra.single (2, 2)
      ((((3 : ℝ) ^ (-(1 / 3 : ℝ)) : ℝ) : ℂ) * ninthPhase (2 : Fin 3))

theorem literalNineKernel_isUnit : IsUnit literalNineKernel := by
  have hz3 : (3 : ZMod 3) = 0 := by decide
  have hz6 : (6 : ZMod 3) = 0 := by decide
