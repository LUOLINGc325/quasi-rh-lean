  have hupp : g 0 0 * (-z) + (-g 0 1) = -(g 0 0 * z + g 0 1) := by ring
  apply Prod.ext
  · simp only [mobiusCoordinates, horizontalFlipMatrix, Matrix.SpecialLinearGroup.coe_mk,
      Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one,
      hlow, hupp, norm_neg, star_neg, neg_mul, mul_neg, neg_neg, ← neg_add, neg_div]
  · simp only [mobiusCoordinates, horizontalFlipMatrix, Matrix.SpecialLinearGroup.coe_mk,
