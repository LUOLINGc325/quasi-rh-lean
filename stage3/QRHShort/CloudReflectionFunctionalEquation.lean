theorem sourceCuspConstant_zero_of_top_once (M : SL(2, O))
    (hdiv : lam ∣ M 0 0) (hnot : ¬lam ^ 2 ∣ M 0 0) :
    sourceCuspConstant M = 0 := by
  rw [← sourceCuspConstant_flip M]
  apply sourceCuspConstant_zero_of_once
  · rw [(cuspFlip_columns M).2]
    exact dvd_neg.mpr hdiv
  · rw [(cuspFlip_columns M).2]
    intro hh
    exact hnot (OAI.ActualEisensteinCubic.lambda_sq_dvd_three.trans (dvd_neg.mp hh))

/-- The valuation-one branch satisfies the exact original cusp-constant
normalization of the lambda cube average. -/
