theorem liftedResidualDifference_wirtingerBar_native_rows
    (q : O) (hq : q ≠ 0) (B : O) (hB : B ≠ 0)
    (ψ : O ⧸ principal B → ℂ) (v : ℝ) (hv : 0 < v) :
    wirtingerBar (fun z => liftedResidualDifference q hq B hB ψ z v hv) 0 =
