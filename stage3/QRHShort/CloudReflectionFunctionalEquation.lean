    exact continuousOn_const
  simpa only [latticeBesselTerm, ite_eq_right hm] using
    (thetaMode_height_continuousOn
      (mul_ne_zero hscale (embedding_eq_zero.not.mpr hm)) z).const_mul (coeff m)

