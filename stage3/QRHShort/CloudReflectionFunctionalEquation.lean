      (star (OAI.CubicKubota.complexCharacter (D.relativeGamma hN hr hbase u)) *
        (-1 / (embedding (c₀ * ∏ i, p i) ^ 2 * (v : ℂ) ^ 2))) *
        wirtingerZ (fun z => star (sourceCuspFunction q
          (upperPoint z (1 / (‖embedding (c₀ * ∏ i, p i)‖ ^ 2 * v))
            (by have he : embedding (c₀ * ∏ i, p i) ≠ 0 :=
                  embedding_eq_zero.not.mpr (mul_ne_zero hc₀
                    (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)))
