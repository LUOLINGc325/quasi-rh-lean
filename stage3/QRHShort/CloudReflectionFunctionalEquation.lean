  choose N data K hK hpool using hF
  let Q := Σ t : ι, Fin (N t)
  let e : Fin (Fintype.card Q) ≃ Q := (Fintype.equivFin Q).symm
  let D : Fin (Fintype.card Q) → ReflectionDatum := fun i => data (e i).1 (e i).2
  refine ⟨Fintype.card Q, D, ∑ t, ‖w t‖ * K t,
    Finset.sum_nonneg (fun t _ => mul_nonneg (norm_nonneg _) (hK t)), ?_⟩
