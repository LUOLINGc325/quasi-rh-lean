theorem norm_cusp_weight (κ : ℂ) (hκ : ‖κ‖ = 1) (z : ℂ) (hz : z ≠ 0) :
    ‖κ * ((‖z‖ ^ 2 : ℝ) : ℂ) / z ^ 2‖ = 1 := by
  rw [mul_div_assoc, norm_mul, hκ, norm_positive_denominator_ratio z hz, one_mul]

