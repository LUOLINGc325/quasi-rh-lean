theorem sourceMultiplier_norm_le_one (c : ArithmeticContext) (ξ : RayCharacter c)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (m : O) : ‖sourceMultiplier c ξ P j m‖ ≤ 1 := by
  by_cases hm : IsPrimary m ∧ Outside c.S (principal m)
