  apply Finset.sum_congr rfl
  intro res hres
  have hpoint : z / embedding q -
      3 * embedding (residueLift (principal (q * B)) res) / embedding (q * B) =
      (1 / embedding q) * z + (projectedNativeCusp q hq B hB res).point := by
    rw [projectedNativeCusp_point]
    ring
  rw [projectedNativeWeight, hpoint]
  exact mul_comm _ _

/-- The actual lifted antiholomorphic source projection is a finite sum of the
three native cusp families. The original scaled height and affine Jacobian
are explicit, with no extra smoothness or geometric premise. -/
theorem liftedConjugateResidual_native_cusp_rows
    (q : O) (hq : q ≠ 0) (B : O) (hB : B ≠ 0)
    (ψ : O ⧸ principal B → ℂ) (v : ℝ) (hv : 0 < v) :
    letI : Finite (O ⧸ principal (q * B)) :=
      Ring.HasFiniteQuotients.finiteQuotient (principal_ne_bot _ (mul_ne_zero hq hB))
