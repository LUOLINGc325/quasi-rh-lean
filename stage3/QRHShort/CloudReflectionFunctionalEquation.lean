  unfold primaryRowNormBound
  exact Finset.sum_nonneg (fun _ _ => norm_nonneg _)

theorem primaryWeightedZeroRow_norm_bound (c : O) (hc : c ≠ 0) (h₃ : (3 : O) ∣ c)
