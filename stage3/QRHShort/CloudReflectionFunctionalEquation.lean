  fin_cases i <;> fin_cases j <;>
    simp [horizontalFlipMatrix, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_fin_one, Matrix.SpecialLinearGroup.coe_mk, Fin.zero_eta,
