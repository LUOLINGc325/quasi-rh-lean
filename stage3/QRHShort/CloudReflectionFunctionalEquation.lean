        ∏ i, thetaLocalFactor (Ideal.span {p i}) (j i) m := by
  rw [D.multiplierSum_eq hN hr hbase hp hc₀ hcop
    (fun i => outside_lambda_not_mem c (hP i) (hout i))
    (fun i => outside_quotient_char_ne_two c (hP i) (hout i))
    (fun i => (j i).val) (fun i => (j i).isLt), badPhase_literal]
  unfold controlledActiveScalar ControlledStratumArithmetic.bracketProduct
  simp_rw [thetaLocalFactor_eq_bracket c (hP _) (hout _)
    (outside_lambda_not_mem c (hP _) (hout _))]
  rw [Finset.prod_mul_distrib]
  ring

end

