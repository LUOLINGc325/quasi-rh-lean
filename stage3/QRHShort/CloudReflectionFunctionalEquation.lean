lemma active_outside (c : ArithmeticContext) (P A : Finset (Ideal O))
    (hP : PrimeTwistSet c.S P) (hA : A ⊆ P) (i : A) : Outside c.S i.val :=
  prime_outside c (hP i.val (hA i.property)).1 (hP i.val (hA i.property)).2

lemma active_generator_prime (c : ArithmeticContext) (P A : Finset (Ideal O))
