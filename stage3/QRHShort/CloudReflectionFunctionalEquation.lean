  have hb0 : b ≠ 0 := by intro hb; exact hm0 (by rw [hgen, hb]; simp)
  have hnsp := OAI.CompletedGauss.primaryGenerator_spec I hn0
  have hbsp := OAI.CompletedGauss.primaryGenerator_spec J hb0
