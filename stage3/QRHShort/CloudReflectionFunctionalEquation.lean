theorem exists_primary_numerator_completion (a c : O) (ha : IsPrimary a)
    (hcop : IsCoprime a c) :
    ∃ g : SL(2, O), g 0 0 = a ∧ g 1 0 = c ∧
      (3 : O) ∣ g 0 1 ∧ (3 : O) ∣ g 1 1 - 1 := by
  obtain ⟨d, e, hde⟩ := hcop
  let b := -e
  have hdet : a * d - b * c = 1 := by dsimp [b]; linear_combination hde
  have ha₃ := (isPrimary_iff_three_dvd a).mp ha
  let g : SL(2, O) := ⟨!![a, b - a * b; c, d - c * b], by
    simp only [Matrix.det_fin_two, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one]
    linear_combination hdet⟩
  refine ⟨g, rfl, rfl, ?_, ?_⟩
  · change (3 : O) ∣ b - a * b
    convert dvd_mul_of_dvd_right ha₃ (-b) using 1 <;> ring
  · change (3 : O) ∣ d - c * b - 1
    have he : d - c * b - 1 = -d * (a - 1) := by linear_combination hdet
    rw [he]
    exact dvd_mul_of_dvd_right ha₃ (-d)

theorem exists_primary_denominator_completion (a c : O) (hc : IsPrimary c)
    (hcop : IsCoprime a c) :
    ∃ g : SL(2, O), g 0 0 = a ∧ g 1 0 = c ∧
      (3 : O) ∣ g 0 1 + 1 ∧ (3 : O) ∣ g 1 1 := by
  obtain ⟨d, e, hde⟩ := hcop
  let b := -e
  have hdet : a * d - b * c = 1 := by dsimp [b]; linear_combination hde
  have hc₃ := (isPrimary_iff_three_dvd c).mp hc
  let g : SL(2, O) := ⟨!![a, b - a * d; c, d - c * d], by
    simp only [Matrix.det_fin_two, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one]
    linear_combination hdet⟩
  refine ⟨g, rfl, rfl, ?_, ?_⟩
  · change (3 : O) ∣ b - a * d + 1
    have he : b - a * d + 1 = -b * (c - 1) := by linear_combination -hdet
    rw [he]
    exact dvd_mul_of_dvd_right hc₃ (-b)
  · change (3 : O) ∣ d - c * d
    convert dvd_mul_of_dvd_right hc₃ (-d) using 1 <;> ring

theorem exists_lower_cusp_factorization (a c u : O) (ha : IsPrimary a)
    (hcop : IsCoprime a c) (hcu : (3 : O) ∣ c - u) :
    ∃ g : SL(2, O), ∃ G : LevelThree,
      g 0 0 = a ∧ g 1 0 = c ∧ g = (G : SL(2, O)) * lowerCuspMatrix u := by
  obtain ⟨g, hga, hgc, hgb, hgd⟩ := exists_primary_numerator_completion a c ha hcop
  have hmem : g * (lowerCuspMatrix u)⁻¹ ∈ LevelThree := by
    apply lower_relative_mem
    · rw [hga]
      exact (isPrimary_iff_three_dvd a).mp ha
    · exact hgb
    · rwa [hgc]
    · exact hgd
  refine ⟨g, ⟨g * (lowerCuspMatrix u)⁻¹, hmem⟩, hga, hgc, ?_⟩
  simp

theorem exists_weyl_cusp_factorization (a c u : O) (hc : IsPrimary c)
    (hcop : IsCoprime a c) (hau : (3 : O) ∣ a - u) :
    ∃ g : SL(2, O), ∃ G : LevelThree,
      g 0 0 = a ∧ g 1 0 = c ∧ g = (G : SL(2, O)) * weylCuspMatrix u := by
  obtain ⟨g, hga, hgc, hgb, hgd⟩ := exists_primary_denominator_completion a c hc hcop
  have hmem : g * (weylCuspMatrix u)⁻¹ ∈ LevelThree := by
    apply weyl_relative_mem
    · rwa [hga]
    · exact hgb
    · rw [hgc]
      exact (isPrimary_iff_three_dvd c).mp hc
    · exact hgd
  refine ⟨g, ⟨g * (weylCuspMatrix u)⁻¹, hmem⟩, hga, hgc, ?_⟩
  simp

theorem ramified_cusp_residues (c : O) (hc : omega - 1 ∣ c) :
    (3 : O) ∣ c ∨ (3 : O) ∣ c - lambda ∨ (3 : O) ∣ c + lambda := by
  have h₃ : (3 : O) ∣ (omega - 1) * (omega - 1) := by
    refine ⟨-omega, ?_⟩
    rw [← pow_two, omega_sub_one_sq]
    ring
  have hp {t : O} (ht : omega - 1 ∣ t) : (3 : O) ∣ (omega - 1) * t :=
    h₃.trans (mul_dvd_mul_left (omega - 1) ht)
  have hlam : (3 : O) ∣ (omega - 1) + lambda := by
    refine ⟨omega, ?_⟩
    unfold lambda
    ring
  obtain ⟨t, rfl⟩ := hc
  rcases omega_sub_one_residues t with ht | ht | ht
  · exact Or.inl (hp ht)
  · apply Or.inr ∘ Or.inr
    convert dvd_add (hp ht) hlam using 1 <;> ring
  · apply Or.inr ∘ Or.inl
    convert dvd_sub (hp ht) hlam using 1 <;> ring

theorem primitive_pair_primary_normalization (a c : O) (hcop : IsCoprime a c) :
    ∃ u : Oˣ, IsCoprime ((u : O) * a) ((u : O) * c) ∧
      (omega - 1 ∣ c → IsPrimary ((u : O) * a)) ∧
      (¬ omega - 1 ∣ c → IsPrimary ((u : O) * c)) := by
  by_cases hc : omega - 1 ∣ c
  · have ha : ¬ omega - 1 ∣ a := by
      intro ha
      exact omega_sub_one_prime.not_unit (hcop.isUnit_of_dvd' ha hc)
    obtain ⟨u, hu⟩ := exists_primary_unit_of_not_dvd a ha
    refine ⟨u, (isCoprime_mul_unit_left u.isUnit a c).mpr hcop, fun _ => hu, ?_⟩
    exact fun h => (h hc).elim
  · obtain ⟨u, hu⟩ := exists_primary_unit_of_not_dvd c hc
    refine ⟨u, (isCoprime_mul_unit_left u.isUnit a c).mpr hcop, ?_, fun _ => hu⟩
    exact fun h => (hc h).elim

theorem embedding_fraction_unit_normalization (u : Oˣ) (a c : O) :
    embedding ((u : O) * a) / embedding ((u : O) * c) = embedding a / embedding c := by
  have hu : embedding (u : O) ≠ 0 := embedding_eq_zero.not.mpr u.ne_zero
  simp only [embedding_mul]
  exact mul_div_mul_left _ _ hu

def CuspIndex := Fin 3 ⊕ (O ⧸ principal (3 : O))

noncomputable instance cuspIndexFintype : Fintype CuspIndex := by
  have hI : principal (3 : O) ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr (by norm_num)
  letI : Finite (O ⧸ principal (3 : O)) := Ring.HasFiniteQuotients.finiteQuotient hI
  change Fintype (Fin 3 ⊕ (O ⧸ principal (3 : O)))
  exact Fintype.ofFinite _

def finiteCuspMatrix : CuspIndex → SL(2, O)
  | .inl i => lowerCuspMatrix (![0, lambda, -lambda] i)
  | .inr q => weylCuspMatrix (residueLift (principal (3 : O)) q)

/-- Every primitive cusp is a unit-normalized first column of a level-three
matrix times one of this fixed finite list of actual representatives. -/
theorem exists_finite_cusp_factorization (a c : O) (hcop : IsCoprime a c) :
    ∃ u : Oˣ, ∃ i : CuspIndex, ∃ g : SL(2, O), ∃ G : LevelThree,
      g 0 0 = (u : O) * a ∧ g 1 0 = (u : O) * c ∧
      g = (G : SL(2, O)) * finiteCuspMatrix i := by
  obtain ⟨u, hu, hupa, hupc⟩ := primitive_pair_primary_normalization a c hcop
  by_cases hc : omega - 1 ∣ c
  · have huc : omega - 1 ∣ (u : O) * c := dvd_mul_of_dvd_right hc _
    rcases ramified_cusp_residues ((u : O) * c) huc with h0 | h1 | h2
    · obtain ⟨g, G, hga, hgc, he⟩ := exists_lower_cusp_factorization
        ((u : O) * a) ((u : O) * c) 0 (hupa hc) hu (by simpa only [sub_zero] using h0)
      exact ⟨u, .inl 0, g, G, hga, hgc, he⟩
    · obtain ⟨g, G, hga, hgc, he⟩ := exists_lower_cusp_factorization
        ((u : O) * a) ((u : O) * c) lambda (hupa hc) hu h1
      exact ⟨u, .inl 1, g, G, hga, hgc, he⟩
    · obtain ⟨g, G, hga, hgc, he⟩ := exists_lower_cusp_factorization
        ((u : O) * a) ((u : O) * c) (-lambda) (hupa hc) hu (by simpa only [sub_neg_eq_add] using h2)
      exact ⟨u, .inl 2, g, G, hga, hgc, he⟩
  · let q := Ideal.Quotient.mk (principal (3 : O)) ((u : O) * a)
    have hdiff : (3 : O) ∣ (u : O) * a - residueLift (principal (3 : O)) q := by
      apply Ideal.mem_span_singleton.mp
      apply Ideal.Quotient.eq.mp
      exact (residueLift_spec (principal (3 : O)) q).symm
    obtain ⟨g, G, hga, hgc, he⟩ := exists_weyl_cusp_factorization
      ((u : O) * a) ((u : O) * c) (residueLift (principal (3 : O)) q) (hupc hc) hu hdiff
    exact ⟨u, .inr q, g, G, hga, hgc, he⟩

end QRHShort.CloudBatch.ReflectionCuspNormalForms









