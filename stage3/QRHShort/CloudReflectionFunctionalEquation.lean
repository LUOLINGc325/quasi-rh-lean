      -(3 : O) * (omega ^ a * lam ^ n) * ramifiedTopElement η a r m := by
  have hunit : (ramifiedSourceDenominatorUnit η a : O) * (ramifiedTopUnit η a : O) = 1 := by
    simpa only [Units.val_mul, Units.val_one] using congrArg Units.val (ramifiedTopUnit_inverse η a)
  have hp := ramified_numerator_times_denominator η a n (n + 2) (by omega) (lam ^ r * m)
  have hpow : ((η : O) * lam ^ (n + 2 + r)) * m =
      ((η : O) * lam ^ (n + 2)) * (lam ^ r * m) := by rw [pow_add]; ring
  have hd : ramifiedSourceDenominator η a n (n + 2) =
      (ramifiedSourceDenominatorUnit η a : O) := by
    simp only [ramifiedSourceDenominator, Nat.sub_self, pow_zero, mul_one]
  rw [← hpow, hd] at hp
  calc
    _ = ((((η : O) * lam ^ (n + 2 + r)) * m) *
        (ramifiedSourceDenominatorUnit η a : O)) * (ramifiedTopUnit η a : O) := by
      simpa only [hunit, mul_one] using
        (mul_assoc (((η : O) * lam ^ (n + 2 + r)) * m)
