    simpa only [ramifiedCuspTauWeight, ramifiedProfileShift, mul_assoc] using hC side h
  intro side z v hv
  exact sourceCuspZFamily_ramified_original_profiles C hC' side z v hv

theorem exists_fixed_ramified_cusp_shifted_series :
    ∃ C : RamifiedNineGroup → ℂ, ∀ (side : Bool) (z : ℂ) (v : ℝ), 0 < v →
      sourceCuspZFamily (if side then 2 else 1) z v =
