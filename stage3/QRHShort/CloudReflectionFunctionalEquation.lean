open Classical
open scoped BigOperators ComplexConjugate

namespace QRHShort.CloudBatch.ReflectionResidual
open ReflectionFE

private theorem sign_root_unit (s : ℂ) (hs : s = 1 ∨ s = -1) (j : Fin 3) :
    ∃ u : O, IsUnit u ∧ embedding u = s * embedding omega ^ j.val := by
  have hw : IsUnit omega :=
    (IsCyclotomicExtension.zeta_spec 3 ℚ K).toInteger_isPrimitiveRoot.isUnit (by decide)
  rcases hs with rfl | rfl
  · exact ⟨omega ^ j.val, hw.pow _, by simp⟩
  · exact ⟨-(omega ^ j.val), (hw.pow _).neg, by simp⟩

private theorem sign_root_cube (s : ℂ) (hs : s = 1 ∨ s = -1) (j : Fin 3) :
    (s * embedding omega ^ j.val) ^ (3 : ℕ) = s := by
  have hw : (embedding omega ^ j.val) ^ (3 : ℕ) = 1 := by
    rw [← pow_mul, Nat.mul_comm, pow_mul, ← embedding_pow, omega_cube, embedding_one, one_pow]
  rw [mul_pow, hw, mul_one]
  rcases hs with rfl | rfl <;> norm_num

theorem ramified_complex_frequency_unique (a : ℤ)
    (s s' : ℂ) (hs : s = 1 ∨ s = -1) (hs' : s' = 1 ∨ s' = -1)
    (j j' : Fin 3) (n b n' b' : O)
    (hnb : PrimaryCubeData n b) (hnb' : PrimaryCubeData n' b') (m m' : ℕ)
    (he : s * embedding omega ^ j.val * embedding lambda ^ ((m : ℤ) + a) *
        embedding (n * b ^ 3) =
      s' * embedding omega ^ j'.val * embedding lambda ^ ((m' : ℤ) + a) *
        embedding (n' * b' ^ 3)) :
    m = m' ∧ n = n' ∧ b = b' ∧ j = j' ∧ s = s' := by
  obtain ⟨u, hu, heu⟩ := sign_root_unit s hs j
  obtain ⟨u', hu', heu'⟩ := sign_root_unit s' hs' j'
  have hl : embedding lambda ≠ 0 := embedding_eq_zero.not.mpr lambda_prime.ne_zero
  have hscale (v N : O) (k : ℕ) :
      embedding (v * lambda ^ k * N) =
        embedding lambda ^ (-a) *
          (embedding v * embedding lambda ^ ((k : ℤ) + a) * embedding N) := by
    have hp : embedding lambda ^ (-a) * embedding lambda ^ ((k : ℤ) + a) =
        embedding lambda ^ k := by
      rw [← zpow_add₀ hl]
      rw [show -a + ((k : ℤ) + a) = (k : ℤ) by ring, zpow_natCast]
    simp only [embedding_mul, embedding_pow]
    rw [show embedding lambda ^ (-a) *
        (embedding v * embedding lambda ^ ((k : ℤ) + a) * embedding N) =
      embedding v * (embedding lambda ^ (-a) * embedding lambda ^ ((k : ℤ) + a)) *
        embedding N by ring, hp]
  have hering : u * lambda ^ m * (n * b ^ 3) = u' * lambda ^ m' * (n' * b' ^ 3) := by
    apply embedding_injective
    rw [hscale, hscale, heu, heu', he]
  obtain ⟨hm, hn, hb, huu⟩ := ramified_primary_cube_unique u u' n b n' b'
    hu hu' hnb hnb' m m' hering
  have hunit : s * embedding omega ^ j.val = s' * embedding omega ^ j'.val :=
    heu.symm.trans ((congrArg embedding huu).trans heu')
  have hss : s = s' := by
    have hh := congrArg (fun z : ℂ => z ^ (3 : ℕ)) hunit
    simpa only [sign_root_cube s hs j, sign_root_cube s' hs' j'] using hh
  have hs0 : s ≠ 0 := by rcases hs with rfl | rfl <;> norm_num
  have hj : j = j' := by
    apply Fin.ext
    apply OAI.ActualEisensteinCubic.omega_primitive.pow_inj j.isLt j'.isLt
    apply embedding_injective
    simp only [embedding_pow]
    rw [← hss] at hunit
    exact mul_left_cancel₀ hs0 hunit
  exact ⟨hm, hn, hb, hj, hss⟩

theorem TauFormula_functional {ell v v' : ℂ}
    (h : TauFormula ell v) (h' : TauFormula ell v') : v = v' := by
  rcases h with ⟨n, b, hnb, s, hs, h⟩
  rcases h' with ⟨n', b', hnb', s', hs', h'⟩
  rcases h with ⟨k, j, hk, he, hv⟩ | ⟨k, he, hv⟩
  · rcases h' with ⟨k', j', hk', he', hv'⟩ | ⟨k', he', hv'⟩
    · have hc : (3 : ℤ) * k - 4 = ((3 * k - 1 : ℕ) : ℤ) + (-3) := by omega
      have hc' : (3 : ℤ) * k' - 4 = ((3 * k' - 1 : ℕ) : ℤ) + (-3) := by omega
      have hh := ramified_complex_frequency_unique (-3) s s' hs hs' j j' n b n' b'
        hnb hnb' (3 * k - 1) (3 * k' - 1) (by simpa only [hc, hc'] using he.symm.trans he')
      obtain ⟨hm, rfl, rfl, rfl, hss⟩ := hh
      have hkk : k = k' := by omega
      subst k'
      exact hv.trans hv'.symm
    · have hc : (3 : ℤ) * k - 4 = ((3 * k - 1 : ℕ) : ℤ) + (-3) := by omega
      have hc' : (3 : ℤ) * k' - 3 = ((3 * k' : ℕ) : ℤ) + (-3) := by push_cast; ring
      have hh := ramified_complex_frequency_unique (-3) s s' hs hs' j 0 n b n' b'
        hnb hnb' (3 * k - 1) (3 * k') (by simpa only [hc, hc', Fin.val_zero,
          pow_zero, mul_one] using he.symm.trans he')
      omega
  · rcases h' with ⟨k', j', hk', he', hv'⟩ | ⟨k', he', hv'⟩
    · have hc : (3 : ℤ) * k - 3 = ((3 * k : ℕ) : ℤ) + (-3) := by push_cast; ring
      have hc' : (3 : ℤ) * k' - 4 = ((3 * k' - 1 : ℕ) : ℤ) + (-3) := by omega
      have hh := ramified_complex_frequency_unique (-3) s s' hs hs' 0 j' n b n' b'
        hnb hnb' (3 * k) (3 * k' - 1) (by simpa only [hc, hc', Fin.val_zero,
          pow_zero, mul_one] using he.symm.trans he')
      omega
    · have hc : (3 : ℤ) * k - 3 = ((3 * k : ℕ) : ℤ) + (-3) := by push_cast; ring
      have hc' : (3 : ℤ) * k' - 3 = ((3 * k' : ℕ) : ℤ) + (-3) := by push_cast; ring
      have hh := ramified_complex_frequency_unique (-3) s s' hs hs' 0 0 n b n' b'
        hnb hnb' (3 * k) (3 * k') (by simpa only [hc, hc', Fin.val_zero,
          pow_zero, mul_one] using he.symm.trans he')
      obtain ⟨hm, rfl, rfl, hj, hss⟩ := hh
      have hkk : k = k' := by omega
      subst k'
      exact hv.trans hv'.symm

theorem tau_eq_of_formula {ell v : ℂ} (h : TauFormula ell v) : tau ell = v := by
  rw [tau, dif_pos ⟨v, h⟩]
  exact TauFormula_functional (Classical.choose_spec ⟨v, h⟩) h

theorem AuxiliaryTauFormula_functional {second : Bool} {ell v v' : ℂ}
    (h : AuxiliaryTauFormula second ell v) (h' : AuxiliaryTauFormula second ell v') :
    v = v' := by
  rcases h with ⟨n, b, hnb, j, he, hv⟩
  rcases h' with ⟨n', b', hnb', j', he', hv'⟩
  have hs : (if second then (-1 : ℂ) else 1) = 1 ∨
      (if second then (-1 : ℂ) else 1) = -1 := by cases second <;> simp
  have hh := ramified_complex_frequency_unique (-4)
    (if second then -1 else 1) (if second then -1 else 1) hs hs j j' n b n' b'
    hnb hnb' 0 0 (by simpa only [Nat.cast_zero, zero_add] using he.symm.trans he')
  obtain ⟨hm, rfl, rfl, rfl, hss⟩ := hh
  exact hv.trans hv'.symm

theorem auxiliaryTau_eq_of_formula {second : Bool} {ell v : ℂ}
    (h : AuxiliaryTauFormula second ell v) : auxiliaryTau second ell = v := by
  rw [auxiliaryTau, dif_pos ⟨v, h⟩]
  exact AuxiliaryTauFormula_functional (Classical.choose_spec ⟨v, h⟩) h

end QRHShort.CloudBatch.ReflectionResidual





