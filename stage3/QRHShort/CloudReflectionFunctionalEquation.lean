    productTwist_cube c ξ P j hP hbo, sexticSymbol_mul_denominator,
    sexticSymbol_cube_denominator, mul_pow]
  rw [← pow_mul, show 3 * 2 = 6 from rfl, sexticSymbol_lambda_sixth c hbo]
  ring

/-- The literal cusp coefficient equals the normalized source coefficient.
