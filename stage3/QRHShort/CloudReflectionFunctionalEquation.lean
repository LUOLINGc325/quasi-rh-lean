    (α : ℂ) (hα : ‖α‖ ≤ 1) : ‖geometricRowWeight q c L α‖ ≤ ‖q‖ * normElement L := by
  rw [geometricRowWeight_norm q c L hc α]
  apply mul_le_of_le_one_right
  · rw [normElement_eq_embedding_sq]
    positivity
  · exact hα

