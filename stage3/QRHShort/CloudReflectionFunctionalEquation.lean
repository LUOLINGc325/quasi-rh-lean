local instance (K : ℕ) : Fintype (O ⧸ principal (boundedRamifiedModulus K)) := Fintype.ofFinite _

theorem primaryBoundaryTerm_eq_truncatedZeroTerm (u : Oˣ) (nc : ℕ) (hnc : 2 ≤ nc)
    (v : Oˣ) (ns : ℕ) (t q : O) (z : ℂ) (V : ℝ) (h : O) :
    (if 3 * ((u : O) * lam ^ nc) ∣ h then 0 else
      primaryWeightedZeroRow ((u : O) * lam ^ nc) (ramifiedElement_level u nc hnc) v ns t h *
        normalizedPhysicalPrefactor q ((u : O) * lam ^ nc) * sourceCuspZTerm 0 z V h) =
      truncatedZeroTerm (nc + 1)
        (primaryBoundaryAmplitude ((u : O) * lam ^ nc) (ramifiedElement_level u nc hnc) v ns t q)
        z V h := by
  rw [truncatedZeroTerm, three_ramified_dvd_iff_trace_power,
    show nc + 1 + 1 = nc + 2 by omega]
  rfl

/-- The actual nondeep part of every original ramified primary row is an
absolutely convergent finite family of the original zero-cusp profiles.
Only the ramified exponent fixes the finite Fourier coefficients. -/
theorem exists_primaryBoundary_profiles (nc : ℕ) :
    ∃ A : RamifiedNineGroup → (O ⧸ principal (boundedRamifiedModulus (nc + 1))) → ℂ,
      ∃ B : ℝ, 0 ≤ B ∧ (∀ j a, ‖A j a‖ ≤ B) ∧
      ∀ (u : Oˣ) (hnc : 2 ≤ nc) (v : Oˣ) (ns : ℕ) (t q : O) (z : ℂ) (V : ℝ), 0 < V →
        Summable (fun h : O => if 3 * ((u : O) * lam ^ nc) ∣ h then 0 else
          primaryWeightedZeroRow ((u : O) * lam ^ nc) (ramifiedElement_level u nc hnc) v ns t h *
            normalizedPhysicalPrefactor q ((u : O) * lam ^ nc) * sourceCuspZTerm 0 z V h) ∧
        (∑' h : O, if 3 * ((u : O) * lam ^ nc) ∣ h then 0 else
          primaryWeightedZeroRow ((u : O) * lam ^ nc) (ramifiedElement_level u nc hnc) v ns t h *
            normalizedPhysicalPrefactor q ((u : O) * lam ^ nc) * sourceCuspZTerm 0 z V h) =
          ∑ j : RamifiedNineGroup,
            ∑ a : O ⧸ principal (boundedRamifiedModulus (nc + 1)),
              star (A j a) * (((‖embedding (ramifiedUpShift j)‖ : ℂ) / embedding (ramifiedUpShift j)) *
                cuspZProfile .zero
                  (liftProjectedMultiplier (dualCoefficientShift (ramifiedUpShift j))
                    (truncatedZeroMultiplier (nc + 1)
                      (primaryBoundaryAmplitude ((u : O) * lam ^ nc) (ramifiedElement_level u nc hnc)
                        v ns t q) z a))
                  (V / ‖embedding (ramifiedUpShift j)‖)) := by
  obtain ⟨A, B, hB, hbound, hA⟩ := zero_bounded_valuation_original_profiles (nc + 1)
  refine ⟨A, B, hB, hbound, ?_⟩
  intro u hnc v ns t q z V hV
  let c : O := (u : O) * lam ^ nc
  have hc : c ≠ 0 := ramifiedElement_ne_zero u nc
  let h₃ : (3 : O) ∣ c := ramifiedElement_level u nc hnc
  let χ : O → ℂ := primaryBoundaryAmplitude c h₃ v ns t q
  let D : ℝ := primaryRowNormBound c hc h₃ v ns t * ‖normalizedPhysicalPrefactor q c‖
  have hD : 0 ≤ D := mul_nonneg (primaryRowNormBound_nonneg c hc h₃ v ns t) (norm_nonneg _)
  have hχ : ∀ h : O, h ≠ 0 → ‖χ h‖ ≤ D * ‖embedding h‖ ^ (0 : ℕ) := by
    intro h _
    simpa only [pow_zero, mul_one] using primaryBoundaryAmplitude_norm_bound c hc h₃ v ns t q h
  have he := hA χ D 0 hD hχ z V hV
  refine ⟨?_, ?_⟩
  · apply he.1.congr
    intro h
    exact (primaryBoundaryTerm_eq_truncatedZeroTerm u nc hnc v ns t q z V h).symm
  · calc
      _ = truncatedZeroFamily (nc + 1) χ z V := by
        apply tsum_congr
        intro h
        exact primaryBoundaryTerm_eq_truncatedZeroTerm u nc hnc v ns t q z V h
      _ = _ := he.2

end QRHShort.CloudBatch.ReflectionPrimaryBoundaryProfiles



