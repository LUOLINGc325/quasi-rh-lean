    ((‖embedding (zeroTemplateShift i n)‖ : ℂ) / embedding (zeroTemplateShift i n))

theorem ramifiedUpShift_normalForm (i : RamifiedNineGroup) :
    ramifiedUpShift i = (zeroTemplateUnit i : O) * lambda ^ zeroTemplateExponent i := by
  rfl

theorem zeroTemplateDecimation_ne_zero (i : RamifiedNineGroup) (n : ℕ) :
    zeroTemplateDecimation i n ≠ 0 :=
  dualCoefficientShift_ne_zero (adjustedRamifiedShift_ne_zero _ _ _)

theorem zeroTemplateDenominator_ne_zero (c₀ : O) (hc₀ : c₀ ≠ 0)
    (i : RamifiedNineGroup) (n : ℕ) : zeroTemplateDenominator c₀ i n ≠ 0 :=
  mul_ne_zero hc₀ (pow_ne_zero _ lambda_prime.ne_zero)

theorem zeroTemplateScalar_norm_le_one (i : RamifiedNineGroup) (n : ℕ) :
    ‖zeroTemplateScalar i n‖ ≤ 1 := padded_profile_scalar_norm_le_one _ _ _

theorem supported_zero_decimation (c : ArithmeticContext) (i : RamifiedNineGroup) (n : ℕ)
    (p : Ideal O) (hp : Prime p) (hd : p ∣ principal (zeroTemplateDecimation i n)) : p ∈ c.S := by
  have he : zeroTemplateDecimation i n =
