    (u : Oˣ) (n : ℕ) (t h : O) :
    letI : Fintype (AdmissibleResidue c) := @Fintype.ofFinite _ (finite_admissibleResidue c hc)
    primaryWeightedZeroRow c h₃ u n t h =
      ∑ r : AdmissibleResidue c,
        primaryRowWeight c h₃ u n t r * residueAdditive h c (denominatorRep c r.val) := by
  letI : Fintype (AdmissibleResidue c) := @Fintype.ofFinite _ (finite_admissibleResidue c hc)
