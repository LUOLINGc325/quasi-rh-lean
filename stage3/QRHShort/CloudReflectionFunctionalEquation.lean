/-- The variable theta factors move to the full frequency after division by a
fixed supported element. Only a fixed norm-one scalar is cancelled. -/
theorem liftProjectedMultiplier_product_thetaLocalFactors (c : ArithmeticContext)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (A : Finset (Ideal O)) (hA : A ⊆ P) (q : O) (hq : q ≠ 0)
    (hsupport : ∀ p : Ideal O, Prime p → p ∣ principal q → p ∈ c.S)
    (φ : O → ℂ) (H : O) :
    liftProjectedMultiplier q (fun m => φ m * ∏ p ∈ A, thetaLocalFactor p (j p) m) H =
      (dualProjectionTwistScalar A j q)⁻¹ * liftProjectedMultiplier q φ H *
        ∏ p ∈ A, thetaLocalFactor p (j p) H := by
  by_cases hdiv : q ∣ H
  · obtain ⟨m, rfl⟩ := hdiv
    rw [liftProjectedMultiplier_mul q hq, liftProjectedMultiplier_mul q hq,
      thetaLocalFactor_product_fixed_cancel c P j hP A hA q hsupport m]
    ring
  · simp only [liftProjectedMultiplier, dif_neg hdiv, mul_zero, zero_mul]

/-- The fixed lifted factor is the actual function on O/(qB), independent of
P, j and A. The original local factors still use the complete frequency H. -/
theorem liftProjectedMultiplier_product_thetaLocalFactors_quotient
    (q : O) (hq : q ≠ 0) (B : O) (ψ : (O ⧸ principal B) → ℂ)
    (c : ArithmeticContext)
    (hsupport : ∀ p : Ideal O, Prime p → p ∣ principal q → p ∈ c.S)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (A : Finset (Ideal O)) (hA : A ⊆ P) (H : O) :
    liftProjectedMultiplier q
        (fun m => ψ (Ideal.Quotient.mk (principal B) m) * ∏ p ∈ A, thetaLocalFactor p (j p) m) H =
      (dualProjectionTwistScalar A j q)⁻¹ *
        projectedQuotientMultiplier q hq B ψ (Ideal.Quotient.mk (principal (q * B)) H) *
          ∏ p ∈ A, thetaLocalFactor p (j p) H := by
  rw [projectedQuotientMultiplier_mk]
  exact liftProjectedMultiplier_product_thetaLocalFactors c P j hP A hA q hq hsupport _ H

theorem dualProjectionTwistScalar_inv_norm (c : ArithmeticContext)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (A : Finset (Ideal O)) (hA : A ⊆ P) (q : O)
    (hsupport : ∀ p : Ideal O, Prime p → p ∣ principal q → p ∈ c.S) :
    ‖(dualProjectionTwistScalar A j q)⁻¹‖ = 1 := by
  rw [norm_inv, dualProjectionTwistScalar_norm c P j hP A hA q hsupport, inv_one]

theorem projected_dual_multiplier_norm_le_one (q : O) (hq : q ≠ 0) (B : O)
    (ψ : (O ⧸ principal B) → ℂ) (hψ : ∀ x, ‖ψ x‖ ≤ 1)
    (H : O ⧸ principal (q * B)) : ‖projectedQuotientMultiplier q hq B ψ H‖ ≤ 1 :=
  projectedQuotientMultiplier_norm_bound q hq B ψ 1 hψ H

/-- Complex scalar linearity of the actual original cusp Z profile. This
identity asserts no convergence and requires no new convergence premise. -/
theorem cuspZProfile_const_mul (σ : ThetaCusp) (a : ℂ) (φ : O → ℂ) (v : ℝ) :
    cuspZProfile σ (fun m => a * φ m) v = a * cuspZProfile σ φ v := by
  calc
    _ = ∑' m : O, a * cuspZTerm σ φ v m := by
      change (∑' m : O, cuspZTerm σ (fun m => a * φ m) v m) = _
      exact tsum_congr (fun m => cuspZTerm_mul σ (fun _ => a) φ v m)
    _ = _ := tsum_mul_left

/-- The literal zero-cusp profile keeps the decimation mask and every
original theta factor, extracting only the fixed norm-one scalar. -/
theorem cuspZProfile_lift_product_thetaLocalFactors (c : ArithmeticContext)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (A : Finset (Ideal O)) (hA : A ⊆ P) (q : O) (hq : q ≠ 0)
    (hsupport : ∀ p : Ideal O, Prime p → p ∣ principal q → p ∈ c.S)
    (φ : O → ℂ) (v : ℝ) :
    cuspZProfile .zero
        (liftProjectedMultiplier q (fun m => φ m * ∏ p ∈ A, thetaLocalFactor p (j p) m)) v =
      (dualProjectionTwistScalar A j q)⁻¹ *
        cuspZProfile .zero (fun H => liftProjectedMultiplier q φ H *
          ∏ p ∈ A, thetaLocalFactor p (j p) H) v := by
  have he : liftProjectedMultiplier q (fun m => φ m * ∏ p ∈ A, thetaLocalFactor p (j p) m) =
      (fun H => (dualProjectionTwistScalar A j q)⁻¹ *
        (liftProjectedMultiplier q φ H * ∏ p ∈ A, thetaLocalFactor p (j p) H)) := by
    funext H
    rw [liftProjectedMultiplier_product_thetaLocalFactors c P j hP A hA q hq hsupport]
    ring
  rw [he, cuspZProfile_const_mul]

theorem cuspZProfile_lift_product_thetaLocalFactors_quotient
    (q : O) (hq : q ≠ 0) (B : O) (ψ : (O ⧸ principal B) → ℂ)
    (c : ArithmeticContext)
    (hsupport : ∀ p : Ideal O, Prime p → p ∣ principal q → p ∈ c.S)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (A : Finset (Ideal O)) (hA : A ⊆ P) (v : ℝ) :
    cuspZProfile .zero (liftProjectedMultiplier q (fun m =>
        ψ (Ideal.Quotient.mk (principal B) m) * ∏ p ∈ A, thetaLocalFactor p (j p) m)) v =
      (dualProjectionTwistScalar A j q)⁻¹ *
        cuspZProfile .zero (fun H =>
          projectedQuotientMultiplier q hq B ψ (Ideal.Quotient.mk (principal (q * B)) H) *
            ∏ p ∈ A, thetaLocalFactor p (j p) H) v := by
  simpa only [projectedQuotientMultiplier_mk] using
    cuspZProfile_lift_product_thetaLocalFactors c P j hP A hA q hq hsupport
      (fun m => ψ (Ideal.Quotient.mk (principal B) m)) v

end QRHShort.CloudBatch.ReflectionDualLiftTwists








