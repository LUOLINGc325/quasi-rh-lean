residual expression. It is not an extra premise for splitting the difference. -/
theorem liftedConjugateResidual_line_differentiable
    (q : O) (hq : q ≠ 0) (B : O) (hB : B ≠ 0)
    (ψ : O ⧸ principal B → ℂ) (z d : ℂ) (v : ℝ) (hv : 0 < v) :
    DifferentiableAt ℝ
      (fun t : ℝ => liftedConjugateResidual q hq B hB ψ (z + (t : ℂ) * d) v hv) 0 := by
  letI : Finite (O ⧸ principal (q * B)) :=
    Ring.HasFiniteQuotients.finiteQuotient (principal_ne_bot _ (mul_ne_zero hq hB))
  letI : Fintype (O ⧸ principal (q * B)) := Fintype.ofFinite _
