/-- Pure integral column data for the actual cube-average cusp. No relation
between the old and new cusp classes is imposed. -/
structure RamifiedCubeCuspData (M : SL(2, O)) (p q : O) where
  exponent : Fin 4
  matrix : SL(2, O)
  first : M 0 0 + 3 * q * M 1 0 = p ^ exponent.val * matrix 0 0
  second : p ^ 3 * M 1 0 = p ^ exponent.val * matrix 1 0

def ramifiedCubeCuspTriangular {A:SL(2,O)} {p q:Eis} (d:RamifiedCubeCuspData A p q) (hp:p≠0) : SL(2,ℂ) :=
  (integralComplexMatrix d.matrix)⁻¹*cubeAverageMatrix p hp q*integralComplexMatrix A

lemma ramifiedCubeCuspTriangular_factor {A:SL(2,O)} {p q:Eis} (d:RamifiedCubeCuspData A p q) (hp:p≠0) :
    cubeAverageMatrix p hp q*integralComplexMatrix A=
      integralComplexMatrix d.matrix*ramifiedCubeCuspTriangular d hp := by
  unfold ramifiedCubeCuspTriangular
