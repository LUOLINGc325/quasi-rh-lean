local instance (K : ℕ) : Fintype (O ⧸ principal (boundedRamifiedModulus K)) := Fintype.ofFinite _

def zeroBadModulus (K : ℕ) (B : O) : O := boundedRamifiedModulus K * B

theorem zeroBadModulus_ne_zero (K : ℕ) (B : O) (hB : B ≠ 0) : zeroBadModulus K B ≠ 0 :=
