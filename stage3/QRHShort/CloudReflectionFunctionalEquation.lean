      ∑ i, w i * wirtingerBar (fun x => star (cubicSourceResidualFunction
        (upperPoint (a i * x + b i) (v i) (hv i)))) z := by
    have h1 (i : ι) :=
      conjugate_source_affine_line_differentiable (a i) (b i) z 1 (v i) (hv i)
    simp only [mul_one] at h1
    unfold wirtingerBar
    rw [deriv_fun_sum (fun i _ => (h1 i).const_mul (w i)),
      deriv_fun_sum (fun i _ =>
        (conjugate_source_affine_line_differentiable (a i) (b i) z Complex.I
          (v i) (hv i)).const_mul (w i))]
    simp_rw [deriv_const_mul_field]
    rw [Finset.mul_sum, ← Finset.sum_add_distrib, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    ring
  rw [hsum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [conjugate_source_wirtingerBar_affine]

/-- Every row is one of the three native cusps, with its actual lower-entry
scale and character. No identification with the literal theta cusps is made. -/
theorem finite_weighted_native_cusp_rows {ι : Type*} [Fintype ι]
    (w a : ι → ℂ) (d : ι → SourceCuspDatum)
    (v : ι → ℝ) (hv : ∀ i, 0 < v i) :
    wirtingerBar (fun x => ∑ i, w i * star (cubicSourceResidualFunction
      (upperPoint (a i * x + (d i).point) (v i) (hv i)))) 0 =
      ∑ i, w i * (star (a i) * ((d i).multiplier / (v i : ℂ) ^ 2 *
        sourceCuspZFamily (d i).index (d i).dualPoint (((d i).heightScale * v i)⁻¹))) := by
  rw [finite_weighted_conjugate_source_derivative]
  apply Finset.sum_congr rfl
  intro i hi
  rw [mul_zero, zero_add, conjugate_source_wirtingerBar_eq_cuspBarProfile,
    (d i).reflection (v i) (hv i)]

def projectedNativeCusp (q : O) (hq : q ≠ 0) (B : O) (hB : B ≠ 0)
    (res : O ⧸ principal (q * B)) : SourceCuspDatum :=
  rationalSourceCusp (-3 * residueLift (principal (q * B)) res) (q * B) (mul_ne_zero hq hB)

theorem projectedNativeCusp_point (q : O) (hq : q ≠ 0) (B : O) (hB : B ≠ 0)
    (res : O ⧸ principal (q * B)) :
    (projectedNativeCusp q hq B hB res).point =
      -3 * embedding (residueLift (principal (q * B)) res) / embedding (q * B) := by
  rw [projectedNativeCusp, rationalSourceCusp_point]
  simp only [map_mul, map_neg, map_ofNat, oai_embedding_eq, embedding_mul]

def projectedNativeWeight (q : O) (hq : q ≠ 0) (B : O) (hB : B ≠ 0)
    (ψ : O ⧸ principal B → ℂ) (res : O ⧸ principal (q * B)) : ℂ :=
  star (sourceFourierWeight (q * B) (mul_ne_zero hq hB)
    (projectedQuotientMultiplier q hq B (fun x => star (ψ x))) res)

theorem liftedConjugateResidual_eq_finite_native_source
    (q : O) (hq : q ≠ 0) (B : O) (hB : B ≠ 0)
    (ψ : O ⧸ principal B → ℂ) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    letI : Finite (O ⧸ principal (q * B)) :=
      Ring.HasFiniteQuotients.finiteQuotient (principal_ne_bot _ (mul_ne_zero hq hB))
    letI : Fintype (O ⧸ principal (q * B)) := Fintype.ofFinite _
    liftedConjugateResidual q hq B hB ψ z v hv =
      (‖embedding q‖ : ℂ) * ∑ res : O ⧸ principal (q * B),
        projectedNativeWeight q hq B hB ψ res * star (cubicSourceResidualFunction
          (upperPoint ((1 / embedding q) * z + (projectedNativeCusp q hq B hB res).point)
            (v / ‖embedding q‖)
            (div_pos hv (norm_pos_iff.mpr (embedding_eq_zero.not.mpr hq))))) := by
