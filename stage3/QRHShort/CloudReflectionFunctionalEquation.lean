  have hph' : ¬p ∣ h * lam ^ 3 := by
    intro hd
    rcases hp.dvd_mul.mp hd with hh | hl
    · exact hph hh
    · exact hpl (hp.dvd_of_dvd_pow hl)
  unfold ramifiedDifferenceCoefficient
  rw [show (h * p ^ k) * lam ^ 3 = (h * lam ^ 3) * p ^ k by ring,
    sourceResidualFourierCoefficient_prime_power_vanish p hp hpp _ hph' k hk,
    sourceResidualFourierCoefficient_prime_power_vanish p hp hpp h hph k hk]
  ring

