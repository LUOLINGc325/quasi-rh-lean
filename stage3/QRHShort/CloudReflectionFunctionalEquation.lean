theorem automorphy_normalized_reflection (F : ℂ → ℝ → ℂ) (C : ℂ)
    (hF : ∀ (g : LevelThree) (z : ℂ) (v : ℝ), 0 < v →
      F (mobiusCoordinates (embeddedMatrix (g : SL(2, O))) z v).1
        (mobiusCoordinates (embeddedMatrix (g : SL(2, O))) z v).2 =
      kubotaMultiplier g * F z v)
    (g : LevelThree) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    C * F (-(mobiusCoordinates (embeddedMatrix (g : SL(2, O))) z v).1)
        (mobiusCoordinates (embeddedMatrix (g : SL(2, O))) z v).2 =
      kubotaMultiplier g * (C * F (-z) v) := by
  rw [automorphy_horizontal_reflection F hF g z v hv]
  ring

