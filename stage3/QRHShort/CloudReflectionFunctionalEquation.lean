local instance (K : ℕ) : Finite (O ⧸ principal (boundedRamifiedModulus K)) :=
  Ring.HasFiniteQuotients.finiteQuotient
    (ReflectionSourceProjectionOrthogonality.principal_ne_bot _ (boundedRamifiedModulus_ne_zero K))
local instance (K : ℕ) : Fintype (O ⧸ principal (boundedRamifiedModulus K)) := Fintype.ofFinite _

/-- The actual original zero term, cut off only at the stated ramified valuation. -/
def truncatedZeroTerm (K : ℕ) (χ : O → ℂ) (z : ℂ) (v : ℝ) (h : O) : ℂ :=
  if lambda ^ (K + 1) ∣ h then 0 else χ h * sourceCuspZTerm 0 z v h

def truncatedZeroFamily (K : ℕ) (χ : O → ℂ) (z : ℂ) (v : ℝ) : ℂ :=
  ∑' h : O, truncatedZeroTerm K χ z v h

def truncatedZeroTranslation (K : ℕ)
    (a : O ⧸ principal (boundedRamifiedModulus K)) : ℂ :=
  3 * embedding (residueLift (principal (boundedRamifiedModulus K)) a) /
    embedding (boundedRamifiedModulus K)

def truncatedZeroMultiplier (K : ℕ) (χ : O → ℂ) (z : ℂ)
    (a : O ⧸ principal (boundedRamifiedModulus K)) (h : O) : ℂ :=
  star (breve (ThetaRealizationProof.frequency h * truncatedZeroTranslation K a)) *
    χ h * breve (ThetaRealizationProof.frequency h * z)

/-- The coefficient-free zero kernel has the literal Z frequency and no
auxiliary scale-three factor. Its original zero-frequency guard remains. -/
theorem zeroCuspKernel_literal (z : ℂ) (v : ℝ) (hv : 0 < v) (h : O) :
    zeroCuspKernel z v h = if h = 0 then 0 else
      (((2 * Real.pi : ℝ) : ℂ) * Complex.I) * ThetaRealizationProof.frequency h *
        breve (ThetaRealizationProof.frequency h * z) *
        thetaMode (ThetaRealizationProof.frequency h) 0 v := by
  by_cases hh : h = 0
  · simp only [zeroCuspKernel, hh, ite_true]
  · have harg : 0 < 4 * Real.pi * ‖cuspFrequency h‖ * v :=
      mul_pos (mul_pos (mul_pos (by norm_num) Real.pi_pos)
        (norm_pos_iff.mpr (cuspFrequency_ne_zero h hh))) hv
    have hb0 : breve (0 : ℂ) = 1 := by simp [breve]
    rw [zeroCuspKernel, if_neg hh, if_neg hh]
    simp only [literal_frequency_eq_neg_native, thetaMode, norm_neg, mul_zero,
      hb0, mul_one, Complex.ofReal_mul]
    rw [literal_bessel_eq_native _ harg]
    simp only [← breve_eq_breveE]
    push_cast
    ring

theorem truncatedZeroTerm_coefficient (K : ℕ) (χ : O → ℂ)
    (z : ℂ) (v : ℝ) (hv : 0 < v) (h : O) :
    truncatedZeroTerm K χ z v h =
      χ h * star (if lambda ^ (K + 1) ∣ h then 0 else sourceResidualFourierCoefficient h) *
        zeroCuspKernel z v h := by
  by_cases hd : lambda ^ (K + 1) ∣ h
  · simp only [truncatedZeroTerm, if_pos hd, star_zero, mul_zero, zero_mul]
  · rw [truncatedZeroTerm, if_neg hd, if_neg hd, sourceCuspZTerm_zero_factor z v hv h]
    ring

theorem truncatedZeroMultiplier_polynomial_bound (K : ℕ) (χ : O → ℂ)
    (D : ℝ) (p : ℕ)
    (hχ : ∀ h : O, h ≠ 0 → ‖χ h‖ ≤ D * ‖embedding h‖ ^ p)
    (z : ℂ) (a : O ⧸ principal (boundedRamifiedModulus K)) (h : O) (hh : h ≠ 0) :
    ‖truncatedZeroMultiplier K χ z a h‖ ≤ D * ‖embedding h‖ ^ p := by
  simp only [truncatedZeroMultiplier, norm_mul, norm_star, breve_eq_breveE, breveE_norm,
    one_mul, mul_one]
  exact hχ h hh

/-- This inserts the proved bounded-valuation Fourier span into the actual
native term. The arithmetic coefficient and both additive phases are exact. -/
theorem truncatedZeroTerm_fourier (K : ℕ)
    (A : RamifiedNineGroup → (O ⧸ principal (boundedRamifiedModulus K)) → ℂ)
    (hA : ∀ h : O, (if lambda ^ (K + 1) ∣ h then 0 else sourceResidualFourierCoefficient h) =
      ∑ j : RamifiedNineGroup, ∑ a : O ⧸ principal (boundedRamifiedModulus K),
        A j a * breve (-cuspFrequency h * truncatedZeroTranslation K a) *
          tauLattice (ramifiedUpShift j * h))
    (χ : O → ℂ) (z : ℂ) (v : ℝ) (hv : 0 < v) (h : O) :
    truncatedZeroTerm K χ z v h =
      ∑ j : RamifiedNineGroup, ∑ a : O ⧸ principal (boundedRamifiedModulus K),
        star (A j a) * shiftedTauZTerm (ramifiedUpShift j)
          (truncatedZeroMultiplier K χ z a) v h := by
  by_cases hh : h = 0
  · subst h
    simp only [truncatedZeroTerm, dvd_zero, ite_true, shiftedTauZTerm, mul_zero,
      Finset.sum_const_zero]
  · rw [truncatedZeroTerm_coefficient K χ z v hv h, hA h, zeroCuspKernel_literal z v hv h,
      if_neg hh]
    simp only [star_sum, star_mul, shiftedTauZTerm, ite_eq_right hh,
      truncatedZeroMultiplier, literal_frequency_eq_neg_native,
      Finset.mul_sum, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro j hj
    apply Finset.sum_congr rfl
    intro a ha
    ring

theorem truncatedZero_shifted_series_summable (K : ℕ) (χ : O → ℂ)
    (D : ℝ) (p : ℕ) (hD : 0 ≤ D)
    (hχ : ∀ h : O, h ≠ 0 → ‖χ h‖ ≤ D * ‖embedding h‖ ^ p)
    (z : ℂ) (v : ℝ) (hv : 0 < v) (j : RamifiedNineGroup)
    (a : O ⧸ principal (boundedRamifiedModulus K)) :
    Summable (shiftedTauZTerm (ramifiedUpShift j) (truncatedZeroMultiplier K χ z a) v) :=
  (shiftedTauZSeries_reindex (ramifiedUpShift j) (ramifiedUpShift_ne_zero j)
    (truncatedZeroMultiplier K χ z a) D p hD
    (truncatedZeroMultiplier_polynomial_bound K χ D p hχ z a) v hv).1

/-- Absolute convergence of every true shifted series justifies both finite
Fourier exchanges. Each resulting profile is the original literal zero cusp,
with its integral lambda*c_j decimation and exact complex derivative factor. -/
theorem truncatedZeroFamily_fourier_profiles (K : ℕ)
    (A : RamifiedNineGroup → (O ⧸ principal (boundedRamifiedModulus K)) → ℂ)
    (hA : ∀ h : O, (if lambda ^ (K + 1) ∣ h then 0 else sourceResidualFourierCoefficient h) =
      ∑ j : RamifiedNineGroup, ∑ a : O ⧸ principal (boundedRamifiedModulus K),
        A j a * breve (-cuspFrequency h * truncatedZeroTranslation K a) *
          tauLattice (ramifiedUpShift j * h))
    (χ : O → ℂ) (D : ℝ) (p : ℕ) (hD : 0 ≤ D)
    (hχ : ∀ h : O, h ≠ 0 → ‖χ h‖ ≤ D * ‖embedding h‖ ^ p)
    (z : ℂ) (v : ℝ) (hv : 0 < v) :
    Summable (truncatedZeroTerm K χ z v) ∧
      truncatedZeroFamily K χ z v =
        ∑ j : RamifiedNineGroup, ∑ a : O ⧸ principal (boundedRamifiedModulus K),
          star (A j a) * (((‖embedding (ramifiedUpShift j)‖ : ℂ) / embedding (ramifiedUpShift j)) *
            cuspZProfile .zero
              (liftProjectedMultiplier (dualCoefficientShift (ramifiedUpShift j))
                (truncatedZeroMultiplier K χ z a))
              (v / ‖embedding (ramifiedUpShift j)‖)) := by
  have hs (j : RamifiedNineGroup) (a : O ⧸ principal (boundedRamifiedModulus K)) :
      Summable (fun h : O => star (A j a) * shiftedTauZTerm (ramifiedUpShift j)
        (truncatedZeroMultiplier K χ z a) v h) :=
    (truncatedZero_shifted_series_summable K χ D p hD hχ z v hv j a).mul_left _
  have hsJ (j : RamifiedNineGroup) : Summable (fun h : O =>
      ∑ a : O ⧸ principal (boundedRamifiedModulus K), star (A j a) *
        shiftedTauZTerm (ramifiedUpShift j) (truncatedZeroMultiplier K χ z a) v h) :=
    summable_sum (s := Finset.univ) (fun a _ => hs j a)
  refine ⟨?_, ?_⟩
  · apply (summable_sum (s := Finset.univ) (fun j _ => hsJ j)).congr
    intro h
    exact (truncatedZeroTerm_fourier K A hA χ z v hv h).symm
  · unfold truncatedZeroFamily
    simp_rw [truncatedZeroTerm_fourier K A hA χ z v hv]
    rw [Summable.tsum_finsetSum (fun j _ => hsJ j)]
    apply Finset.sum_congr rfl
    intro j hj
    rw [Summable.tsum_finsetSum (fun a _ => hs j a)]
    apply Finset.sum_congr rfl
    intro a ha
    rw [tsum_mul_left]
    rw [shiftedTauZSeries_eq_cuspZProfile (ramifiedUpShift j) (ramifiedUpShift_ne_zero j)
      (truncatedZeroMultiplier K χ z a) D p hD
      (truncatedZeroMultiplier_polynomial_bound K χ D p hχ z a) v hv]

/-- For each original bounded ramified valuation the actual native source
profile has a fixed finite literal profile expression. Its coefficients and
norm bound are chosen before every polynomial multiplier and height. -/
theorem zero_bounded_valuation_original_profiles (K : ℕ) :
    ∃ A : RamifiedNineGroup → (O ⧸ principal (boundedRamifiedModulus K)) → ℂ,
      ∃ B : ℝ, 0 ≤ B ∧ (∀ j a, ‖A j a‖ ≤ B) ∧
      ∀ (χ : O → ℂ) (D : ℝ) (p : ℕ), 0 ≤ D →
        (∀ h : O, h ≠ 0 → ‖χ h‖ ≤ D * ‖embedding h‖ ^ p) →
        ∀ (z : ℂ) (v : ℝ), 0 < v →
        Summable (truncatedZeroTerm K χ z v) ∧
          truncatedZeroFamily K χ z v =
            ∑ j : RamifiedNineGroup, ∑ a : O ⧸ principal (boundedRamifiedModulus K),
              star (A j a) * (((‖embedding (ramifiedUpShift j)‖ : ℂ) / embedding (ramifiedUpShift j)) *
                cuspZProfile .zero
                  (liftProjectedMultiplier (dualCoefficientShift (ramifiedUpShift j))
                    (truncatedZeroMultiplier K χ z a))
                  (v / ‖embedding (ramifiedUpShift j)‖)) := by
  obtain ⟨A, B, hB, hbound, hA⟩ := source_bounded_valuation_fourier K
  refine ⟨A, B, hB, hbound, ?_⟩
  intro χ D p hD hχ z v hv
  exact truncatedZeroFamily_fourier_profiles K A hA χ D p hD hχ z v hv

end QRHShort.CloudBatch.ReflectionZeroTruncatedProfile
