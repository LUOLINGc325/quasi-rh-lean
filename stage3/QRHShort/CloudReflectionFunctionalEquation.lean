local notation "O" => OAI.ActualEisensteinCubic.O
local notation "lam" => OAI.ActualEisensteinCubic.lambda

theorem high_original_constant (M : SL(2,O)) (a₀ : O)
    (ha : M 0 0 = 3 * a₀) (hc : lam ^ 2 ∣ M 1 0 - 1) :
    sourceCuspConstant M = eisEmbedding (symbol (M 0 0) (M 1 0)) *
      sourcePrincipalCuspConstant := by
  apply sourceCuspConstant_of_bottom_primary_integer M hc
  exact ⟨0, by simpa using (show (3 : O) ∣ M 0 0 from ⟨a₀, ha⟩)⟩

theorem high_weighted_constant {M : SL(2,O)} {q a₀ : O}
    (d : RamifiedCubeCuspData M lam q) (ha : M 0 0 = 3 * a₀)
    (hc : lam ^ 2 ∣ M 1 0 - 1) :
    sourceCuspConstant d.matrix * cubeCuspHeightWeight lam d.exponent =
      if HighIntegerClass a₀ (M 1 0) q then 3 * sourceCuspConstant M else 0 := by
  by_cases hi : HighIntegerClass a₀ (M 1 0) q
  · have hj := cubeData_three_of_integer_class d ha hi
    have he : d.exponent = (3 : Fin 4) := Fin.ext hj
    have hbottom : d.matrix 1 0 = M 1 0 := by
      rw [cubeData_lower d PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero, hj]
      norm_num
    have hnew : lam ^ 2 ∣ d.matrix 1 0 - 1 := by rwa [hbottom]
    have hint : IntegerModThree (d.matrix 0 0) := (cubeData_three_integer_iff d ha hj).mpr hi
    rw [if_pos hi, sourceCuspConstant_of_bottom_primary_integer d.matrix hnew hint,
      hbottom, cubeData_three_symbol d hc hj, he, cubeCuspHeightWeight_three,
      absNorm_span_lambda, high_original_constant M a₀ ha hc]
    push_cast
    ring
  · rw [if_neg hi]
    have hge := cubeData_exponent_ge_two d ⟨a₀, ha⟩
    have hcases : d.exponent.val = 2 ∨ d.exponent.val = 3 := by
      have := d.exponent.isLt
      omega
    have hzero : sourceCuspConstant d.matrix = 0 := by
      rcases hcases with hj | hj
      · have hbottom : d.matrix 1 0 = lam * M 1 0 := by
          rw [cubeData_lower d PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero, hj]
          norm_num
        apply sourceCuspConstant_zero_of_once
        · rw [hbottom]
          exact dvd_mul_right lam _
        · rw [hbottom]
          exact lambda_primary_not_three _ hc
      · have hbottom : d.matrix 1 0 = M 1 0 := by
          rw [cubeData_lower d PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero, hj]
          norm_num
        apply sourceCuspConstant_zero_of_bottom_primary_noninteger
        · rwa [hbottom]
        · exact fun h => hi ((cubeData_three_integer_iff d ha hj).mp h)
    rw [hzero, zero_mul]

def highCubeData (M : SL(2,O)) (q : O) : RamifiedCubeCuspData M lam q :=
  Classical.choice (nonempty_ramifiedCubeCuspData M lam q PrimaryIdealUnitReindex.lambda_prime_actual)

theorem high_cube_summand_average (M : SL(2,O)) (q a₀ : O)
    (ha : M 0 0 = 3 * a₀) (hc : lam ^ 2 ∣ M 1 0 - 1)
    (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain, cubicSourceResidualFunction
      (cubeAverageMatrix lam PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero q •
        (integralComplexMatrix M • upperPoint (3 * (eisEmbedding (lam ^ 3) * z)) v hv))) =
      (if HighIntegerClass a₀ (M 1 0) q then 3 * sourceCuspConstant M else 0) *
        (v : ℂ) ^ (2/3 : ℂ) := by
  rw [ramifiedCubeSource_summand_average (highCubeData M q)]
