        (9 * embedding (omega ^ a * lam ^ n)) = embedding ((ramifiedTopUnit η a : O) * m) := by
  simpa only [Nat.add_zero, ramifiedTopElement, pow_zero, mul_one] using
    ramified_top_source_point η a n 0 m

