  ∑ a : O ⧸ principal (27 : O),
    ‖ramifiedCuspTauWeight C side i j (residueLift (principal (27 : O)) a)‖

theorem ramifiedProfileWeightBound_nonneg (C : RamifiedNineGroup → ℂ) (side : Bool)
    (i : RamifiedSixBranch) (j : RamifiedNineGroup) :
    0 ≤ ramifiedProfileWeightBound C side i j := by
  exact Finset.sum_nonneg (fun _ _ => norm_nonneg _)

theorem ramifiedCuspTauWeight_norm_bound (C : RamifiedNineGroup → ℂ) (side : Bool)
    (i : RamifiedSixBranch) (j : RamifiedNineGroup) (h : O) :
    ‖ramifiedCuspTauWeight C side i j h‖ ≤ ramifiedProfileWeightBound C side i j := by
  have he : ramifiedCuspTauWeight C side i j h =
      ramifiedCuspTauWeight C side i j (residueLift (principal (27 : O))
        (Ideal.Quotient.mk (principal (27 : O)) h)) := by
    apply ramifiedCuspTauWeight_eq_of_dvd_sub
    apply Ideal.mem_span_singleton.mp
    apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
    exact (ReflectionFE.residueLift_spec _ _).symm
  rw [he]
  unfold ramifiedProfileWeightBound
  exact Finset.single_le_sum
    (fun a _ => norm_nonneg (ramifiedCuspTauWeight C side i j (residueLift (principal (27 : O)) a)))
    (Finset.mem_univ (Ideal.Quotient.mk (principal (27 : O)) h))

