          (upperPoint ((1 / embedding q) * z + (projectedNativeCusp q hq B hB res).point)
            (v / ‖embedding q‖)
            (div_pos hv (norm_pos_iff.mpr (embedding_eq_zero.not.mpr hq)))))) := by
    funext z
    exact liftedConjugateResidual_eq_finite_native_source q hq B hB ψ z v hv
  rw [hf, wirtingerBar_const_mul, finite_weighted_native_cusp_rows]

theorem positive_projection_jacobian (q κ : ℂ) (hq : q ≠ 0)
    (v : ℝ) (hv : 0 < v) :
    star (1 / q) * (κ / ((v / ‖q‖ : ℝ) : ℂ) ^ 2) =
      q * κ / (v : ℂ) ^ 2 := by
  have hnorm : (‖q‖ : ℂ) ^ 2 = q * star q := by
    simpa only [Complex.star_def] using (Complex.mul_conj' q).symm
  have hs : star q ≠ 0 := star_ne_zero.mpr hq
  have hvC : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hv)
  simp only [star_div₀, star_one, Complex.ofReal_div, div_pow, hnorm]
  field_simp [hq, hs, hvC]

theorem projectedNativeCusp_scale_pos (q : O) (hq : q ≠ 0) (B : O) (hB : B ≠ 0)
    (res : O ⧸ principal (q * B)) :
    0 < (projectedNativeCusp q hq B hB res).heightScale / ‖embedding q‖ :=
  div_pos (projectedNativeCusp q hq B hB res).heightScale_pos
    (norm_pos_iff.mpr (embedding_eq_zero.not.mpr hq))

/-- The physical Jacobian has the positive horizontal scale z/q; the sign
and native cubic character remain in the actual datum multiplier. -/
theorem liftedConjugateResidual_native_cusp_rows_physical
    (q : O) (hq : q ≠ 0) (B : O) (hB : B ≠ 0)
    (ψ : O ⧸ principal B → ℂ) (v : ℝ) (hv : 0 < v) :
    letI : Finite (O ⧸ principal (q * B)) :=
      Ring.HasFiniteQuotients.finiteQuotient (principal_ne_bot _ (mul_ne_zero hq hB))
    letI : Fintype (O ⧸ principal (q * B)) := Fintype.ofFinite _
    wirtingerBar (fun z => liftedConjugateResidual q hq B hB ψ z v hv) 0 =
      (‖embedding q‖ : ℂ) * ∑ res : O ⧸ principal (q * B),
        projectedNativeWeight q hq B hB ψ res *
          (embedding q * (projectedNativeCusp q hq B hB res).multiplier / (v : ℂ) ^ 2 *
            sourceCuspZFamily (projectedNativeCusp q hq B hB res).index
              (projectedNativeCusp q hq B hB res).dualPoint
              ((((projectedNativeCusp q hq B hB res).heightScale / ‖embedding q‖) * v)⁻¹)) := by
  letI : Finite (O ⧸ principal (q * B)) :=
    Ring.HasFiniteQuotients.finiteQuotient (principal_ne_bot _ (mul_ne_zero hq hB))
  letI : Fintype (O ⧸ principal (q * B)) := Fintype.ofFinite _
  rw [liftedConjugateResidual_native_cusp_rows]
  congr 1
  apply Finset.sum_congr rfl
  intro res hres
  congr 1
  have hheight : (projectedNativeCusp q hq B hB res).heightScale * (v / ‖embedding q‖) =
      ((projectedNativeCusp q hq B hB res).heightScale / ‖embedding q‖) * v := by ring
  rw [hheight, ← mul_assoc, positive_projection_jacobian _ _
    (embedding_eq_zero.not.mpr hq) v hv]

end QRHShort.CloudBatch.ReflectionSourceNativeCuspRows
end
