  have hbase : (d.base : Matrix (Fin 2) (Fin 2) O) =
      !![u * d.representative.val.1, d.base 0 1;
        (u * c₀) * d.representative.val.2, d.base 1 1] := by
    apply Matrix.ext
    intro k l
    fin_cases k <;> fin_cases l
    · exact d.first
    · rfl
    · change d.base 1 0 = (u * c₀) * d.representative.val.2
      simpa only [u, mul_assoc] using d.lower
    · rfl
  have hmat : (g : Matrix (Fin 2) (Fin 2) O).map (Ideal.Quotient.mk (principal M)) =
      (d.base : Matrix (Fin 2) (Fin 2) O).map (Ideal.Quotient.mk (principal M)) := by
    rw [hbase]
    exact hcong
  let Γ : LevelThree := ⟨g * d.base⁻¹,
    relative_mem_levelThree_of_matrix_congr M h₃ g d.base hmat⟩
  refine ⟨i, g, Γ * d.level, rfl, ?_, ha, hrr, he, ?_⟩
  · change (u * c₀) * r = u * (c₀ * r)
    ring
  · change g = ((g * d.base⁻¹) * (d.level : SL(2, O))) *
      rationalMatrix d.rational * manuscriptCuspMatrix d.cusp
    have hf := d.factor
    rw [mul_assoc] at hf
    rw [mul_assoc, mul_assoc, ← hf]
    simp

/-- The preceding finite pool now acts on the actual residual function, with
literal cubic-symbol multipliers and no assumed automorphy premise. -/
theorem exists_residual_three_cusp_pool (M c₀ : O) (hM : M ≠ 0) (hc₀ : c₀ ≠ 0)
    (h₃ : (3 : O) ∣ M) :
    ∃ N : ℕ, ∃ pool : Fin N → CuspPoolDatum M c₀,
      ∀ a r : O, IsCoprime r (M * c₀) → IsCoprime a (c₀ * r) →
        ∃ i : Fin N, ∃ g : SL(2, O), ∃ G : LevelThree,
          g 0 0 = ((pool i).unit : O) * a ∧
          g 1 0 = ((pool i).unit : O) * (c₀ * r) ∧
          M * (((pool i).unit : O) * c₀) ∣ g 1 1 - (pool i).base 1 1 ∧
