    (fun i => outside_lambda_not_mem c (hP i) (hout i)) (fun i => (j i).val) v hv
  refine ⟨hn, ?_, ?_⟩
  · apply (hnative.1.mul_left (controlledActiveScalar c D hp hP hout j)⁻¹).congr
    intro h
    rw [controlled_multiplier_literal c D hN hr hbase hp hc₀ hP hout hcop j (lambda * h)]
    calc
      _ = ((controlledActiveScalar c D hp hP hout j)⁻¹ *
          controlledActiveScalar c D hp hP hout j) *
          ((fixedResiduePhase c₀ hc₀
            (Ideal.Quotient.mk _ (-(D.matrix (fun _ => 1) 1 1) * D.U)) (lambda * h) *
            ∏ i, thetaLocalFactor (Ideal.span {p i}) (j i) (lambda * h)) *
            sourceCuspZTerm 0 0 v h) := by ring
      _ = _ := by rw [inv_mul_cancel₀ hγ, one_mul]
  · rw [hnative.2, ← tsum_mul_left]
    apply tsum_congr
    intro h
    rw [controlled_multiplier_literal c D hN hr hbase hp hc₀ hP hout hcop j (lambda * h)]
    ring

end
