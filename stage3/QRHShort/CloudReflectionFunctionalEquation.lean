private theorem primary_part_eq_of_ramified_eq (u v m n : O) (hu : IsUnit u) (hv : IsUnit v)
    (hm : IsPrimary m) (hn : IsPrimary n) (r s : ℕ)
    (he : u * lambda ^ r * m = v * lambda ^ s * n) : m = n := by
  have hco (a x : O) (ha : IsUnit a) (hx : IsPrimary x) : ¬lambda ∣ a * x := by
    intro hd
    rcases lambda_prime.dvd_or_dvd hd with hd | hd
    · exact lambda_prime.not_isUnit (isUnit_of_dvd_unit hd ha)
    · exact lambda_not_dvd_primary x hx hd
  have he' : lambda ^ r * (u * m) = lambda ^ s * (v * n) := by linear_combination he
  have hrs := prime_power_cofactor_unique lambda_prime (hco u m hu hm) (hco v n hv hn) he'
  subst s
  have hmul := mul_left_cancel₀ (pow_ne_zero r lambda_prime.ne_zero) he'
  apply primary_eq_of_principal_eq m n hm hn
  have hi := congrArg principal hmul
  simpa only [principal, Ideal.span_singleton_mul_left_unit hu,
    Ideal.span_singleton_mul_left_unit hv] using hi

/-- No additional ordinary support can be created by a ramified integral shift
of the literal tau coefficient. -/
theorem tauLattice_unit_primary_support (u : Oˣ) (r : ℕ) (m : O) (hm : IsPrimary m)
    (ht : tauLattice ((u : O) * lambda ^ r * m) ≠ 0) :
    ∃ n b : O, PrimaryCubeData n b ∧ m = n * b ^ 3 := by
