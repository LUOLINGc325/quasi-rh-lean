noncomputable section
open Classical
open scoped MatrixGroups

namespace QRHShort.CloudBatch.ReflectionCuspThreeForms
open ReflectionFE ReflectionCusp ReflectionCuspNormalForms

def manuscriptCuspParameter : Fin 3 → O := ![0, omega, omega ^ (2 : ℕ)]

def manuscriptCuspMatrix (j : Fin 3) : SL(2, O) :=
  lowerCuspMatrix (manuscriptCuspParameter j)

def integerLower (n : ℤ) : SL(2, ℤ) := ⟨!![1, 0; n, 1], by simp [Matrix.det_fin_two]⟩

def integerInversion : SL(2, ℤ) := ⟨!![0, -1; 1, 0], by simp [Matrix.det_fin_two]⟩

def rationalMatrix : SL(2, ℤ) →* SL(2, O) := Matrix.SpecialLinearGroup.map (Int.castRingHom O)

theorem rationalMatrix_integerLower (n : ℤ) :
    rationalMatrix (integerLower n) = lowerCuspMatrix (n : O) := by
  apply Subtype.ext
  apply Matrix.ext
  intro i j
  change Int.castRingHom O ((integerLower n : Matrix (Fin 2) (Fin 2) ℤ) i j) =
    (lowerCuspMatrix (n : O) : Matrix (Fin 2) (Fin 2) O) i j
  fin_cases i <;> fin_cases j <;>
    simp [integerLower, lowerCuspMatrix]

theorem rationalMatrix_integerInversion :
    rationalMatrix integerInversion = weylCuspMatrix 0 := by
  apply Subtype.ext
  apply Matrix.ext
  intro i j
  change Int.castRingHom O ((integerInversion : Matrix (Fin 2) (Fin 2) ℤ) i j) =
    (weylCuspMatrix 0 : Matrix (Fin 2) (Fin 2) O) i j
  fin_cases i <;> fin_cases j <;>
    simp [integerInversion, weylCuspMatrix]

/-- The quotient by integer and level-three translations has exactly the
three representatives used by the manuscript's cusp matrices. -/
theorem exists_manuscript_translation_class (x : O) :
    ∃ n : ℤ, ∃ b : O, ∃ j : Fin 3,
      x = (n : O) + 3 * b + manuscriptCuspParameter j := by
  have hg : OAI.EisensteinEmbedding.pb.gen = omega := by
    simp [OAI.EisensteinEmbedding.pb, QRHShort.omega]
  obtain ⟨a, t, ht⟩ := OAI.EisensteinEmbedding.exists_ab x
  rw [hg] at ht
  have hmod : t % 3 = 0 ∨ t % 3 = 1 ∨ t % 3 = 2 := by omega
  rcases hmod with h0 | h1 | h2
  · have he : (t : O) = 3 * ((t / 3 : ℤ) : O) := by
      exact_mod_cast (show t = 3 * (t / 3) by omega)
    refine ⟨a, ((t / 3 : ℤ) : O) * omega, 0, ?_⟩
    change x = (a : O) + 3 * (((t / 3 : ℤ) : O) * omega) + 0
    rw [ht, he]
    ring
  · have he : (t : O) = 3 * ((t / 3 : ℤ) : O) + 1 := by
      exact_mod_cast (show t = 3 * (t / 3) + 1 by omega)
    refine ⟨a, ((t / 3 : ℤ) : O) * omega, 1, ?_⟩
    change x = (a : O) + 3 * (((t / 3 : ℤ) : O) * omega) + omega
    rw [ht, he]
    ring
  · have he : (t : O) = 3 * ((t / 3 : ℤ) : O) + 2 := by
      exact_mod_cast (show t = 3 * (t / 3) + 2 by omega)
    refine ⟨a + 1, (((t / 3 : ℤ) : O) + 1) * omega, 2, ?_⟩
    change x = ((a + 1 : ℤ) : O) +
      3 * ((((t / 3 : ℤ) : O) + 1) * omega) + omega ^ (2 : ℕ)
    rw [ht, he]
    push_cast
    linear_combination -omega_sq_add_omega_add_one

theorem lowerCuspMatrix_mul (a b : O) :
    lowerCuspMatrix a * lowerCuspMatrix b = lowerCuspMatrix (a + b) := by
  apply Subtype.ext
  change (!![1, 0; a, 1] : Matrix (Fin 2) (Fin 2) O) * !![1, 0; b, 1] =
    !![1, 0; a + b, 1]
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two]

def lowerLevel (b : O) : LevelThree := ⟨lowerCuspMatrix (3 * b), by
  rw [mem_levelThree_iff_entries]
  intro i j
  fin_cases i <;> fin_cases j <;> simp [lowerCuspMatrix]⟩

theorem lowerLevel_multiplier (b : O) : kubotaMultiplier (lowerLevel b) = 1 := by
  change cubicSymbol (principal 1) (3 * b) = 1
  have hI : principal (1 : O) = (1 : Ideal O) := by simp [principal]
  rw [hI]
  have hfac : UniqueFactorizationMonoid.normalizedFactors (⊤ : Ideal O) = 0 := by
    simpa only [Ideal.one_eq_top] using
      (UniqueFactorizationMonoid.normalizedFactors_one (α := Ideal O))
  simp [cubicSymbol, hfac]

theorem lower_to_manuscript_cusp (x : O) :
    ∃ G : LevelThree, ∃ r : SL(2, ℤ), ∃ j : Fin 3,
      kubotaMultiplier G = 1 ∧
        lowerCuspMatrix x = (G : SL(2, O)) * rationalMatrix r * manuscriptCuspMatrix j := by
  obtain ⟨n, b, j, he⟩ := exists_manuscript_translation_class x
  refine ⟨lowerLevel b, integerLower n, j, lowerLevel_multiplier b, ?_⟩
  rw [rationalMatrix_integerLower]
  change lowerCuspMatrix x = lowerCuspMatrix (3 * b) * lowerCuspMatrix (n : O) *
    lowerCuspMatrix (manuscriptCuspParameter j)
  rw [lowerCuspMatrix_mul, lowerCuspMatrix_mul]
  congr 1
  linear_combination he

theorem weyl_to_manuscript_cusp (x : O) :
    ∃ G : LevelThree, ∃ r : SL(2, ℤ), ∃ j : Fin 3,
      kubotaMultiplier G = 1 ∧
        weylCuspMatrix x = (G : SL(2, O)) * rationalMatrix r * manuscriptCuspMatrix j := by
  obtain ⟨n, b, j, he⟩ := exists_manuscript_translation_class (-x)
  refine ⟨upperTranslationLevel (-b), integerInversion * integerLower n, j,
    upperTranslation_multiplier (-b), ?_⟩
  rw [map_mul, rationalMatrix_integerLower, rationalMatrix_integerInversion]
  apply Subtype.ext
  change (!![x, -1; 1, 0] : Matrix (Fin 2) (Fin 2) O) =
    !![1, 3 * (-b); 0, 1] * (!![0, -1; 1, 0] * !![1, 0; (n : O), 1]) *
      !![1, 0; manuscriptCuspParameter j, 1]
  apply Matrix.ext
  intro i k
  fin_cases i <;> fin_cases k <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two]
  linear_combination -he

theorem finite_to_manuscript_cusp (i : CuspIndex) :
    ∃ G : LevelThree, ∃ r : SL(2, ℤ), ∃ j : Fin 3,
      kubotaMultiplier G = 1 ∧
        finiteCuspMatrix i = (G : SL(2, O)) * rationalMatrix r * manuscriptCuspMatrix j := by
  cases i with
  | inl i => exact lower_to_manuscript_cusp _
  | inr q => exact weyl_to_manuscript_cusp _

/-- Actual first-column completion with precisely the three original cusp
representatives. The rational matrix is on the left of the representative,
so the residual function's rational invariance applies in the needed order. -/
theorem primitive_cusp_three_representatives (a c : O) (hcop : IsCoprime a c) :
    ∃ u : Oˣ, ∃ g : SL(2, O), ∃ G : LevelThree, ∃ r : SL(2, ℤ), ∃ j : Fin 3,
