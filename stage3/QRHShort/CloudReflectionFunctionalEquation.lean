theorem sourceCuspConstant_of_primary_integer
    (M : SL(2,Eis)) (ha : lam ^ 2 ∣ M 0 0 - 1)
    (hc : IntegerModThree (M 1 0)) :
    sourceCuspConstant M = eisEmbedding (symbol (M 1 0) (M 0 0)) *
      sourcePrincipalCuspConstant := by
  obtain ⟨r, hr⟩ := hc
  let B : SL(2,Eis) := rationalEmbedding (integerLower r)
  have hB0 : B 0 0 = 1 := by rfl
  have hB1 : B 1 0 = (r : Eis) := by rfl
  have hcop : IsCoprime (M 0 0) (M 1 0) := by
    refine ⟨M 1 1, -M 0 1, ?_⟩
    have hd := M.property
    rw [Matrix.det_fin_two] at hd
    linear_combination hd
  obtain ⟨N, hN0, hN1, hNB⟩ := exists_congruent_cusp_completion B (M 0 0) (M 1 0)
    hcop (by rw [hB0]; exact three_dvd_primary_sub_one _ ha) (by rw [hB1]; exact hr)
  let G : levelTwo := ⟨N, ⟨⟨N * B⁻¹, hNB⟩, integerLower r, by dsimp [B]; group⟩⟩
  let T : SL(2,Eis) := N⁻¹ * M
  have hT : T 1 0 = 0 := same_column_quotient_lower_zero M N hN0 hN1
  have he : (G : SL(2,Eis)) * T = M := by dsimp [G, T]; group
  have hN : sourceCuspConstant N = levelTwoComplexCharacter G * sourcePrincipalCuspConstant := by
    have hh := sourceCuspConstant_left G (1 : SL(2,Eis))
    simpa only [mul_one, sourceCuspConstant_one] using hh
  have hNG : lam ^ 2 ∣ (G : SL(2,Eis)) 0 0 - 1 := by
    change lam ^ 2 ∣ N 0 0 - 1
    rw [hN0]
    exact ha
