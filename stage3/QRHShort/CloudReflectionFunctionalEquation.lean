    dsimp only [fourthWeight]
    push_cast
    field_simp [hs, hz]
    ring
  · rw [h2]
    dsimp only [fourthWeight]
    push_cast
    norm_num only [zpow_neg, zpow_natCast, zpow_one]
    field_simp [hs, hz]
    ring

