    (hP : PrimeTwistSet c.S P) (hA : A ⊆ P) (v : ℝ) (hv : 0 < v) :
    Summable (truncatedZeroTerm K (fun h => ψ (Ideal.Quotient.mk (principal B) h) *
      ∏ p ∈ A, thetaLocalFactor p (j p) (lambda * h)) 0
      ((effectiveScale (embedding ((u₀ : O) * lambda ^ n))
        (embedding (c₀ * ∏ p ∈ A, primaryGenerator p)) * v)⁻¹)) ∧
    truncatedZeroFamily K (fun h => ψ (Ideal.Quotient.mk (principal B) h) *
      ∏ p ∈ A, thetaLocalFactor p (j p) (lambda * h)) 0
