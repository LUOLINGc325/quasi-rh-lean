    OAI.CompletedGauss.primaryGenerator_span m hm0 (primary_compat hm)
  have hT0 : OAI.CompletedGauss.primaryGenerator T ≠ 0 := by rwa [hT]
  have hFT : ramifiedDifferenceCoefficient
