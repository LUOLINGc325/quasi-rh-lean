open Classical
open scoped BigOperators

namespace QRHShort.CloudBatch.ReflectionSourceCoefficients
open ArithmeticProof SquarefreeReflection
open SquarefreeReflection.RayValuePrerequisites
open ThetaRealizationProof ReflectionFE

def sourceMultiplier (c : ArithmeticContext) (ξ : RayCharacter c)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (m : O) : ℂ :=
  if IsPrimary m ∧ Outside c.S (principal m) then
    sexticSymbol (principal m) lambda ^ (2 : ℕ) *
      productTwist c ξ P j (principal m)
  else 0

theorem prime_outside (c : ArithmeticContext) {p : Ideal O}
    (hp : Prime p) (hnot : p ∉ c.S) : Outside c.S p := by
  refine ⟨hp.ne_zero, ?_⟩
  intro q hq hqp
  have heq : q = p := associated_iff_eq.mp
    ((c.prime_S q hq).associated_of_dvd hp hqp)
  exact hnot (heq ▸ hq)

theorem finite_mulChar_norm_le_one {R : Type*} [CommRing R] [Finite R]
    (χ : MulChar R ℂ) (x : R) : ‖χ x‖ ≤ 1 := by
  letI : Fintype R := Fintype.ofFinite R
  by_cases hx : IsUnit x
  · obtain ⟨u, rfl⟩ := hx
    have hnorm := Complex.norm_eq_one_of_mem_rootsOfUnity
      (χ.apply_mem_rootsOfUnity u)
    simpa only [MulChar.coe_equivToUnitHom] using hnorm.le
  · rw [χ.map_nonunit hx, norm_zero]
    exact zero_le_one

theorem localCharacterPower_mul (c : ArithmeticContext) {p : Ideal O}
    (hp : Prime p) (hout : Outside c.S p) (j : Fin 6) (x y : O) :
    localCharacterPower p ((j.val : ℕ) : ℤ) (x * y) =
      localCharacterPower p ((j.val : ℕ) : ℤ) x *
        localCharacterPower p ((j.val : ℕ) : ℤ) y := by
  letI : p.IsMaximal := (Ideal.isPrime_of_prime hp).isMaximal hp.ne_zero
  have hg := outside_lambda_not_mem c hp hout
  rw [localCharacterPower_nat_eq c hp hout hg,
    localCharacterPower_nat_eq c hp hout hg,
    localCharacterPower_nat_eq c hp hout hg, map_mul, map_mul]

theorem localCharacterPower_norm_le_one (c : ArithmeticContext) {p : Ideal O}
    (hp : Prime p) (hout : Outside c.S p) (j : Fin 6) (x : O) :
    ‖localCharacterPower p ((j.val : ℕ) : ℤ) x‖ ≤ 1 := by
  letI : p.IsMaximal := (Ideal.isPrime_of_prime hp).isMaximal hp.ne_zero
  letI : Finite (O ⧸ p) := Ring.HasFiniteQuotients.finiteQuotient hp.ne_zero
  have hg := outside_lambda_not_mem c hp hout
  rw [localCharacterPower_nat_eq c hp hout hg]
  exact finite_mulChar_norm_le_one _ _

theorem productTwist_mul (c : ArithmeticContext) (ξ : RayCharacter c)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    {a b : Ideal O} (ha : Outside c.S a) (hb : Outside c.S b) :
    productTwist c ξ P j (a * b) =
      productTwist c ξ P j a * productTwist c ξ P j b := by
  simp only [productTwist, if_pos ha, if_pos hb, if_pos (outside_mul c ha hb),
    rayValue_mul c ξ.val ha hb, primaryGenerator_mul c ha hb]
  have hprod : (∏ p ∈ P, localCharacterPower p ((j p).val : ℤ)
