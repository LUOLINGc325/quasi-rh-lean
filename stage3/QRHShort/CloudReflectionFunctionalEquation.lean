  have ht : 0 < t := inv_pos.mpr (mul_pos (effectiveScale_pos _ _
    (embedding_eq_zero.not.mpr (mul_ne_zero u₀.ne_zero (pow_ne_zero _ lambda_prime.ne_zero)))
