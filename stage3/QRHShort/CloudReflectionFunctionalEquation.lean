    simp only [zero_mul, zeroCuspKernel, ite_true, mul_zero]
  have hhk : h * k ≠ 0 := mul_ne_zero hh hk
  have hf : cuspFrequency (h * k) = embedding k * cuspFrequency h := by
    rw [mul_comm h k, native_frequency_mul]
