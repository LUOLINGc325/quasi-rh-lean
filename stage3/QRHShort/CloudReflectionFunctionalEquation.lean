theorem localCharacterPower_neg_mul (c : ArithmeticContext) {p : Ideal O}
    (hp : Prime p) (hout : Outside c.S p) (k : ℕ) (x y : O) :
    localCharacterPower p (-(k : ℤ)) (x * y) =
      localCharacterPower p (-(k : ℤ)) x * localCharacterPower p (-(k : ℤ)) y := by
  letI : p.IsMaximal := (Ideal.isPrime_of_prime hp).isMaximal hp.ne_zero
  simp only [localCharacterPower_neg_nat_eq c hp hout (outside_lambda_not_mem c hp hout),
    map_mul]

theorem localCharacterPower_neg_fixed_norm (c : ArithmeticContext) {p : Ideal O}
    (hp : Prime p) (hout : Outside c.S p) (q : O) (hq : q ∉ p) (k : ℕ) :
    ‖localCharacterPower p (-(k : ℤ)) q‖ = 1 := by
  letI : p.IsMaximal := (Ideal.isPrime_of_prime hp).isMaximal hp.ne_zero
  letI : Field (O ⧸ p) := Ideal.Quotient.field p
  have hu : IsUnit (Ideal.Quotient.mk p q) :=
    isUnit_iff_ne_zero.mpr (Ideal.Quotient.eq_zero_iff_mem.not.mpr hq)
  obtain ⟨u, hu⟩ := hu
  rw [localCharacterPower_neg_nat_eq c hp hout (outside_lambda_not_mem c hp hout), ← hu]
  exact OAI.FiniteRayExpansion.norm_char_unit _ u

theorem localCharacterPower_neg_six_of_not_mem (c : ArithmeticContext) {p : Ideal O}
    (hp : Prime p) (hout : Outside c.S p) (q : O) (hq : q ∉ p) :
    localCharacterPower p (-6) q = 1 := by
  letI : p.IsMaximal := (Ideal.isPrime_of_prime hp).isMaximal hp.ne_zero
  letI : Field (O ⧸ p) := Ideal.Quotient.field p
  have hu : IsUnit (Ideal.Quotient.mk p q) :=
    isUnit_iff_ne_zero.mpr (Ideal.Quotient.eq_zero_iff_mem.not.mpr hq)
  rw [show (-6 : ℤ) = -((6 : ℕ) : ℤ) by norm_num,
    localCharacterPower_neg_nat_eq c hp hout (outside_lambda_not_mem c hp hout),
    OAI.ActualEisensteinCubic.canonicalSextic_pow_six, inv_one, MulChar.one_apply hu]

/-- Scaling by a residue unit preserves the exceptional branch and multiplies
every other literal branch by its negative sextic character power. -/
theorem thetaLocalFactor_mul_fixed (c : ArithmeticContext) {p : Ideal O}
    (hp : Prime p) (hout : Outside c.S p) (q : O) (hq : q ∉ p)
    (j : Fin 6) (m : O) :
