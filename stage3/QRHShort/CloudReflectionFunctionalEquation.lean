namespace QRHShort.CloudBatch.ReflectionCuspPhasePool
open ReflectionFE ReflectionResidual
open OAI.CubicEisenstein

private theorem lambda_ne_zero : QRHShort.lambda ≠ 0 := by
  apply embedding_eq_zero.not.mp
  rw [← eisLam_eq_embedding_lambda]
  exact OAI.ConcreteTraceCRT.eisLam_ne_zero

def phaseModulus (c₀ : O) : O := QRHShort.lambda ^ (3 : ℕ) * c₀

theorem phaseModulus_ne_zero (c₀ : O) (hc₀ : c₀ ≠ 0) : phaseModulus c₀ ≠ 0 :=
  mul_ne_zero (pow_ne_zero _ lambda_ne_zero) hc₀

def fixedResiduePhase (c₀ : O) (hc₀ : c₀ ≠ 0)
    (q : O ⧸ (Ideal.span {phaseModulus c₀} : Ideal O)) (m : O) : ℂ :=
  quotientTrace (phaseModulus c₀) (phaseModulus_ne_zero c₀ hc₀)
    (q * Ideal.Quotient.mk _ m)

theorem fixedResiduePhase_add (c₀ : O) (hc₀ : c₀ ≠ 0)
    (q : O ⧸ (Ideal.span {phaseModulus c₀} : Ideal O)) (m n : O) :
    fixedResiduePhase c₀ hc₀ q (m + n) =
      fixedResiduePhase c₀ hc₀ q m * fixedResiduePhase c₀ hc₀ q n := by
  simp only [fixedResiduePhase, map_add, mul_add, AddChar.map_add_eq_mul]

theorem fixedResiduePhase_mk (c₀ : O) (hc₀ : c₀ ≠ 0) (a m : O) :
    fixedResiduePhase c₀ hc₀ (Ideal.Quotient.mk _ a) m =
      breve (embedding a * (embedding QRHShort.lambda ^ (-4 : ℤ) * embedding m) /
        embedding c₀) := by
  have hl : embedding QRHShort.lambda ≠ 0 := embedding_eq_zero.not.mpr lambda_ne_zero
  have hc : embedding c₀ ≠ 0 := embedding_eq_zero.not.mpr hc₀
  unfold fixedResiduePhase
  rw [← map_mul]
  change OAI.ShortDraftTrace.breveE
    (OAI.ConcreteTraceCRT.eisEmbedding (a * m) /
      (OAI.ConcreteTraceCRT.eisEmbedding (phaseModulus c₀) *
        OAI.ConcreteTraceCRT.eisLam)) = _
  rw [← breve_eq_breveE, oai_embedding_eq, oai_embedding_eq,
    eisLam_eq_embedding_lambda]
  unfold phaseModulus
  simp only [embedding_mul, embedding_pow]
  congr 1
  change embedding a * embedding m /
      (embedding QRHShort.lambda ^ (3 : ℕ) * embedding c₀ * embedding QRHShort.lambda) =
    embedding a * ((embedding QRHShort.lambda ^ (4 : ℕ))⁻¹ * embedding m) / embedding c₀
  field_simp [hl, hc]
  <;> ring

theorem fixedResiduePhase_norm (c₀ : O) (hc₀ : c₀ ≠ 0)
    (q : O ⧸ (Ideal.span {phaseModulus c₀} : Ideal O)) (m : O) :
