  · intro i A hA
    dsimp only [βnew]
    rw [norm_mul]
    exact (mul_le_mul_of_nonneg_left (hβ (e i).1 (e i).2 A hA) (norm_nonneg _)).trans
      (Finset.single_le_sum (fun t _ => mul_nonneg (norm_nonneg _) (hK t))
        (Finset.mem_univ (e i).1))
