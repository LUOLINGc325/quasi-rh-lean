        OAI.CompletedGauss.primaryGenerator T) ≠ 0 := by
    simpa only [hT, lowRamifiedFrequency, Units.val_pow_eq_pow_val, ramifiedOmegaUnit_val] using hE
  have hv : ∀ P ∈ normalizedFactors T, (normalizedFactors T).count P % 3 ≠ 2 := by
    intro P hP
