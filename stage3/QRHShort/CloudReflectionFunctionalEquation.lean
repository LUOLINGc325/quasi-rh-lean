open Classical UniqueFactorizationMonoid

namespace QRHShort.CloudBatch.ReflectionResidual
open ReflectionFE

theorem primary_mul (a b : O) (ha : IsPrimary a) (hb : IsPrimary b) :
    IsPrimary (a * b) := by
  apply (isPrimary_iff_three_dvd _).mpr
  have he : a * b - 1 = a * (b - 1) + (a - 1) := by ring
  rw [he]
  exact dvd_add (dvd_mul_of_dvd_right ((isPrimary_iff_three_dvd _).mp hb) _)
    ((isPrimary_iff_three_dvd _).mp ha)

theorem primary_pow (a : O) (ha : IsPrimary a) (k : ℕ) : IsPrimary (a ^ k) := by
  induction k with
  | zero => simp [IsPrimary]
  | succ k ih => simpa only [pow_succ] using primary_mul (a ^ k) a ih ha

theorem lambda_prime : Prime lambda := by
  have hu : IsUnit (-omega) := by
    exact ((IsCyclotomicExtension.zeta_spec 3 ℚ K).toInteger_isPrimitiveRoot.isUnit
      (by decide)).neg
  have he : lambda = (-omega) * (omega - 1) := by
    unfold lambda
    linear_combination omega_sq_add_omega_add_one
  rw [he]
  exact (prime_isUnit_mul hu).mpr omega_sub_one_prime

theorem lambda_not_dvd_primary (a : O) (ha : IsPrimary a) : ¬ lambda ∣ a := by
  intro h
  exact lambda_prime.not_isUnit ((lambda_coprime_primary a ha).isUnit_of_dvd' (dvd_refl _) h)

theorem prime_power_cofactor_unique {M : Type*} [CommMonoidWithZero M]
    [IsCancelMulZero M] {p a b : M} (hp : Prime p)
    (ha : ¬ p ∣ a) (hb : ¬ p ∣ b) {m n : ℕ}
    (he : p ^ m * a = p ^ n * b) : m = n := by
  have hmn : p ^ m ∣ p ^ n := hp.pow_dvd_of_dvd_mul_right m hb
    (he ▸ dvd_mul_right (p ^ m) a)
  have hnm : p ^ n ∣ p ^ m := hp.pow_dvd_of_dvd_mul_right n ha
    (he.symm ▸ dvd_mul_right (p ^ n) b)
  exact le_antisymm ((pow_dvd_pow_iff hp.ne_zero hp.not_isUnit).mp hmn)
    ((pow_dvd_pow_iff hp.ne_zero hp.not_isUnit).mp hnm)

/-- Squarefree parts and cube parts are unique as actual ideals. -/
theorem squarefree_cube_ideal_unique {I J I' J' : Ideal O}
    (hJ : J ≠ 0) (hJ' : J' ≠ 0) (hI : Squarefree I) (hI' : Squarefree I')
    (h : I * J ^ 3 = I' * J' ^ 3) : I = I' ∧ J = J' := by
  have hf := congrArg normalizedFactors h
  rw [normalizedFactors_mul hI.ne_zero (pow_ne_zero _ hJ),
    normalizedFactors_mul hI'.ne_zero (pow_ne_zero _ hJ'),
    normalizedFactors_pow, normalizedFactors_pow] at hf
  have hi := (squarefree_iff_nodup_normalizedFactors hI.ne_zero).mp hI
  have hi' := (squarefree_iff_nodup_normalizedFactors hI'.ne_zero).mp hI'
  have hc (P : Ideal O) :
      (normalizedFactors I).count P = (normalizedFactors I').count P ∧
      (normalizedFactors J).count P = (normalizedFactors J').count P := by
    have he := congrArg (Multiset.count P) hf
    simp only [Multiset.count_add, Multiset.count_nsmul] at he
    have h1 := Multiset.nodup_iff_count_le_one.mp hi P
    have h2 := Multiset.nodup_iff_count_le_one.mp hi' P
    omega
  constructor
  · calc
      I = (normalizedFactors I).prod := (Ideal.prod_normalizedFactors_eq_self hI.ne_zero).symm
      _ = (normalizedFactors I').prod := congrArg Multiset.prod (Multiset.ext.mpr (fun P => (hc P).1))
      _ = I' := Ideal.prod_normalizedFactors_eq_self hI'.ne_zero
  · calc
      J = (normalizedFactors J).prod := (Ideal.prod_normalizedFactors_eq_self hJ).symm
      _ = (normalizedFactors J').prod := congrArg Multiset.prod (Multiset.ext.mpr (fun P => (hc P).2))
      _ = J' := Ideal.prod_normalizedFactors_eq_self hJ'

theorem primary_eq_of_principal_eq (a b : O) (ha : IsPrimary a) (hb : IsPrimary b)
    (he : principal a = principal b) : a = b :=
  OAI.ActualEisensteinCubic.primary_associated_eq a b
    (Ideal.span_singleton_eq_span_singleton.mp he) (primary_compat ha) (primary_compat hb)

/-- The complete ring-level representation underlying both branches of the
literal tau formula is injective, including its ramified exponent and unit. -/
theorem ramified_primary_cube_unique (u u' n b n' b' : O)
    (hu : IsUnit u) (hu' : IsUnit u')
    (hnb : PrimaryCubeData n b) (hnb' : PrimaryCubeData n' b')
    (m m' : ℕ)
    (he : u * lambda ^ m * (n * b ^ 3) = u' * lambda ^ m' * (n' * b' ^ 3)) :
    m = m' ∧ n = n' ∧ b = b' ∧ u = u' := by
  have hN : IsPrimary (n * b ^ 3) := primary_mul _ _ hnb.2.2.1 (primary_pow _ hnb.2.2.2.1 _)
  have hN' : IsPrimary (n' * b' ^ 3) := primary_mul _ _ hnb'.2.2.1 (primary_pow _ hnb'.2.2.2.1 _)
  have hco : ¬ lambda ∣ u * (n * b ^ 3) := by
    intro h
    rcases lambda_prime.dvd_or_dvd h with h | h
    · exact lambda_prime.not_isUnit (isUnit_of_dvd_unit h hu)
    · exact lambda_not_dvd_primary _ hN h
  have hco' : ¬ lambda ∣ u' * (n' * b' ^ 3) := by
    intro h
    rcases lambda_prime.dvd_or_dvd h with h | h
    · exact lambda_prime.not_isUnit (isUnit_of_dvd_unit h hu')
    · exact lambda_not_dvd_primary _ hN' h
  have hm : m = m' := prime_power_cofactor_unique lambda_prime hco hco'
    (by simpa only [mul_assoc, mul_left_comm, mul_comm] using he)
  subst m'
  have he' : u * (n * b ^ 3) = u' * (n' * b' ^ 3) :=
    mul_left_cancel₀ (pow_ne_zero m lambda_prime.ne_zero)
      (by simpa only [mul_assoc, mul_left_comm, mul_comm] using he)
  have hi : principal (n * b ^ 3) = principal (n' * b' ^ 3) := by
    calc
      principal (n * b ^ 3) = principal (u * (n * b ^ 3)) :=
        (Ideal.span_singleton_mul_left_unit hu _).symm
      _ = principal (u' * (n' * b' ^ 3)) := congrArg principal he'
      _ = principal (n' * b' ^ 3) := Ideal.span_singleton_mul_left_unit hu' _
  have hprod : principal n * principal b ^ 3 = principal n' * principal b' ^ 3 := by
    simpa only [principal, Ideal.span_singleton_pow, Ideal.span_singleton_mul_span_singleton] using hi
  have hparts := squarefree_cube_ideal_unique
    (Ideal.span_singleton_eq_bot.not.mpr hnb.2.1)
    (Ideal.span_singleton_eq_bot.not.mpr hnb'.2.1) hnb.2.2.2.2 hnb'.2.2.2.2 hprod
  have hn : n = n' := primary_eq_of_principal_eq _ _ hnb.2.2.1 hnb'.2.2.1 hparts.1
  have hb : b = b' := primary_eq_of_principal_eq _ _ hnb.2.2.2.1 hnb'.2.2.2.1 hparts.2
  subst n'
  subst b'
  exact ⟨rfl, rfl, rfl, mul_right_cancel₀ (mul_ne_zero hnb.1 (pow_ne_zero 3 hnb.2.1)) he'⟩

end QRHShort.CloudBatch.ReflectionResidual


