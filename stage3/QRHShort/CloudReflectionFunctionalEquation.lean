solution once the growing-mode balance is supplied. No balance identity is
assumed to be true by this algebraic reduction. -/
theorem unramified_three_ratios_of_balance
    (h0 : (((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) * principalArithmeticResidue (lam ^ 2) =
      unramifiedGaussResidue om)
    (h1 : (((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) * principalArithmeticResidue (om * lam ^ 2) =
      unramifiedGaussResidue (om ^ 2))
    (h2 : (((9 * Real.sqrt 3 / 2 : ℝ) : ℂ)) * principalArithmeticResidue (om ^ 2 * lam ^ 2) =
      unramifiedGaussResidue 1) :
    unramifiedGaussResidue om = ninthRoot⁻¹ * unramifiedGaussResidue 1 ∧
    unramifiedGaussResidue (om ^ 2) = ninthRoot * unramifiedGaussResidue 1 ∧
    unramifiedGaussResidue 1 = 3 * fourthWeight * unramifiedGaussResidue (om * lam) := by
  obtain ⟨e0, e1, e2⟩ := principal_square_three_rows
  rw [h0] at e0
  rw [h1] at e1
  rw [h2] at e2
