namespace QRHShort.CloudBatch.ReflectionFE

/-- The finite three-term definition selects the unique cubic residue root. -/
theorem cubicAtPrime_eq_of_test {P : Ideal O}
    (hζ : IsPrimitiveRoot (Ideal.Quotient.mk P omega) 3)
    {a : O} {j : ℕ} (hj : j < 3)
    (ht : Ideal.Quotient.mk P a ^ ((P.absNorm - 1) / 3) =
      Ideal.Quotient.mk P (omega ^ j)) :
    cubicAtPrime P a = embedding (omega ^ j) := by
  unfold cubicAtPrime
  rw [Finset.sum_eq_single j]
  · exact if_pos ht
  · intro i hi hij
    apply if_neg
    intro hiTest
    apply hij
    apply hζ.pow_inj (Finset.mem_range.mp hi) hj
    simpa only [map_pow] using hiTest.symm.trans ht
  · exact fun h => (h (Finset.mem_range.mpr hj)).elim

/-- Literal identification, including residue zero and the prime above two. -/
theorem cubicAtPrime_eq_cubicChar (P : Ideal O) [P.IsMaximal]
    (hg : OAI.ActualEisensteinCubic.lambda ∉ P) (a : O) :
    cubicAtPrime P a = embedding
      (OAI.ActualEisensteinCubic.cubicChar P hg (Ideal.Quotient.mk P a)) := by
  letI : Field (O ⧸ P) := Ideal.Quotient.field P
  have hζ : IsPrimitiveRoot (Ideal.Quotient.mk P omega) 3 :=
    OAI.ActualEisensteinCubic.omega_reduced_primitive P hg
  have ht := OAI.ActualEisensteinCubic.cubicChar_reduce P hg (Ideal.Quotient.mk P a)
  have ht' : Ideal.Quotient.mk P a ^ ((P.absNorm - 1) / 3) =
      Ideal.Quotient.mk P
        (OAI.ActualEisensteinCubic.cubicChar P hg (Ideal.Quotient.mk P a)) := by
    simpa only [Ideal.absNorm_apply, Submodule.cardQuot_apply] using ht.symm
  by_cases ha : a ∈ P
  · have ha0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
    rw [ha0, MulChar.map_zero, map_zero] at ht'
    rw [ha0, MulChar.map_zero, embedding_zero]
    unfold cubicAtPrime
    apply Finset.sum_eq_zero
    intro j _
    apply if_neg
    rw [ha0, ht', map_pow]
    exact (pow_ne_zero j (hζ.ne_zero (by decide))).symm
  · have hv := OAI.CubicRamified.cubicValue_cube P hg a ha
    obtain ⟨j, hj, hjv⟩ := OAI.ActualEisensteinCubic.omega_primitive.eq_pow_of_pow_eq_one hv
    change omega ^ j = _ at hjv
    rw [← hjv] at ht' ⊢
    exact cubicAtPrime_eq_of_test hζ hj ht'

theorem primary_compat {a : O} (ha : IsPrimary a) :
    OAI.ActualEisensteinCubic.lambda ^ (2 : ℕ) ∣ a - 1 :=
  OAI.ActualEisensteinCubic.lambda_sq_dvd_three.trans
    ((isPrimary_iff_three_dvd a).mp ha)

/-- The multiplicative literal cubic symbol is the actual Jacobi symbol,
with the frozen complex embedding. No arithmetic-context premise is used. -/
theorem cubicSymbol_eq_idealSymbol (I : Ideal O)
    (hgood : ∀ P ∈ UniqueFactorizationMonoid.normalizedFactors I,
      OAI.ActualEisensteinCubic.lambda ∉ P) (x : O) :
    cubicSymbol I x = embedding (OAI.CubicJacobiGlobal.idealSymbol I x) := by
  by_cases hI : I = ⊥
  · simp [cubicSymbol, OAI.CubicJacobiGlobal.idealSymbol, hI]
  · have hI0 : I ≠ (0 : Ideal O) := hI
    rw [cubicSymbol, if_neg hI, OAI.CubicJacobiGlobal.idealSymbol,
      if_neg hI0]
    rw [← embeddingHom_apply]
    rw [map_multiset_prod, Multiset.map_map]
    apply congrArg Multiset.prod
    apply Multiset.map_congr rfl
    intro P hP
    have hp := UniqueFactorizationMonoid.prime_of_normalized_factor P hP
    letI : P.IsMaximal := (Ideal.isPrime_of_prime hp).isMaximal hp.ne_zero
    simp only [Function.comp_apply]
    rw [OAI.CubicJacobiGlobal.primeValue_eq P (hgood P hP)]
    simpa only [Function.comp_apply, embeddingHom_apply] using
      cubicAtPrime_eq_cubicChar P (hgood P hP) x

theorem cubicSymbol_primary (a x : O) (ha : IsPrimary a) :
    cubicSymbol (principal a) x = embedding (OAI.CubicJacobiGlobal.symbol x a) := by
  apply cubicSymbol_eq_idealSymbol
  intro P hP
  have ha' := primary_compat ha
  have ha0 := OAI.CubicJacobiGlobal.primary_ne_zero a ha'
  have hI : principal a ≠ (0 : Ideal O) := Ideal.span_singleton_eq_bot.not.mpr ha0
  have hp := UniqueFactorizationMonoid.prime_of_normalized_factor P hP
  letI : P.IsMaximal := (Ideal.isPrime_of_prime hp).isMaximal hp.ne_zero
  have hle := ((Ideal.mem_normalizedFactors_iff hI).mp hP).2
  exact OAI.ActualEisensteinCubic.primary_maximal_divisor_good a ha' P
    (hle (Ideal.subset_span (by simp)))

/-- Cubic reciprocity in exactly the manuscript's finite-symbol convention. -/
theorem cubicSymbol_reciprocity (a b : O) (ha : IsPrimary a) (hb : IsPrimary b) :
    cubicSymbol (principal a) b = cubicSymbol (principal b) a := by
  rw [cubicSymbol_primary a b ha, cubicSymbol_primary b a hb]
  exact congrArg embedding (OAI.CubicJacobiGlobal.symbol_reciprocity b a
    (OAI.CubicJacobiGlobal.primary_ne_zero b (primary_compat hb))
    (OAI.CubicJacobiGlobal.primary_ne_zero a (primary_compat ha))
    (primary_compat hb) (primary_compat ha))

abbrev LevelThree := OAI.ReflectionFEKubota.levelThree

/-- Kubota's multiplier built with the literal cubic symbol `(c/a)₃`. -/
def kubotaMultiplier (M : LevelThree) : ℂ :=
  cubicSymbol (principal ((M : SL(2, O)) 0 0)) ((M : SL(2, O)) 1 0)

theorem levelThree_primary (M : LevelThree) : IsPrimary ((M : SL(2, O)) 0 0) := by
  apply (isPrimary_iff_three_dvd _).mpr
  simpa using OAI.ReflectionFEKubota.levelThree_entry M 0 0

theorem kubotaMultiplier_eq (M : LevelThree) :
    kubotaMultiplier M = embedding (OAI.ReflectionFEKubota.value M) :=
  cubicSymbol_primary _ _ (levelThree_primary M)

theorem kubotaMultiplier_mul (M N : LevelThree) :
    kubotaMultiplier (M * N) = kubotaMultiplier M * kubotaMultiplier N := by
  rw [kubotaMultiplier_eq, OAI.ReflectionFEKubota.value_mul, embedding_mul,
    ← kubotaMultiplier_eq, ← kubotaMultiplier_eq]

@[simp] theorem kubotaMultiplier_one : kubotaMultiplier 1 = 1 := by
  rw [kubotaMultiplier_eq, OAI.ReflectionFEKubota.value_one, embedding_one]

def kubotaCharacter : LevelThree →* ℂ where
  toFun := kubotaMultiplier
  map_one' := kubotaMultiplier_one
  map_mul' := kubotaMultiplier_mul

theorem kubotaMultiplier_cube (M : LevelThree) : kubotaMultiplier M ^ 3 = 1 := by
  rw [kubotaMultiplier_eq, ← embedding_pow, OAI.ReflectionFEKubota.value_cube,
    embedding_one]

theorem norm_kubotaMultiplier (M : LevelThree) : ‖kubotaMultiplier M‖ = 1 := by
  exact Complex.norm_eq_one_of_pow_eq_one (kubotaMultiplier_cube M) (by decide)

theorem kubotaMultiplier_zero_lower_left (M : LevelThree)
    (hc : (M : SL(2, O)) 1 0 = 0) : kubotaMultiplier M = 1 := by
  rw [kubotaMultiplier_eq, OAI.ReflectionFEKubota.value_zero_lower_left M hc,
    embedding_one]

/-- The principal-cusp branch of the manuscript's multiplier factorization. -/
theorem kubotaMultiplier_factor_primary (M : LevelThree) (c₀ r : O)
    (hr : IsPrimary r) (hc : (M : SL(2, O)) 1 0 = c₀ * r) :
    kubotaMultiplier M =
      cubicSymbol (principal ((M : SL(2, O)) 0 0)) c₀ *
        cubicSymbol (principal r) ((M : SL(2, O)) 0 0) := by
  have ha := levelThree_primary M
  rw [kubotaMultiplier, hc, cubicSymbol_primary _ _ ha,
    OAI.CubicJacobiGlobal.symbol_mul_numerator _ _ _ (primary_compat ha),
    embedding_mul, ← cubicSymbol_primary _ _ ha, ← cubicSymbol_primary _ _ ha,
    cubicSymbol_reciprocity _ _ ha hr]

end QRHShort.CloudBatch.ReflectionFE

namespace QRHShort.CloudBatch.ReflectionFEGeometry

/-- The usual upper-half-space coordinates of the action of `SL₂(ℂ)`. -/
def mobiusCoordinates (g : SL(2, ℂ)) (z : ℂ) (v : ℝ) : ℂ × ℝ :=
  ((((g 0 0 * z + g 0 1) * star (g 1 0 * z + g 1 1) +
      g 0 0 * star (g 1 0) * (v : ℂ) ^ 2) /
    ((‖g 1 0 * z + g 1 1‖ ^ 2 + ‖g 1 0‖ ^ 2 * v ^ 2 : ℝ) : ℂ)),
    v / (‖g 1 0 * z + g 1 1‖ ^ 2 + ‖g 1 0‖ ^ 2 * v ^ 2))

def inverseCuspCoordinates (c d : ℂ) (v : ℝ) (z : ℂ) : ℂ × ℝ :=
  (-d / c - star z / (c ^ 2 * ((v ^ 2 + ‖z‖ ^ 2 : ℝ) : ℂ)),
    v / (‖c‖ ^ 2 * (v ^ 2 + ‖z‖ ^ 2)))

theorem inverseCuspCoordinates_height_pos (c d : ℂ) (v : ℝ) (z : ℂ)
    (hc : c ≠ 0) (hv : 0 < v) : 0 < (inverseCuspCoordinates c d v z).2 := by
  dsimp [inverseCuspCoordinates]
  positivity

/-- Exact inversion at `a/c`; in particular the height is inverted, rather
than merely kept fixed by a horizontal Fourier translation. -/
theorem inverse_cusp_coordinates (g : SL(2, ℂ)) (hc : g 1 0 ≠ 0)
    (v : ℝ) (hv : 0 < v) (z : ℂ) :
    mobiusCoordinates g⁻¹ (z + g 0 0 / g 1 0) v =
      inverseCuspCoordinates (g 1 0) (g 1 1) v z := by
  have hdet : g 0 0 * g 1 1 - g 0 1 * g 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using g.property
  have h00 : (g⁻¹) 0 0 = g 1 1 := by
    simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have h01 : (g⁻¹) 0 1 = -g 0 1 := by
    simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have h10 : (g⁻¹) 1 0 = -g 1 0 := by
    simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have h11 : (g⁻¹) 1 1 = g 0 0 := by
    simp [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  have hl : (-g 1 0) * (z + g 0 0 / g 1 0) + g 0 0 = -(g 1 0 * z) := by
    field_simp
    ring
  have ht : g 1 1 * (z + g 0 0 / g 1 0) + (-g 0 1) =
      g 1 1 * z + 1 / g 1 0 := by
    field_simp
    linear_combination hdet
  have hden : ‖-(g 1 0 * z)‖ ^ 2 + ‖-g 1 0‖ ^ 2 * v ^ 2 =
      ‖g 1 0‖ ^ 2 * (v ^ 2 + ‖z‖ ^ 2) := by
    rw [norm_neg, norm_neg, norm_mul, mul_pow]
    ring
  have hnormc : ((‖g 1 0‖ ^ 2 : ℝ) : ℂ) = g 1 0 * star (g 1 0) := by
    simpa [Complex.normSq_eq_norm_sq, Complex.star_def] using
      (Complex.mul_conj (g 1 0)).symm
  have hnormz : ((‖z‖ ^ 2 : ℝ) : ℂ) = z * star z := by
    simpa [Complex.normSq_eq_norm_sq, Complex.star_def] using (Complex.mul_conj z).symm
  have hT : v ^ 2 + ‖z‖ ^ 2 ≠ 0 := by positivity
  have hTc : ((v ^ 2 + ‖z‖ ^ 2 : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hT
  have hcc : star (g 1 0) ≠ 0 := star_ne_zero.mpr hc
  apply Prod.ext
  · simp only [mobiusCoordinates, Prod.fst]
    rw [h00, h01, h10, h11, hl, ht, hden]
    dsimp [inverseCuspCoordinates]
    rw [Complex.ofReal_mul, hnormc]
    simp only [Complex.star_def, map_neg, map_mul]
    simp only [Complex.star_def] at hcc
    field_simp [hc, hcc, hTc]
    rw [Complex.ofReal_add, Complex.ofReal_pow, hnormz]
    simp only [Complex.star_def]
    ring
  · simp only [mobiusCoordinates, inverseCuspCoordinates, Prod.snd]
    rw [h10, h11, hl, hden]

def inverseCuspPath (c d : ℂ) (v : ℝ) (direction : ℂ) (t : ℝ) : ℂ × ℝ :=
  (-d / c - (t : ℂ) * star direction /
    (c ^ 2 * ((v ^ 2 + t ^ 2 * ‖direction‖ ^ 2 : ℝ) : ℂ)),
    v / (‖c‖ ^ 2 * (v ^ 2 + t ^ 2 * ‖direction‖ ^ 2)))

theorem inverseCuspPath_zero (c d : ℂ) (v : ℝ) (direction : ℂ)
    (hc : c ≠ 0) (hv : 0 < v) :
    inverseCuspPath c d v direction 0 = (-d / c, 1 / (‖c‖ ^ 2 * v)) := by
  unfold inverseCuspPath
  simp only [Complex.ofReal_zero, zero_pow (by decide : 2 ≠ 0), zero_mul,
    add_zero, zero_div, sub_zero]
  congr 1
  field_simp [norm_ne_zero_iff.mpr hc, hv.ne']

theorem inverseCuspPath_hasDerivAt (c d : ℂ) (v : ℝ) (direction : ℂ)
    (hc : c ≠ 0) (hv : 0 < v) :
    HasDerivAt (inverseCuspPath c d v direction)
      (-(star direction) / (c ^ 2 * (v : ℂ) ^ 2), 0) 0 := by
  have hn : ‖c‖ ≠ 0 := norm_ne_zero_iff.mpr hc
  have hvc : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv.ne'
  have hden : HasDerivAt (fun t : ℝ => v ^ 2 + t ^ 2 * ‖direction‖ ^ 2) 0 0 := by
    convert (((hasDerivAt_id (0 : ℝ)).pow 2).mul_const (‖direction‖ ^ 2)).const_add
      (v ^ 2) using 1 <;> norm_num
  have hnum : HasDerivAt (fun t : ℝ => (t : ℂ) * star direction) (star direction) 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).ofReal_comp.mul_const (star direction))
  have hdenC := hden.ofReal_comp.const_mul (c ^ 2)
  have hdenR := hden.const_mul (‖c‖ ^ 2)
  have hcz : c ^ 2 * ((v ^ 2 + (0 : ℝ) ^ 2 * ‖direction‖ ^ 2 : ℝ) : ℂ) ≠ 0 := by
    simpa using mul_ne_zero (pow_ne_zero 2 hc) (pow_ne_zero 2 hvc)
  have hrz : ‖c‖ ^ 2 * (v ^ 2 + (0 : ℝ) ^ 2 * ‖direction‖ ^ 2) ≠ 0 := by positivity
  have hz : HasDerivAt
      (fun t : ℝ => -d / c - (t : ℂ) * star direction /
        (c ^ 2 * ((v ^ 2 + t ^ 2 * ‖direction‖ ^ 2 : ℝ) : ℂ)))
      (-(star direction) / (c ^ 2 * (v : ℂ) ^ 2)) 0 := by
    convert (hnum.div hdenC hcz).const_sub (-d / c) using 1
    simp only [zero_pow (by decide : 2 ≠ 0), zero_mul, add_zero, Complex.ofReal_pow,
      Complex.ofReal_zero, mul_zero, sub_zero]
    field_simp
  have hvd : HasDerivAt
      (fun t : ℝ => v / (‖c‖ ^ 2 * (v ^ 2 + t ^ 2 * ‖direction‖ ^ 2))) 0 0 := by
    convert (hasDerivAt_const (0 : ℝ) v).div hdenR hrz using 1 <;> simp
  exact hz.prodMk hvd

theorem inverseCuspPath_comp_hasDerivAt (c d : ℂ) (v : ℝ) (direction : ℂ)
    (hc : c ≠ 0) (hv : 0 < v) (F : ℂ × ℝ → ℂ) (A : (ℂ × ℝ) →L[ℝ] ℂ)
    (hF : HasFDerivAt F A (-d / c, 1 / (‖c‖ ^ 2 * v))) :
    HasDerivAt (fun t => F (inverseCuspPath c d v direction t))
      (A (-(star direction) / (c ^ 2 * (v : ℂ) ^ 2), 0)) 0 := by
  have hf : HasFDerivAt F A (inverseCuspPath c d v direction 0) := by
    rwa [inverseCuspPath_zero c d v direction hc hv]
  exact hf.comp_hasDerivAt 0 (inverseCuspPath_hasDerivAt c d v direction hc hv)

theorem inverseCuspCoordinates_line (c d : ℂ) (v : ℝ) (direction : ℂ) (t : ℝ) :
    inverseCuspCoordinates c d v ((t : ℂ) * direction) =
      inverseCuspPath c d v direction t := by
  simp only [inverseCuspCoordinates, inverseCuspPath, star_mul, Complex.star_def,
    Complex.conj_ofReal, norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow,
    sq_abs, mul_comm]

def wirtingerBar (f : ℂ → ℂ) (z : ℂ) : ℂ :=
  (1 / 2 : ℂ) * (deriv (fun t : ℝ => f (z + (t : ℂ))) 0 +
    Complex.I * deriv (fun t : ℝ => f (z + (t : ℂ) * Complex.I)) 0)

def wirtingerZ (f : ℂ → ℂ) (z : ℂ) : ℂ :=
  (1 / 2 : ℂ) * (deriv (fun t : ℝ => f (z + (t : ℂ))) 0 -
    Complex.I * deriv (fun t : ℝ => f (z + (t : ℂ) * Complex.I)) 0)

theorem real_linear_horizontal_decompose (A : (ℂ × ℝ) →L[ℝ] ℂ) (z : ℂ) :
    A (z, 0) = (z.re : ℂ) * A (1, 0) + (z.im : ℂ) * A (Complex.I, 0) := by
  have hz : ((z, 0) : ℂ × ℝ) = z.re • (1, 0) + z.im • (Complex.I, 0) := by
    apply Prod.ext
    · simpa only [Prod.fst_add, Prod.smul_fst, Complex.real_smul, mul_one] using
        z.re_add_im.symm
    · simp
  rw [hz, map_add, map_smul, map_smul]
  simp only [Complex.real_smul]

theorem real_linear_wirtinger_swap (A : (ℂ × ℝ) →L[ℝ] ℂ) (k : ℂ) :
    (1 / 2 : ℂ) * (A (k, 0) + Complex.I * A (-Complex.I * k, 0)) =
      k * ((1 / 2 : ℂ) * (A (1, 0) - Complex.I * A (Complex.I, 0))) := by
  rw [real_linear_horizontal_decompose A k,
    real_linear_horizontal_decompose A (-Complex.I * k)]
  simp only [Complex.mul_re, Complex.mul_im, Complex.neg_re, Complex.neg_im,
    Complex.I_re, Complex.I_im, zero_mul, neg_mul, one_mul, zero_add, zero_sub,
    Complex.ofReal_neg]
  conv_rhs => lhs; rw [← k.re_add_im]
  ring_nf
  simp only [Complex.I_sq]
  ring

theorem inverse_cusp_wirtingerBar (c d : ℂ) (v : ℝ) (hc : c ≠ 0) (hv : 0 < v)
    (F : ℂ × ℝ → ℂ) (A : (ℂ × ℝ) →L[ℝ] ℂ)
    (hF : HasFDerivAt F A (-d / c, 1 / (‖c‖ ^ 2 * v))) :
    wirtingerBar (fun z => F (inverseCuspCoordinates c d v z)) 0 =
      (-1 / (c ^ 2 * (v : ℂ) ^ 2)) *
        ((1 / 2 : ℂ) * (A (1, 0) - Complex.I * A (Complex.I, 0))) := by
  have h1 := (inverseCuspPath_comp_hasDerivAt c d v 1 hc hv F A hF).deriv
  have hI := (inverseCuspPath_comp_hasDerivAt c d v Complex.I hc hv F A hF).deriv
  have he1 : (fun t : ℝ => F (inverseCuspCoordinates c d v (t : ℂ))) =
      (fun t : ℝ => F (inverseCuspPath c d v 1 t)) := by
    funext t
    rw [← inverseCuspCoordinates_line]
    simp only [mul_one]
  have heI : (fun t : ℝ => F (inverseCuspCoordinates c d v ((t : ℂ) * Complex.I))) =
      (fun t : ℝ => F (inverseCuspPath c d v Complex.I t)) := by
    funext t
    rw [inverseCuspCoordinates_line]
  rw [wirtingerBar]
  simp only [zero_add]
  rw [he1, heI, h1, hI]
  simp only [star_one, Complex.star_def, Complex.conj_I, neg_neg]
  convert real_linear_wirtinger_swap A (-1 / (c ^ 2 * (v : ℂ) ^ 2)) using 1 <;>
    congr 2 <;> ring_nf

theorem wirtingerZ_eq_fderiv (F : ℂ × ℝ → ℂ) (A : (ℂ × ℝ) →L[ℝ] ℂ)
    (z : ℂ) (v : ℝ) (hF : HasFDerivAt F A (z, v)) :
    wirtingerZ (fun w => F (w, v)) z =
      (1 / 2 : ℂ) * (A (1, 0) - Complex.I * A (Complex.I, 0)) := by
  have hline (direction : ℂ) :
      HasDerivAt (fun t : ℝ => F (z + (t : ℂ) * direction, v)) (A (direction, 0)) 0 := by
    have hz : HasDerivAt (fun t : ℝ => z + (t : ℂ) * direction) direction 0 := by
      simpa using (((hasDerivAt_id (0 : ℝ)).ofReal_comp.mul_const direction).const_add z)
    have hp := hz.prodMk (hasDerivAt_const (0 : ℝ) v)
    have hf : HasFDerivAt F A (z + (0 : ℂ) * direction, v) := by simpa using hF
    exact hf.comp_hasDerivAt 0 hp
  have h1 := (hline 1).deriv
  have hI := (hline Complex.I).deriv
  simp only [mul_one] at h1
  rw [wirtingerZ, h1, hI]

/-- The true cusp Jacobian swaps the two Wirtinger derivatives. -/
theorem inverse_cusp_wirtinger_rule (c d : ℂ) (v : ℝ) (hc : c ≠ 0) (hv : 0 < v)
    (F : ℂ × ℝ → ℂ) (A : (ℂ × ℝ) →L[ℝ] ℂ)
    (hF : HasFDerivAt F A (-d / c, 1 / (‖c‖ ^ 2 * v))) :
    wirtingerBar (fun z => F (inverseCuspCoordinates c d v z)) 0 =
      (-1 / (c ^ 2 * (v : ℂ) ^ 2)) *
        wirtingerZ (fun z => F (z, 1 / (‖c‖ ^ 2 * v))) (-d / c) := by
  rw [wirtingerZ_eq_fderiv F A _ _ hF]
  exact inverse_cusp_wirtingerBar c d v hc hv F A hF

end QRHShort.CloudBatch.ReflectionFEGeometry

namespace QRHShort.CloudBatch.ReflectionFE

theorem sexticAtPrime_eq_of_test {P : Ideal O}
    (hζ : IsPrimitiveRoot (Ideal.Quotient.mk P rootSix) 6)
    {a : O} {j : ℕ} (hj : j < 6)
    (ht : Ideal.Quotient.mk P a ^ ((P.absNorm - 1) / 6) =
      Ideal.Quotient.mk P (rootSix ^ j)) :
    sexticAtPrime P a = embedding (rootSix ^ j) := by
  unfold sexticAtPrime
  rw [Finset.sum_eq_single j]
  · exact if_pos ht
  · intro i hi hij
    apply if_neg
    intro hiTest
    apply hij
    apply hζ.pow_inj (Finset.mem_range.mp hi) hj
    simpa only [map_pow] using hiTest.symm.trans ht
  · exact fun h => (h (Finset.mem_range.mpr hj)).elim

theorem sexticAtPrime_zero_of_mem {P : Ideal O} (hP : Prime P)
    (hζ : IsPrimitiveRoot (Ideal.Quotient.mk P rootSix) 6)
    {a : O} (ha : a ∈ P) : sexticAtPrime P a = 0 := by
  letI : P.IsMaximal := (Ideal.isPrime_of_prime hP).isMaximal hP.ne_zero
  letI : Field (O ⧸ P) := Ideal.Quotient.field P
  letI : Finite (O ⧸ P) := Ring.HasFiniteQuotients.finiteQuotient hP.ne_zero
  letI : Fintype (O ⧸ P) := Fintype.ofFinite _
  have hcard : P.absNorm = Fintype.card (O ⧸ P) := by
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
  have hd : 6 ∣ Fintype.card (O ⧸ P) - 1 :=
    (hζ.pow_eq_one_iff_dvd _).mp
      (FiniteField.pow_card_sub_one_eq_one _ (hζ.ne_zero (by decide)))
  have hpos : 0 < (P.absNorm - 1) / 6 := by
    rw [hcard]
    exact Nat.div_pos (Nat.le_of_dvd (by have := Fintype.one_lt_card (α := O ⧸ P); omega)
      hd) (by decide)
  have ht : Ideal.Quotient.mk P a ^ ((P.absNorm - 1) / 6) = 0 := by
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, zero_pow hpos.ne']
  unfold sexticAtPrime
  apply Finset.sum_eq_zero
  intro j _
  apply if_neg
  rw [ht, map_pow]
  exact (pow_ne_zero j (hζ.ne_zero (by decide))).symm

theorem sexticAtPrime_eq_sexticChar (P : Ideal O) (hP : Prime P) [P.IsMaximal]
    (hg : OAI.ActualEisensteinCubic.lambda ∉ P)
    (hc : ringChar (O ⧸ P) ≠ 2)
    (hζ : IsPrimitiveRoot (Ideal.Quotient.mk P rootSix) 6) (a : O) :
    sexticAtPrime P a = embedding
      (OAI.ActualEisensteinCubic.sexticChar P hg (Ideal.Quotient.mk P a)) := by
  letI : Field (O ⧸ P) := Ideal.Quotient.field P
  by_cases ha : a ∈ P
  · rw [sexticAtPrime_zero_of_mem hP hζ ha,
      Ideal.Quotient.eq_zero_iff_mem.mpr ha, MulChar.map_zero, embedding_zero]
  · have hu : IsUnit (Ideal.Quotient.mk P a) :=
      isUnit_iff_ne_zero.mpr (Ideal.Quotient.eq_zero_iff_mem.not.mpr ha)
    have hv : OAI.ActualEisensteinCubic.sexticChar P hg
        (Ideal.Quotient.mk P a) ^ (6 : ℕ) = 1 := by
      rw [← MulChar.pow_apply' _ (by decide : (6 : ℕ) ≠ 0),
        (OAI.ActualEisensteinCubic.sexticChar_powers P hg).2.2,
        MulChar.one_apply hu]
    have ht := OAI.ActualEisensteinCubic.sexticChar_reduce_unit P hg hc hu.unit
    rw [hu.unit_spec] at ht
    have ht' : Ideal.Quotient.mk P a ^ ((P.absNorm - 1) / 6) =
        Ideal.Quotient.mk P (OAI.ActualEisensteinCubic.sexticChar P hg
          (Ideal.Quotient.mk P a)) := by
      simpa only [Ideal.absNorm_apply, Submodule.cardQuot_apply] using ht.symm
    have hr : IsPrimitiveRoot rootSix 6 := by
      refine ⟨rootSix_pow_six, ?_⟩
      intro k hk
      apply hζ.dvd_of_pow_eq_one k
      simpa only [map_pow, map_one] using congrArg (Ideal.Quotient.mk P) hk
    obtain ⟨j, hj, hjv⟩ := hr.eq_pow_of_pow_eq_one hv
    rw [← hjv] at ht' ⊢
    exact sexticAtPrime_eq_of_test hζ hj ht'

/-- Exact compatibility of the independently defined cubic and sextic symbols. -/
theorem cubicAtPrime_eq_sexticAtPrime_sq (P : Ideal O) (hP : Prime P)
    (h2 : ¬ P ∣ principal (2 : O)) (h3 : ¬ P ∣ principal (3 : O)) (a : O) :
    cubicAtPrime P a = sexticAtPrime P a ^ (2 : ℕ) := by
  letI : P.IsMaximal := (Ideal.isPrime_of_prime hP).isMaximal hP.ne_zero
  have hg : OAI.ActualEisensteinCubic.lambda ∉ P := by
    intro h
    exact h3 (Ideal.dvd_span_singleton.mpr
      (P.mem_of_dvd omega_sub_one_dvd_three h))
  have hc : ringChar (O ⧸ P) ≠ 2 := by
    apply OAI.ActualEisensteinCubic.quotient_char_ne_two_of_two_not_mem P
    exact fun h => h2 (Ideal.dvd_span_singleton.mpr h)
  have hζ := quotient_rootSix_isPrimitiveRoot P h2 h3
  have hpow : OAI.ActualEisensteinCubic.sexticChar P hg
      (Ideal.Quotient.mk P a) ^ (2 : ℕ) =
      OAI.ActualEisensteinCubic.cubicChar P hg (Ideal.Quotient.mk P a) := by
    rw [← MulChar.pow_apply' _ (by decide : (2 : ℕ) ≠ 0),
      (OAI.ActualEisensteinCubic.sexticChar_powers P hg).1]
  rw [cubicAtPrime_eq_cubicChar P hg a,
    sexticAtPrime_eq_sexticChar P hP hg hc hζ a, ← embedding_pow, hpow]

theorem cubicSymbol_eq_sexticSymbol_sq (c : ArithmeticContext) {I : Ideal O}
    (hI : Outside c.S I) (a : O) :
    cubicSymbol I a = sexticSymbol I a ^ (2 : ℕ) := by
  rw [cubicSymbol, if_neg hI.1, sexticSymbol, if_neg hI.1,
    ← Multiset.prod_map_pow]
  apply congrArg Multiset.prod
  apply Multiset.map_congr rfl
  intro P hP
  have hp := UniqueFactorizationMonoid.prime_of_normalized_factor P hP
  have hd : P ∣ I := Ideal.dvd_iff_le.mpr
    ((Ideal.mem_normalizedFactors_iff hI.1).mp hP).2
  have h2 : ¬ P ∣ principal (2 : O) :=
    fun h => hI.2 P (c.above_two P hp h) hd
  have h3 : ¬ P ∣ principal (3 : O) :=
    fun h => hI.2 P (c.above_three P hp h) hd
  exact cubicAtPrime_eq_sexticAtPrime_sq P hp h2 h3 a

theorem cubicSymbol_prime {P : Ideal O} (hP : Prime P) (a : O) :
    cubicSymbol P a = cubicAtPrime P a := by
  have hfac : UniqueFactorizationMonoid.normalizedFactors P = {P} := by
    simpa using (UniqueFactorizationMonoid.normalizedFactors_prod_of_prime
      (m := {P}) (by simpa using hP))
  have hP0 : P ≠ ⊥ := hP.ne_zero
  simp only [cubicSymbol, if_neg hP0, hfac,
    Multiset.map_singleton, Multiset.prod_singleton]

theorem sexticSymbol_prime {P : Ideal O} (hP : Prime P) (a : O) :
    sexticSymbol P a = sexticAtPrime P a := by
  have hfac : UniqueFactorizationMonoid.normalizedFactors P = {P} := by
    simpa using (UniqueFactorizationMonoid.normalizedFactors_prod_of_prime
      (m := {P}) (by simpa using hP))
  have hP0 : P ≠ ⊥ := hP.ne_zero
  simp only [sexticSymbol, if_neg hP0, hfac,
    Multiset.map_singleton, Multiset.prod_singleton]

theorem cubicSymbol_mul (I J : Ideal O) (a : O) :
    cubicSymbol (I * J) a = cubicSymbol I a * cubicSymbol J a := by
  by_cases hI : I = ⊥
  · simp [hI, cubicSymbol]
  by_cases hJ : J = ⊥
  · simp [hJ, cubicSymbol]
  have hIJ : I * J ≠ ⊥ := mul_ne_zero hI hJ
  rw [cubicSymbol, if_neg hIJ, cubicSymbol, if_neg hI, cubicSymbol, if_neg hJ,
    UniqueFactorizationMonoid.normalizedFactors_mul hI hJ,
    Multiset.map_add, Multiset.prod_add]

@[simp] theorem cubicSymbol_one (a : O) : cubicSymbol 1 a = 1 := by
  rw [cubicSymbol, if_neg (show (1 : Ideal O) ≠ ⊥ from one_ne_zero)]
  rw [UniqueFactorizationMonoid.normalizedFactors_one]
  rfl

/-- The local multiplier used in the reflection formula is literally the
cubic residue character, including its zero at nonunits. -/
theorem cubicSymbol_eq_localCharacterPower (c : ArithmeticContext) {P : Ideal O}
    (hP : Prime P) (hout : Outside c.S P) (a : O) :
    cubicSymbol P a = localCharacterPower P 2 a := by
  rw [cubicSymbol_eq_sexticSymbol_sq c hout]
  unfold localCharacterPower
  by_cases ha : a ∈ P
  · rw [if_pos ha, sexticSymbol_prime hP,
      sexticAtPrime_zero_of_mem hP
        (outside_quotient_rootSix_isPrimitiveRoot c hP hout) ha]
    norm_num
  · rw [if_neg ha]
    simp only [zpow_ofNat]

theorem cubicSymbol_prod (A : Finset (Ideal O)) (a : O) :
    cubicSymbol (∏ P ∈ A, P) a = ∏ P ∈ A, cubicSymbol P a := by
  induction A using Finset.induction_on with
  | empty => simpa only [Finset.prod_empty] using cubicSymbol_one a
  | @insert P A hPA ih =>
    rw [Finset.prod_insert hPA, Finset.prod_insert hPA, cubicSymbol_mul, ih]

/-- The actual varying-prime part of the Kubota multiplier, with exactly the
local exponent two appearing in the manuscript. -/
theorem cubicSymbol_active_product (c : ArithmeticContext) (A : Finset (Ideal O))
    (hA : ∀ P ∈ A, Prime P ∧ Outside c.S P) (a : O) :
    cubicSymbol (∏ P ∈ A, P) a = ∏ P ∈ A, localCharacterPower P 2 a := by
  rw [cubicSymbol_prod]
  apply Finset.prod_congr rfl
  intro P hP
  exact cubicSymbol_eq_localCharacterPower c (hA P hP).1 (hA P hP).2 a

theorem kubotaMultiplier_factor_active (c : ArithmeticContext) (M : LevelThree)
    (c₀ r : O) (A : Finset (Ideal O))
    (hr : IsPrimary r) (hgen : principal r = ∏ P ∈ A, P)
    (hc : (M : SL(2, O)) 1 0 = c₀ * r)
    (hA : ∀ P ∈ A, Prime P ∧ Outside c.S P) :
    kubotaMultiplier M = cubicSymbol (principal ((M : SL(2, O)) 0 0)) c₀ *
      ∏ P ∈ A, localCharacterPower P 2 ((M : SL(2, O)) 0 0) := by
  rw [kubotaMultiplier_factor_primary M c₀ r hr hc, hgen,
    cubicSymbol_active_product c A hA]

end QRHShort.CloudBatch.ReflectionFE

open scoped BigOperators Classical

namespace OAI.ReflectionFECusp

section
open ActualEisensteinCubic CubicJacobiGlobal ReflectionFEJacobi
local notation "Eis" => ActualEisensteinCubic.O

theorem A3_principal_global (a c0 r : Eis)
    (ha : lambda^2∣a-1) (hr : lambda^2∣r-1) :
    symbol (c0*r) a=symbol c0 a*symbol a r := by
  rw [symbol_mul_numerator _ _ a ha,
    symbol_reciprocity r a (primary_ne_zero r hr) (primary_ne_zero a ha) hr ha]

theorem A3_ramified_global (a b cprime d u : Eis)
    (hdet : a*d-b*(u*cprime)=1)
    (ha : lambda^2∣a-1) (hA : lambda^2∣(a-u*b)-1) :
    symbol (u*cprime-u*d) (a-u*b)=symbol (-u) (a-u*b)*symbol cprime a := by
  have h1 : symbol a (a-u*b)*symbol (u*cprime-u*d) (a-u*b)=symbol (-u) (a-u*b) := by
    rw [←symbol_mul_numerator _ _ _ hA]
    apply symbol_congr
    refine ⟨u*cprime,?_⟩
    linear_combination -u*hdet
  have h2 : symbol (a-u*b) a*symbol cprime a=1 := by
    rw [←symbol_mul_numerator _ _ _ ha,←symbol_one_numerator a ha]
    apply symbol_congr
    refine ⟨cprime-d,?_⟩
    linear_combination hdet
  rw [symbol_reciprocity a (a-u*b) (primary_ne_zero a ha)
    (primary_ne_zero _ hA) ha hA] at h1
  calc
    _ = (symbol (a-u*b) a*symbol cprime a)*symbol (u*cprime-u*d) (a-u*b) := by rw [h2,one_mul]
    _ = (symbol (a-u*b) a*symbol (u*cprime-u*d) (a-u*b))*symbol cprime a := by ring
    _ = _ := by rw [h1]

theorem A3_ramified_global_factor (a b c0 r d u : Eis)
    (hdet : a*d-b*(u*(c0*r))=1)
    (ha : lambda^2∣a-1) (hA : lambda^2∣(a-u*b)-1) (hr : lambda^2∣r-1) :
    symbol (u*(c0*r)-u*d) (a-u*b)=
      (symbol (-u) (a-u*b)*symbol c0 a)*symbol a r := by
  rw [A3_ramified_global a b (c0*r) d u hdet ha hA,
    A3_principal_global a c0 r ha hr]
  ring

theorem A3_unramified_global (a b c d : Eis)
    (hdet : a*d-b*c=1) (hb : lambda^2∣(-b)-1) (hc : lambda^2∣c-1)
    (h9 : (9:Eis)∣a*d) :
    symbol (-d) (-b)=symbol a c := by
  have hp : lambda^2∣((-b)*c)-1 := OAI.ReflectionFEJacobi.primary_mul (-b) c hb hc
  have hprod : symbol d (-b)*symbol d c=1 := by
    rw [←symbol_mul_denominator]
    have hnine : (9:Eis)∣(-b)*c-1 := by
      convert dvd_neg.mpr h9 using 1
      linear_combination hdet
    have hd : d∣(-b)*c-1 := by
      refine ⟨-a,?_⟩
      linear_combination hdet
    rw [symbol_denominator_congr d ((-b)*c) 1 hp (by simp) hnine hd,symbol_one]
  have hother : symbol a c*symbol d c=1 := by
    rw [←symbol_mul_numerator _ _ _ hc,←symbol_one_numerator c hc]
    apply symbol_congr
    refine ⟨b,?_⟩
    linear_combination hdet
  rw [symbol_neg_numerator _ _ hb]
  calc
    symbol d (-b) = symbol d (-b)*(symbol a c*symbol d c) := by rw [hother,mul_one]
    _ = (symbol d (-b)*symbol d c)*symbol a c := by ring
    _ = symbol a c := by rw [hprod,one_mul]

theorem A3_unramified_global_factor (a b c0 r d : Eis)
    (hdet : a*d-b*(c0*r)=1) (hb : lambda^2∣(-b)-1)
    (hc : lambda^2∣c0*r-1) (h9 : (9:Eis)∣a*d) :
    symbol (-d) (-b)=symbol a c0*symbol a r := by
  rw [A3_unramified_global a b (c0*r) d hdet hb hc h9,symbol_mul_denominator]

theorem A3_fixed_factor_congr (M c0 a a0 : Eis)
    (h9M : (9:Eis)∣M) (ha : lambda^2∣a-1) (ha0 : lambda^2∣a0-1)
    (hsector : M*c0∣a-a0) : symbol c0 a=symbol c0 a0 := by
  apply symbol_denominator_congr c0 a a0 ha ha0
  · exact (h9M.trans (dvd_mul_right M c0)).trans hsector
  · exact (dvd_mul_left c0 M).trans hsector

end

open ActualEisensteinCubic CubicJacobiGlobal ReflectionFEJacobi
local notation "Eis" => ActualEisensteinCubic.O

theorem A3_ramified_fixed_factor_congr (M c0 u a a0 b b0 : Eis)
    (h9M : (9:Eis)∣M) (hcM : c0∣M) (huM : u∣M)
    (ha : lambda^2∣a-1) (ha0 : lambda^2∣a0-1)
    (hA : lambda^2∣a-u*b-1) (hA0 : lambda^2∣a0-u*b0-1)
    (hma : M∣a-a0) (hmb : M∣b-b0) :
    symbol (-u) (a-u*b)*symbol c0 a=
      symbol (-u) (a0-u*b0)*symbol c0 a0 := by
  have hdiff : M∣(a-u*b)-(a0-u*b0) := by
    convert dvd_sub hma (dvd_mul_of_dvd_right hmb u) using 1 ; ring
  have hfirst : symbol (-u) (a-u*b)=symbol (-u) (a0-u*b0) := by
    apply symbol_denominator_congr _ _ _ hA hA0 (h9M.trans hdiff)
    exact neg_dvd.mpr (huM.trans hdiff)
  have hsecond := symbol_denominator_congr c0 a a0 ha ha0 (h9M.trans hma) (hcM.trans hma)
  rw [hfirst,hsecond]

theorem A3_unramified_fixed_factor_congr (M c0 a a0 : Eis)
    (hcM : c0∣M) (hma : M∣a-a0) : symbol a c0=symbol a0 c0 :=
  symbol_congr (hcM.trans hma)

theorem norm_embedded_cubic_symbol (x a : Eis)
    (ha : lambda^2∣a-1) (hcop : IsCoprime x a) :
    ‖ConcreteTraceCRT.eisEmbedding (symbol x a)‖=1 := by
  have hcube : ConcreteTraceCRT.eisEmbedding (symbol x a)^3=1 := by
    rw [←map_pow,OAI.ReflectionFEJacobi.symbol_cube_of_isCoprime x a ha hcop,map_one]
  apply (pow_eq_one_iff_of_nonneg (norm_nonneg _) (by decide : (3:ℕ)≠0)).mp
  simpa only [norm_pow,norm_one] using congrArg norm hcube

theorem norm_A3_principal_fixed_factor (a b c0 r d : Eis)
    (hdet : a*d-b*(c0*r)=1) (ha : lambda^2∣a-1) :
    ‖ConcreteTraceCRT.eisEmbedding (symbol c0 a)‖=1 := by
  apply norm_embedded_cubic_symbol _ _ ha
  refine ⟨-b*r,d,?_⟩
  linear_combination hdet

theorem norm_A3_ramified_fixed_factor (a b c0 r d u : Eis)
    (hdet : a*d-b*(u*(c0*r))=1)
    (ha : lambda^2∣a-1) (hA : lambda^2∣a-u*b-1) :
    ‖ConcreteTraceCRT.eisEmbedding (symbol (-u) (a-u*b)*symbol c0 a)‖=1 := by
  have hfirst : ‖ConcreteTraceCRT.eisEmbedding (symbol (-u) (a-u*b))‖=1 := by
    apply norm_embedded_cubic_symbol _ _ hA
    refine ⟨b*(c0*r-d),d,?_⟩
    linear_combination hdet
  have hsecond : ‖ConcreteTraceCRT.eisEmbedding (symbol c0 a)‖=1 := by
    apply norm_embedded_cubic_symbol _ _ ha
    refine ⟨-b*u*r,d,?_⟩
    linear_combination hdet
  rw [map_mul,norm_mul,hfirst,hsecond,one_mul]

theorem norm_A3_unramified_fixed_factor (a b c0 r d : Eis)
    (hdet : a*d-b*(c0*r)=1) (hc : lambda^2∣c0-1) :
    ‖ConcreteTraceCRT.eisEmbedding (symbol a c0)‖=1 := by
  apply norm_embedded_cubic_symbol _ _ hc
  refine ⟨d,-b*r,?_⟩
  linear_combination hdet


end OAI.ReflectionFECusp

namespace QRHShort.CloudBatch.ReflectionFE

theorem norm_cubicSymbol_primary (a x : O) (ha : IsPrimary a)
    (hcop : IsCoprime x a) : ‖cubicSymbol (principal a) x‖ = 1 := by
  apply Complex.norm_eq_one_of_pow_eq_one (n := 3) _ (by decide)
  rw [cubicSymbol_primary _ _ ha, ← embedding_pow,
    OAI.ReflectionFEJacobi.symbol_cube_of_isCoprime x a (primary_compat ha) hcop,
    embedding_one]

def lowerCuspMatrix (u : O) : SL(2, O) :=
  ⟨!![1, 0; u, 1], by simp [Matrix.det_fin_two]⟩

def weylCuspMatrix (u : O) : SL(2, O) :=
  ⟨!![u, -1; 1, 0], by simp [Matrix.det_fin_two]⟩

theorem lower_relative_matrix (M : SL(2, O)) (u : O) :
    ((M * (lowerCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) =
      !![M 0 0 - u * M 0 1, M 0 1; M 1 0 - u * M 1 1, M 1 1] := by
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [lowerCuspMatrix, Matrix.adjugate_fin_two, Matrix.mul_apply,
      Fin.sum_univ_two] <;> ring

theorem weyl_relative_matrix (M : SL(2, O)) (u : O) :
    ((M * (weylCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) =
      !![-M 0 1, M 0 0 + u * M 0 1; -M 1 1, M 1 0 + u * M 1 1] := by
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [weylCuspMatrix, Matrix.adjugate_fin_two, Matrix.mul_apply,
      Fin.sum_univ_two] <;> ring

theorem mem_levelThree_iff_entries (M : SL(2, O)) :
    M ∈ OAI.ReflectionFEKubota.levelThree ↔
      ∀ i j : Fin 2, (3 : O) ∣ M i j - (if i = j then 1 else 0) := by
  constructor
  · intro h i j
    exact OAI.ReflectionFEKubota.levelThree_entry ⟨M, h⟩ i j
  · intro h
    change Matrix.SpecialLinearGroup.map (n := Fin 2)
      (Ideal.Quotient.mk (Ideal.span {(3 : O)})) M = 1
    ext i j
    have he := (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
      (Ideal.mem_span_singleton.mpr (h i j))
    simpa only [Matrix.SpecialLinearGroup.map_apply_coe, Matrix.SpecialLinearGroup.coe_one,
      RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.one_apply, apply_ite,
      map_one, map_zero] using he

theorem lower_relative_mem (M : SL(2, O)) (u : O)
    (ha : (3 : O) ∣ M 0 0 - 1) (hb : (3 : O) ∣ M 0 1)
    (hc : (3 : O) ∣ M 1 0 - u) (hd : (3 : O) ∣ M 1 1 - 1) :
    M * (lowerCuspMatrix u)⁻¹ ∈ OAI.ReflectionFEKubota.levelThree := by
  apply (mem_levelThree_iff_entries _).mpr
  intro i j
  change (3 : O) ∣
    (((M * (lowerCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) i j) - _
  rw [lower_relative_matrix]
  fin_cases i <;> fin_cases j
  · convert dvd_sub ha (dvd_mul_of_dvd_right hb u) using 1 <;> simp <;> ring
  · simpa using hb
  · convert dvd_sub hc (dvd_mul_of_dvd_right hd u) using 1 <;> simp <;> ring
  · simpa using hd

theorem weyl_relative_mem (M : SL(2, O)) (u : O)
    (ha : (3 : O) ∣ M 0 0 - u) (hb : (3 : O) ∣ M 0 1 + 1)
    (hc : (3 : O) ∣ M 1 0 - 1) (hd : (3 : O) ∣ M 1 1) :
    M * (weylCuspMatrix u)⁻¹ ∈ OAI.ReflectionFEKubota.levelThree := by
  apply (mem_levelThree_iff_entries _).mpr
  intro i j
  change (3 : O) ∣
    (((M * (weylCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) i j) - _
  rw [weyl_relative_matrix]
  fin_cases i <;> fin_cases j
  · convert dvd_neg.mpr hb using 1 <;> simp <;> ring
  · convert dvd_add ha (dvd_mul_of_dvd_right hb u) using 1 <;> simp <;> ring
  · simpa using dvd_neg.mpr hd
  · convert dvd_add hc (dvd_mul_of_dvd_right hd u) using 1 <;> simp <;> ring

theorem kubotaMultiplier_lower_formula (M : SL(2, O)) (u : O)
    (hM : M * (lowerCuspMatrix u)⁻¹ ∈ OAI.ReflectionFEKubota.levelThree) :
    kubotaMultiplier ⟨M * (lowerCuspMatrix u)⁻¹, hM⟩ =
      cubicSymbol (principal (M 0 0 - u * M 0 1)) (M 1 0 - u * M 1 1) := by
  change cubicSymbol (principal
      (((M * (lowerCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 0 0))
    (((M * (lowerCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 1 0) = _
  rw [lower_relative_matrix]
  rfl

theorem kubotaMultiplier_weyl_formula (M : SL(2, O)) (u : O)
    (hM : M * (weylCuspMatrix u)⁻¹ ∈ OAI.ReflectionFEKubota.levelThree) :
    kubotaMultiplier ⟨M * (weylCuspMatrix u)⁻¹, hM⟩ =
      cubicSymbol (principal (-M 0 1)) (-M 1 1) := by
  change cubicSymbol (principal
      (((M * (weylCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 0 0))
    (((M * (weylCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 1 0) = _
  rw [weyl_relative_matrix]
  rfl

/-- The ramified-cusp factor, including the supplementary multiplier. -/
theorem kubotaMultiplier_factor_ramified (M : SL(2, O)) (u c₀ r : O)
    (hM : M * (lowerCuspMatrix u)⁻¹ ∈ OAI.ReflectionFEKubota.levelThree)
    (ha : IsPrimary (M 0 0)) (hr : IsPrimary r)
    (hc : M 1 0 = u * (c₀ * r)) :
    kubotaMultiplier ⟨M * (lowerCuspMatrix u)⁻¹, hM⟩ =
      (cubicSymbol (principal (M 0 0 - u * M 0 1)) (-u) *
        cubicSymbol (principal (M 0 0)) c₀) * cubicSymbol (principal r) (M 0 0) := by
  have hA := levelThree_primary ⟨M * (lowerCuspMatrix u)⁻¹, hM⟩
  change IsPrimary
    (((M * (lowerCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 0 0) at hA
  rw [lower_relative_matrix] at hA
  change IsPrimary (M 0 0 - u * M 0 1) at hA
  have hdet : M 0 0 * M 1 1 - M 0 1 * (u * (c₀ * r)) = 1 := by
    rw [← hc]
    simpa only [Matrix.det_fin_two] using M.property
  rw [kubotaMultiplier_lower_formula, hc, cubicSymbol_primary _ _ hA,
    OAI.ReflectionFECusp.A3_ramified_global_factor _ _ _ _ _ _ hdet
      (primary_compat ha) (primary_compat hA) (primary_compat hr),
    embedding_mul, embedding_mul, ← cubicSymbol_primary _ _ hA,
    ← cubicSymbol_primary _ _ ha, ← cubicSymbol_primary _ _ hr]

theorem isPrimary_left_of_mul {a b : O} (hab : IsPrimary (a * b))
    (hb : IsPrimary b) : IsPrimary a := by
  apply (isPrimary_iff_three_dvd _).mpr
  have h := dvd_sub ((isPrimary_iff_three_dvd _).mp hab)
    (dvd_mul_of_dvd_right ((isPrimary_iff_three_dvd _).mp hb) a)
  convert h using 1 <;> ring

/-- The unramified-cusp factor. The mod-nine condition is retained explicitly
because it is exactly what removes the supplementary factors. -/
theorem kubotaMultiplier_factor_unramified (M : SL(2, O)) (u c₀ r : O)
    (hM : M * (weylCuspMatrix u)⁻¹ ∈ OAI.ReflectionFEKubota.levelThree)
    (hcprimary : IsPrimary (M 1 0)) (hr : IsPrimary r)
    (hc : M 1 0 = c₀ * r) (h9 : (9 : O) ∣ M 0 0 * M 1 1) :
    kubotaMultiplier ⟨M * (weylCuspMatrix u)⁻¹, hM⟩ =
      cubicSymbol (principal c₀) (M 0 0) * cubicSymbol (principal r) (M 0 0) := by
  have hb := levelThree_primary ⟨M * (weylCuspMatrix u)⁻¹, hM⟩
  change IsPrimary
    (((M * (weylCuspMatrix u)⁻¹ : SL(2, O)) : Matrix (Fin 2) (Fin 2) O) 0 0) at hb
  rw [weyl_relative_matrix] at hb
  change IsPrimary (-M 0 1) at hb
  have hcr : IsPrimary (c₀ * r) := hc ▸ hcprimary
  have hc₀ := isPrimary_left_of_mul hcr hr
  have hdet : M 0 0 * M 1 1 - M 0 1 * (c₀ * r) = 1 := by
    rw [← hc]
    simpa only [Matrix.det_fin_two] using M.property
  rw [kubotaMultiplier_weyl_formula, cubicSymbol_primary _ _ hb,
    OAI.ReflectionFECusp.A3_unramified_global_factor _ _ _ _ _ hdet
      (primary_compat hb) (primary_compat hcr) h9,
    embedding_mul, ← cubicSymbol_primary _ _ hc₀, ← cubicSymbol_primary _ _ hr]

theorem principal_fixed_factor_congr (M c₀ a a₀ : O)
    (h9 : (9 : O) ∣ M) (ha : IsPrimary a) (ha₀ : IsPrimary a₀)
    (hsector : M * c₀ ∣ a - a₀) :
    cubicSymbol (principal a) c₀ = cubicSymbol (principal a₀) c₀ := by
  rw [cubicSymbol_primary _ _ ha, cubicSymbol_primary _ _ ha₀]
  exact congrArg embedding (OAI.ReflectionFECusp.A3_fixed_factor_congr M c₀ a a₀
    h9 (primary_compat ha) (primary_compat ha₀) hsector)

theorem ramified_fixed_factor_congr (M c₀ u a a₀ b b₀ : O)
    (h9 : (9 : O) ∣ M) (hc : c₀ ∣ M) (hu : u ∣ M)
    (ha : IsPrimary a) (ha₀ : IsPrimary a₀)
    (hA : IsPrimary (a - u * b)) (hA₀ : IsPrimary (a₀ - u * b₀))
    (hma : M ∣ a - a₀) (hmb : M ∣ b - b₀) :
    cubicSymbol (principal (a - u * b)) (-u) * cubicSymbol (principal a) c₀ =
      cubicSymbol (principal (a₀ - u * b₀)) (-u) * cubicSymbol (principal a₀) c₀ := by
  rw [cubicSymbol_primary _ _ hA, cubicSymbol_primary _ _ ha,
    cubicSymbol_primary _ _ hA₀, cubicSymbol_primary _ _ ha₀,
    ← embedding_mul, ← embedding_mul]
  exact congrArg embedding (OAI.ReflectionFECusp.A3_ramified_fixed_factor_congr
    M c₀ u a a₀ b b₀ h9 hc hu (primary_compat ha) (primary_compat ha₀)
    (primary_compat hA) (primary_compat hA₀) hma hmb)

theorem norm_principal_fixed_factor (a b c₀ r d : O)
    (hdet : a * d - b * (c₀ * r) = 1) (ha : IsPrimary a) :
    ‖cubicSymbol (principal a) c₀‖ = 1 := by
  apply norm_cubicSymbol_primary _ _ ha
  refine ⟨-b * r, d, ?_⟩
  linear_combination hdet

theorem norm_ramified_fixed_factor (a b c₀ r d u : O)
    (hdet : a * d - b * (u * (c₀ * r)) = 1)
    (ha : IsPrimary a) (hA : IsPrimary (a - u * b)) :
    ‖cubicSymbol (principal (a - u * b)) (-u) * cubicSymbol (principal a) c₀‖ = 1 := by
  have hfirst : ‖cubicSymbol (principal (a - u * b)) (-u)‖ = 1 := by
    apply norm_cubicSymbol_primary _ _ hA
    refine ⟨b * (c₀ * r - d), d, ?_⟩
    linear_combination hdet
  have hsecond : ‖cubicSymbol (principal a) c₀‖ = 1 := by
    apply norm_cubicSymbol_primary _ _ ha
    refine ⟨-b * u * r, d, ?_⟩
    linear_combination hdet
  rw [norm_mul, hfirst, hsecond, one_mul]

theorem norm_unramified_fixed_factor (a b c₀ r d : O)
    (hdet : a * d - b * (c₀ * r) = 1) (hc : IsPrimary c₀) :
    ‖cubicSymbol (principal c₀) a‖ = 1 := by
  apply norm_cubicSymbol_primary _ _ hc
  refine ⟨d, -b * r, ?_⟩
  linear_combination hdet

