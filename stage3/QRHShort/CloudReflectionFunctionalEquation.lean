      ramifiedDifference_prime_power_vanish T P hT0 hP (ramifiedOmegaUnit ^ a.val) (r.val + 2) hFT
  have hparts := thetaParts_mul_cube T (OAI.CompletedGauss.primaryGenerator_ne_zero_ideal T hT0) hv
  let I := thetaSquarefreePart T
  let J := thetaCubePart T
  let n := OAI.CompletedGauss.primaryGenerator I
  let b := OAI.CompletedGauss.primaryGenerator J
  have hgen : m = n * b ^ 3 := by
    rw [← hT]
    change OAI.CompletedGauss.primaryGenerator T =
