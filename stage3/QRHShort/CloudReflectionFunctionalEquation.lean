  obtain ⟨N, pool, hp⟩ := exists_three_cusp_completion_pool M c₀ hM hc₀ h₃
  refine ⟨N, pool, ?_⟩
  intro a r hr har
  obtain ⟨i, g, G, ha, hc, _, _, hd, hf⟩ := hp a r hr har
  exact ⟨i, g, G, ha, hc, hd, norm_kubotaMultiplier G,
    sourceResidual_three_transform g G (pool i).rational (pool i).cusp hf⟩

