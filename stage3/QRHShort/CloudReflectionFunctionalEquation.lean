  Quotient.lift (fun m : O => Ideal.Quotient.mk (principal (q * B)) (q * m))
    (fun x y hxy => by
      apply Ideal.Quotient.eq.mpr
      have hmem : x - y ∈ principal B := Ideal.Quotient.eq.mp
