theorem sourceDirichletTerm_differentiable (c : ArithmeticContext)
    (Ψ : Ideal O → ℂ) (nb : Ideal O × Ideal O) :
    Differentiable ℂ (fun s : ℂ => sourceDirichletTerm c Ψ s nb) := by
  by_cases hnb : SquarefreeOutside c.S nb.1 ∧ Outside c.S nb.2
  · have hn0 : (normIdeal nb.1 : ℂ) ≠ 0 := by
      exact_mod_cast (ne_of_gt (ideal_norm_pos hnb.1.1.1))
    have hb0 : (normIdeal nb.2 : ℂ) ≠ 0 := by
      exact_mod_cast (ne_of_gt (ideal_norm_pos hnb.2.1))
    have hn : Differentiable ℂ (fun s : ℂ => (normIdeal nb.1 : ℂ) ^ (-s)) :=
      differentiable_id.neg.const_cpow (Or.inl hn0)
    have hb : Differentiable ℂ
