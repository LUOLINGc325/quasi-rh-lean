/- Frozen actual pools and pure ramified profiles fragment ReflectionCuspPrimaryTail.lean SHA256 346aac761645adafd0037e471ff8e34b3d13cee7c5480c5e2bf76bac851b203e -/



noncomputable section
open Classical

namespace QRHShort.CloudBatch.ReflectionCuspPrimaryTail
open ReflectionFE ReflectionResidual ReflectionSourceRamified ReflectionCuspPrimaryNineRows
open ReflectionCuspPrimarySeries ReflectionRamifiedPhysicalThree ReflectionZeroCuspPhysicalScale
open OAI.CubicEisenstein
local notation "lam" => OAI.ActualEisensteinCubic.lambda

def primaryPhysicalTerm (c : O) (h₃ : (3 : O) ∣ c)
    (u : Oˣ) (n : ℕ) (t q : O) (V : ℝ) (h : O) : ℂ :=
  primaryWeightedZeroRow c h₃ u n t h * normalizedPhysicalPrefactor q c *
    sourceCuspZTerm 0 0 V h

def primaryDeepTerm (c : O) (h₃ : (3 : O) ∣ c)
    (u : Oˣ) (n : ℕ) (t q : O) (V : ℝ) (h : O) : ℂ :=
  if 3 * c ∣ h then primaryPhysicalTerm c h₃ u n t q V h else 0

def primaryBoundaryTerm (c : O) (h₃ : (3 : O) ∣ c)
    (u : Oˣ) (n : ℕ) (t q : O) (V : ℝ) (h : O) : ℂ :=
  if 3 * c ∣ h then 0 else primaryPhysicalTerm c h₃ u n t q V h

theorem primaryPhysicalTerm_summable (c : O) (hc : c ≠ 0) (h₃ : (3 : O) ∣ c)
    (u : Oˣ) (n : ℕ) (t q : O) (V : ℝ) (hV : 0 < V) :
    Summable (primaryPhysicalTerm c h₃ u n t q V) := by
  apply ((primary_zero_family_summable c hc h₃ u n t V hV).mul_left
    (normalizedPhysicalPrefactor q c)).congr
  intro h
  unfold primaryPhysicalTerm
  ring

theorem primaryDeepTerm_summable (c : O) (hc : c ≠ 0) (h₃ : (3 : O) ∣ c)
    (u : Oˣ) (n : ℕ) (t q : O) (V : ℝ) (hV : 0 < V) :
    Summable (primaryDeepTerm c h₃ u n t q V) := by
  apply (primaryPhysicalTerm_summable c hc h₃ u n t q V hV).norm.of_norm_bounded
  intro h
  unfold primaryDeepTerm
  split_ifs
  · exact le_rfl
  · simp only [norm_zero]; exact norm_nonneg _

theorem primaryBoundaryTerm_summable (c : O) (hc : c ≠ 0) (h₃ : (3 : O) ∣ c)
    (u : Oˣ) (n : ℕ) (t q : O) (V : ℝ) (hV : 0 < V) :
    Summable (primaryBoundaryTerm c h₃ u n t q V) := by
  apply (primaryPhysicalTerm_summable c hc h₃ u n t q V hV).norm.of_norm_bounded
  intro h
  unfold primaryBoundaryTerm
  split_ifs
  · simp only [norm_zero]; exact norm_nonneg _
  · exact le_rfl

theorem primary_family_deep_boundary (c : O) (hc : c ≠ 0) (h₃ : (3 : O) ∣ c)
    (u : Oˣ) (n : ℕ) (t q : O) (V : ℝ) (hV : 0 < V) :
    normalizedPhysicalPrefactor q c * primaryZeroCuspFamily c h₃ u n t V =
      (∑' h : O, primaryDeepTerm c h₃ u n t q V h) +
        ∑' h : O, primaryBoundaryTerm c h₃ u n t q V h := by
  rw [← (primaryDeepTerm_summable c hc h₃ u n t q V hV).tsum_add
    (primaryBoundaryTerm_summable c hc h₃ u n t q V hV),
    primary_zero_family_series c hc h₃ u n t V hV, ← tsum_mul_left]
  apply tsum_congr
  intro h
  unfold primaryDeepTerm primaryBoundaryTerm primaryPhysicalTerm
  split_ifs <;> ring

/-- Reindexing retains exactly the divisible-frequency part of the actual
upper row. No complement is confused with a finite set of frequencies. -/
theorem primary_deep_reindex (c k : O) (hk : k ≠ 0)
    (h₃ : (3 : O) ∣ c * k) (u : Oˣ) (n : ℕ) (t q : O) (V : ℝ) :
    (∑' H : O, primaryDeepTerm (c * k) h₃ u n t q V H) =
      ∑' h : O, if 3 * c ∣ h then
        primaryPhysicalTerm (c * k) h₃ u n t q V (h * k) else 0 := by
  have hi : Function.Injective (fun h : O => h * k) := fun _ _ he => mul_right_cancel₀ hk he
  have hs : Function.support (primaryDeepTerm (c * k) h₃ u n t q V) ⊆
      Set.range (fun h : O => h * k) := by
    intro H hH
    by_cases hd : 3 * (c * k) ∣ H
    · obtain ⟨a, ha⟩ := hd
      refine ⟨3 * c * a, ?_⟩
      rw [ha]
      ring
    · exact (hH (by simp only [primaryDeepTerm, if_neg hd])).elim
  rw [← hi.tsum_eq hs]
  apply tsum_congr
  intro h
  have hd : 3 * (c * k) ∣ h * k ↔ 3 * c ∣ h := by
    constructor
    · rintro ⟨a, ha⟩
      refine ⟨a, ?_⟩
      apply mul_right_cancel₀ hk
      linear_combination ha
    · rintro ⟨a, ha⟩
      refine ⟨a, ?_⟩
      rw [ha]
      ring
  simp only [primaryDeepTerm, hd]

/-- All deep frequencies in the two actual physical rows are paired. The
upper sum is first reindexed, and absolute convergence justifies subtraction.
The result keeps the growing mode E explicitly; its literal tau matching is
a separate remaining arithmetic obligation. -/
theorem primary_deep_series_difference (v u : Oˣ) (ns js nc jc : ℕ)
    (hnc : 2 ≤ nc)
    (hvunit : (v : O) = omega ^ js ∨ (v : O) = -(omega ^ js))
    (hu : (u : O) = omega ^ jc ∨ (u : O) = -(omega ^ jc))
    (t l q : O) (hq : q ≠ 0)
    (hl : 3 * l = t * ((u : O) * lam ^ nc)) (V : ℝ) (hV : 0 < V) :
    (∑' H : O, primaryDeepTerm ((u : O) * lam ^ (nc + 3))
      (ramifiedElement_level u (nc + 3) (by omega)) v (ns + 3) t (q * lam ^ 3)
        (V / ‖embedding (lam ^ 3)‖) H) -
      ((Real.sqrt 3 : ℂ) / 3) *
        (∑' h : O, primaryDeepTerm ((u : O) * lam ^ nc)
          (ramifiedElement_level u nc hnc) v ns t q V h) =
      ∑' h : O, if 3 * ((u : O) * lam ^ nc) ∣ h then
        primaryWeightedZeroRow ((u : O) * lam ^ nc)
          (ramifiedElement_level u nc hnc) v ns t h * star (ramifiedDifferenceCoefficient h) *
          (normalizedPhysicalPrefactor q ((u : O) * lam ^ nc) * zeroCuspKernel 0 V h)
        else 0 := by
  have hk : lam ^ 3 ≠ 0 := pow_ne_zero _ OAI.PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero
  have hc' : (u : O) * lam ^ (nc + 3) = ((u : O) * lam ^ nc) * lam ^ 3 := by
    rw [pow_add]
    ring
  have hV' : 0 < V / ‖embedding (lam ^ 3)‖ :=
    div_pos hV (norm_pos_iff.mpr (embedding_eq_zero.not.mpr hk))
  have hs' := (primaryDeepTerm_summable _ (ramifiedElement_ne_zero u (nc + 3))
    (ramifiedElement_level u (nc + 3) (by omega)) v (ns + 3) t (q * lam ^ 3) _ hV').comp_injective
      (fun _ _ he => mul_right_cancel₀ hk he : Function.Injective (fun h : O => h * lam ^ 3))
  simp only [Function.comp_def] at hs'
  have hs := (primaryDeepTerm_summable _ (ramifiedElement_ne_zero u nc)
    (ramifiedElement_level u nc hnc) v ns t q V hV).mul_left ((Real.sqrt 3 : ℂ) / 3)
  have hreindex := primary_deep_reindex ((u : O) * lam ^ nc) (lam ^ 3) hk
    (hc' ▸ ramifiedElement_level u (nc + 3) (by omega)) v (ns + 3) t (q * lam ^ 3)
      (V / ‖embedding (lam ^ 3)‖)
  simp only [← hc'] at hreindex
  have he (h : O) : primaryDeepTerm ((u : O) * lam ^ (nc + 3))
      (ramifiedElement_level u (nc + 3) (by omega)) v (ns + 3) t (q * lam ^ 3)
        (V / ‖embedding (lam ^ 3)‖) (h * lam ^ 3) -
      ((Real.sqrt 3 : ℂ) / 3) * primaryDeepTerm ((u : O) * lam ^ nc)
        (ramifiedElement_level u nc hnc) v ns t q V h =
      if 3 * ((u : O) * lam ^ nc) ∣ h then
        primaryWeightedZeroRow ((u : O) * lam ^ nc)
          (ramifiedElement_level u nc hnc) v ns t h * star (ramifiedDifferenceCoefficient h) *
          (normalizedPhysicalPrefactor q ((u : O) * lam ^ nc) * zeroCuspKernel 0 V h) else 0 := by
    have hd : 3 * ((u : O) * lam ^ (nc + 3)) ∣ h * lam ^ 3 ↔
        3 * ((u : O) * lam ^ nc) ∣ h := by
      rw [hc', ← mul_assoc]
      exact mul_dvd_mul_iff_right hk
    by_cases hh : 3 * ((u : O) * lam ^ nc) ∣ h
    · simp only [primaryDeepTerm, hd, if_pos hh, primaryPhysicalTerm]
      simpa only [zero_div, mul_assoc] using primaryWeightedZeroRow_physical_difference_of_two
        v u ns js nc jc hnc hvunit hu t h l q hq hh hl 0 V hV
    · simp only [primaryDeepTerm, hd, if_neg hh, mul_zero, sub_self]
  have hsum : (∑' H : O, primaryDeepTerm ((u : O) * lam ^ (nc + 3))
      (ramifiedElement_level u (nc + 3) (by omega)) v (ns + 3) t (q * lam ^ 3)
        (V / ‖embedding (lam ^ 3)‖) H) =
      ∑' h : O, primaryDeepTerm ((u : O) * lam ^ (nc + 3))
      (ramifiedElement_level u (nc + 3) (by omega)) v (ns + 3) t (q * lam ^ 3)
        (V / ‖embedding (lam ^ 3)‖) (h * lam ^ 3) := by
    rw [hreindex]
    apply tsum_congr
    intro h
    have hd : 3 * ((u : O) * lam ^ (nc + 3)) ∣ h * lam ^ 3 ↔
        3 * ((u : O) * lam ^ nc) ∣ h := by
      rw [hc', ← mul_assoc]
      exact mul_dvd_mul_iff_right hk
    simp only [primaryDeepTerm, hd]
  rw [hsum, ← tsum_mul_left, ← hs'.tsum_sub hs]
  exact tsum_congr he

end QRHShort.CloudBatch.ReflectionCuspPrimaryTail







