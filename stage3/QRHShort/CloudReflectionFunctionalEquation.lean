    ContinuousOn (finiteRescaledCuspProfile g A Q) (Ioi 0) := by
  apply continuousOn_finsetSum
  intro i hi
  exact continuousOn_const.mul ((hg i).comp (continuousOn_id.div_const _)
    (fun v hv => div_pos hv (hQ i)))

theorem finiteRescaledCuspProfile_exponential {ι : Type*} [Fintype ι]
    (g : ι → ℝ → ℂ) (A : ι → ℂ) (Q : ι → ℝ) (hQ : ∀ i, 0 < Q i)
    (hg : ∀ i, ∃ d : ℝ, 0 < d ∧ g i =O[atTop] (fun v : ℝ => Real.exp (-d * v))) :
    ∃ δ : ℝ, 0 < δ ∧ finiteRescaledCuspProfile g A Q =O[atTop]
      (fun v : ℝ => Real.exp (-δ * v)) := by
  choose d hd hb using hg
  obtain ⟨δ, hδ, hle⟩ := finite_positive_lower_bound Finset.univ
    (fun i => d i / Q i) (fun i _ => div_pos (hd i) (hQ i))
  refine ⟨δ, hδ, ?_⟩
  have hterm (i : ι) : (fun v : ℝ => A i * g i (v / Q i)) =O[atTop]
      (fun v : ℝ => Real.exp (-δ * v)) := by
    have hcomp := (hb i).comp_tendsto (tendsto_id.atTop_div_const (hQ i))
    have he : (fun v : ℝ => Real.exp (-d i * (v / Q i))) =O[atTop]
        (fun v : ℝ => Real.exp (-δ * v)) := by
      apply IsBigO.of_norm_eventuallyLE
      filter_upwards [eventually_ge_atTop (0 : ℝ)] with v hv
      simp only [Real.norm_eq_abs, Real.abs_exp]
      apply Real.exp_le_exp.mpr
      have hh := mul_le_mul_of_nonneg_right (hle i (Finset.mem_univ i)) hv
      calc
        -d i * (v / Q i) = -(d i / Q i * v) := by ring
        _ ≤ -δ * v := by linarith
    exact (hcomp.trans he).const_mul_left (A i)
  have he : (∑ i, (fun v : ℝ => A i * g i (v / Q i))) =
      finiteRescaledCuspProfile g A Q := by
    funext v
    simp only [finiteRescaledCuspProfile, Finset.sum_apply]
