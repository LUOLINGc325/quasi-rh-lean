            ((lowRamifiedQuotientCoord a 0 s j ⟨n.val, by omega⟩).2 : ℂ) / 9) *
          unramifiedGaussResidue (om ^ ((a.val + j.val + 1) % 3) * lam ^ ((n.val + 8) % 3))
