theorem finite_positive_lower_bound {ι : Type*} (S : Finset ι) (d : ι → ℝ)
    (hd : ∀ i ∈ S, 0 < d i) : ∃ δ : ℝ, 0 < δ ∧ ∀ i ∈ S, δ ≤ d i := by
  induction S using Finset.induction_on with
  | empty => exact ⟨1, zero_lt_one, by simp⟩
  | @insert i S hi ih =>
    obtain ⟨δ, hδ, hle⟩ := ih (fun j hj => hd j (Finset.mem_insert_of_mem hj))
    refine ⟨min δ (d i), lt_min hδ (hd i (Finset.mem_insert_self i S)), ?_⟩
    intro j hj
    rcases Finset.mem_insert.mp hj with rfl | hj
    · exact min_le_right _ _
    · exact (min_le_left _ _).trans (hle j hj)

def finiteRescaledCuspProfile {ι : Type*} [Fintype ι]
    (g : ι → ℝ → ℂ) (A : ι → ℂ) (Q : ι → ℝ) (v : ℝ) : ℂ :=
  ∑ i, A i * g i (v / Q i)

