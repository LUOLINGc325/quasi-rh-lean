silently changed to h. Absolute convergence is inherited from the actual row. -/
theorem controlled_zero_literal_row (c : ArithmeticContext)
    (D : ControlledStratumArithmetic p N a₀ c₀ mode)
    (hN : (9 : O) * c₀ ∣ N)
    (hr : OAI.ActualEisensteinCubic.lambda ^ 2 ∣ (∏ i, p i) - 1)
    (hbase : if mode then OAI.ActualEisensteinCubic.lambda ^ 2 ∣ a₀ - 1
      else OAI.ActualEisensteinCubic.lambda ^ 2 ∣ c₀ - 1)
    (hp : ∀ i, p i ≠ 0) (hc₀ : c₀ ≠ 0)
    (hP : ∀ i, Prime (Ideal.span {p i} : Ideal O))
    (hout : ∀ i, Outside c.S (Ideal.span {p i}))
    (hcop : Pairwise (Function.onFun IsCoprime (fun i => (Ideal.span {p i} : Ideal O))))
    (j : ι → Fin 6) (v : ℝ) (hv : 0 < v) :
    ‖controlledActiveScalar c D hp hP hout j‖ = 1 ∧
      Summable (fun h : O =>
        (fixedResiduePhase c₀ hc₀
          (Ideal.Quotient.mk _ (-(D.matrix (fun _ => 1) 1 1) * D.U)) (lambda * h) *
          ∏ i, thetaLocalFactor (Ideal.span {p i}) (j i) (lambda * h)) *
            sourceCuspZTerm 0 0 v h) ∧
      (∑ u : ∀ i, (O ⧸ Ideal.span {p i})ˣ,
        (ControlledStratumArithmetic.fourierWeight hp
          (fun i => outside_lambda_not_mem c (hP i) (hout i)) (fun i => (j i).val) u *
          star (OAI.CubicKubota.complexCharacter (D.relativeGamma hN hr hbase u))) *
          sourceCuspZFamily 0
            (-embedding (D.matrix u 1 1) / embedding (c₀ * ∏ i, p i)) v) =
        controlledActiveScalar c D hp hP hout j *
          ∑' h : O, (fixedResiduePhase c₀ hc₀
            (Ideal.Quotient.mk _ (-(D.matrix (fun _ => 1) 1 1) * D.U)) (lambda * h) *
            ∏ i, thetaLocalFactor (Ideal.span {p i}) (j i) (lambda * h)) *
              sourceCuspZTerm 0 0 v h := by
  have hn := controlledActiveScalar_norm c D hN hr hbase hp hP hout j
  have hγ : controlledActiveScalar c D hp hP hout j ≠ 0 := by
    intro hz
