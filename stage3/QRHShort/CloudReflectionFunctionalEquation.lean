  cases s
  · rw [signedOmegaUnit_val]
    simp only [Bool.false_eq_true, ite_false]
    rw [hp, ramifiedLinearChar_coordinates _ _ _ hu]
    fin_cases j <;> fin_cases n <;> simp_all [smallCoordinates, cubicExp]
  · rw [signedOmegaUnit_val]
    simp only [ite_true, neg_mul]
