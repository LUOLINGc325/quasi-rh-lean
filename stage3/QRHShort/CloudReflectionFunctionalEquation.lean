      Summable (shiftedTauZTerm (ramifiedUpShift i) (zeroResidueMultiplier K C i B ψ A j) t) :=
    (shiftedTauZSeries_reindex _ (ramifiedUpShift_ne_zero i) _ _ 0 (hnonneg i)
