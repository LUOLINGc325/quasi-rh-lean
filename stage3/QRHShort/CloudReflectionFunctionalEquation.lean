/- Frozen boundary and auxiliary fragment ReflectionCuspAuxiliaryMasks.lean SHA256 e01cf262253d6adc00c00c5febf6c8dec398b4b8b55256209cb2eb6e6a8487f0 -/




noncomputable section
open Classical

namespace QRHShort.CloudBatch.ReflectionCuspAuxiliaryMasks
open ReflectionFE ReflectionResidual ReflectionCuspIntegralScale ReflectionCuspRamifiedScales
open ReflectionCuspPhasePool ReflectionRamifiedControlledProfile ReflectionRamifiedCuspProfile
open ReflectionSourceProjectionLift ReflectionSourceProjectionWeightBounds
open OAI.CubicEisenstein

/-- The six-by-nine coefficient and the controlled bad phase have a common
fixed conductor independent of the active prime set. -/
def auxiliaryBadModulus (c₀ : O) : O := 27 * phaseModulus c₀

theorem auxiliaryBadModulus_ne_zero (c₀ : O) (hc₀ : c₀ ≠ 0) :
    auxiliaryBadModulus c₀ ≠ 0 :=
  mul_ne_zero (by norm_num) (phaseModulus_ne_zero c₀ hc₀)

theorem fixedResiduePhase_eq_of_dvd_sub (c₀ : O) (hc₀ : c₀ ≠ 0)
    (b : O ⧸ Ideal.span {phaseModulus c₀}) (x y : O)
    (hxy : phaseModulus c₀ ∣ x - y) :
    fixedResiduePhase c₀ hc₀ b x = fixedResiduePhase c₀ hc₀ b y := by
  unfold fixedResiduePhase
  have hmk : Ideal.Quotient.mk (Ideal.span {phaseModulus c₀}) x =
      Ideal.Quotient.mk (Ideal.span {phaseModulus c₀}) y :=
    Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr hxy)
  rw [hmk]

def auxiliaryBadResidue (C : RamifiedNineGroup → ℂ) (side : Bool)
    (i : RamifiedSixBranch) (j : RamifiedNineGroup)
    (c₀ : O) (hc₀ : c₀ ≠ 0) (b : O ⧸ Ideal.span {phaseModulus c₀})
    (a : O ⧸ principal (auxiliaryBadModulus c₀)) : ℂ :=
  star (ramifiedCuspTauWeight C side i j
    (auxiliaryNativeIndex (residueLift (principal (auxiliaryBadModulus c₀)) a))) *
      fixedResiduePhase c₀ hc₀ b (residueLift (principal (auxiliaryBadModulus c₀)) a)

theorem auxiliaryBadResidue_mk (C : RamifiedNineGroup → ℂ) (side : Bool)
    (i : RamifiedSixBranch) (j : RamifiedNineGroup)
    (c₀ : O) (hc₀ : c₀ ≠ 0) (b : O ⧸ Ideal.span {phaseModulus c₀}) (x : O) :
    auxiliaryBadResidue C side i j c₀ hc₀ b
        (Ideal.Quotient.mk (principal (auxiliaryBadModulus c₀)) x) =
      star (ramifiedCuspTauWeight C side i j (auxiliaryNativeIndex x)) *
        fixedResiduePhase c₀ hc₀ b x := by
  let y := residueLift (principal (auxiliaryBadModulus c₀))
    (Ideal.Quotient.mk (principal (auxiliaryBadModulus c₀)) x)
  have hxy : auxiliaryBadModulus c₀ ∣ y - x :=
    Ideal.mem_span_singleton.mp (Ideal.Quotient.eq.mp (residueLift_spec _ _))
  have h27 : (27 : O) ∣ y - x := (dvd_mul_right 27 (phaseModulus c₀)).trans hxy
  have hM : phaseModulus c₀ ∣ y - x := (dvd_mul_left (phaseModulus c₀) 27).trans hxy
  have hidx : (27 : O) ∣ auxiliaryNativeIndex y - auxiliaryNativeIndex x := by
    have hh := dvd_mul_of_dvd_right h27 (-lambda)
    convert hh using 1 <;> simp only [auxiliaryNativeIndex] <;> ring
  change star (ramifiedCuspTauWeight C side i j (auxiliaryNativeIndex y)) *
    fixedResiduePhase c₀ hc₀ b y = _
  rw [ramifiedCuspTauWeight_eq_of_dvd_sub C side i j _ _ hidx,
    fixedResiduePhase_eq_of_dvd_sub c₀ hc₀ b y x hM]

theorem auxiliaryBadResidue_norm_bound (C : RamifiedNineGroup → ℂ) (side : Bool)
    (i : RamifiedSixBranch) (j : RamifiedNineGroup)
    (c₀ : O) (hc₀ : c₀ ≠ 0) (b : O ⧸ Ideal.span {phaseModulus c₀})
    (a : O ⧸ principal (auxiliaryBadModulus c₀)) :
    ‖auxiliaryBadResidue C side i j c₀ hc₀ b a‖ ≤ ramifiedProfileWeightBound C side i j := by
  rw [auxiliaryBadResidue, norm_mul, norm_star, fixedResiduePhase_norm, mul_one]
  exact ramifiedCuspTauWeight_norm_bound C side i j _

/-- The actual integral trace-lambda is supported at the arithmetic context's
bad primes; this is proved from its divisor relation with three. -/
theorem supported_unit_trace_power (c : ArithmeticContext) (u : Oˣ) (n : ℕ)
    (p : Ideal O) (hp : Prime p) (hd : p ∣ principal ((u : O) * lambda ^ n)) : p ∈ c.S := by
  letI : p.IsPrime := Ideal.isPrime_of_prime hp
  have hmem : (u : O) * lambda ^ n ∈ p :=
    (Ideal.dvd_iff_le.mp hd) (Ideal.subset_span (by simp))
  have hpow : lambda ^ n ∈ p := (Ideal.IsPrime.mem_or_mem inferInstance hmem).resolve_left
    (Ideal.notMem_of_isUnit p u.isUnit)
  have hl : lambda ∈ p := Ideal.IsPrime.mem_of_pow_mem inferInstance n hpow
  have hl3 : lambda ∣ (3 : O) := by
    change ramifiedTraceLambda ∣ (3 : O)
    rw [trace_eq_ramifiedUnit]
    apply traceRamifiedUnit.isUnit.mul_left_dvd.mpr
    exact (show OAI.ActualEisensteinCubic.lambda ∣ OAI.ActualEisensteinCubic.lambda ^ 2 from
      ⟨OAI.ActualEisensteinCubic.lambda, by ring⟩).trans
      OAI.ActualEisensteinCubic.lambda_sq_dvd_three
  apply c.above_three p hp
  apply Ideal.dvd_iff_le.mpr
  change Ideal.span {(3 : O)} ≤ p
  apply Ideal.span_le.mpr
  intro x hx
  simp only [Set.mem_singleton_iff] at hx
  subst x
  exact p.mem_of_dvd hl3 hl

theorem supported_adjusted_shift (c : ArithmeticContext) (u : Oˣ) (m n : ℕ)
    (p : Ideal O) (hp : Prime p) (hd : p ∣ principal (adjustedRamifiedShift u m n)) :
    p ∈ c.S := by
  rw [adjustedRamifiedShift_eq] at hd
  exact supported_unit_trace_power c u _ p hp hd

theorem supported_auxiliary_decimation (c : ArithmeticContext) (u : Oˣ) (m n : ℕ)
    (p : Ideal O) (hp : Prime p)
    (hd : p ∣ principal (auxiliaryTemplateShift (adjustedRamifiedShift u m n))) : p ∈ c.S := by
  have he : auxiliaryTemplateShift (adjustedRamifiedShift u m n) =
      (u : O) * lambda ^ (2 + (n + 2 * (2 * m + n))) := by
    rw [auxiliaryTemplateShift, adjustedRamifiedShift_eq, pow_add]
    ring
  rw [he] at hd
  exact supported_unit_trace_power c u _ p hp hd

/-- The full decimation mask is an actual quotient function with the same
uniform bound. The moving fixed-phase residue does not affect that bound. -/
theorem lifted_auxiliaryBadResidue_norm_bound (C : RamifiedNineGroup → ℂ) (side : Bool)
    (i : RamifiedSixBranch) (j : RamifiedNineGroup)
    (c₀ : O) (hc₀ : c₀ ≠ 0) (b : O ⧸ Ideal.span {phaseModulus c₀})
    (q : O) (hq : q ≠ 0)
    (a : O ⧸ principal (q * auxiliaryBadModulus c₀)) :
    ‖projectedQuotientMultiplier q hq (auxiliaryBadModulus c₀)
      (auxiliaryBadResidue C side i j c₀ hc₀ b) a‖ ≤ ramifiedProfileWeightBound C side i j :=
  projectedQuotientMultiplier_norm_bound q hq _ _ _
    (auxiliaryBadResidue_norm_bound C side i j c₀ hc₀ b) a

end QRHShort.CloudBatch.ReflectionCuspAuxiliaryMasks









end
