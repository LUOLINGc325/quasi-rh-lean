local notation "O" => OAI.ActualEisensteinCubic.O
local notation "lam" => OAI.ActualEisensteinCubic.lambda
local notation "delta" => QRHShort.lambda

theorem cube_eq_three_trace : lam ^ 3 = 3 * delta := by
  change (QRHShort.omega - 1) ^ 3 = 3 * (1 + 2 * QRHShort.omega)
  linear_combination (QRHShort.omega - 4) * QRHShort.omega_sq_add_omega_add_one

theorem cubeData_lower {M : SL(2,O)} {p q : O}
    (d : RamifiedCubeCuspData M p q) (hp : p ≠ 0) :
    d.matrix 1 0 = p ^ (3 - d.exponent.val) * M 1 0 := by
  apply mul_left_cancel₀ (pow_ne_zero d.exponent.val hp)
  rw [← d.second, ← mul_assoc, ← pow_add, Nat.add_sub_of_le (by omega : d.exponent.val ≤ 3)]

theorem matrix_column_coprime (M : SL(2,O)) : IsCoprime (M 0 0) (M 1 0) := by
  refine ⟨M 1 1, -M 0 1, ?_⟩
  have hd : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
    simpa only [Matrix.det_fin_two] using M.property
  linear_combination hd

/-- A first entry divisible by three forces one of the two highest
lambda-cube strata. This uses primitivity of the actual completed column. -/
theorem cubeData_exponent_ge_two {M : SL(2,O)} {q : O}
    (d : RamifiedCubeCuspData M lam q) (ha : (3 : O) ∣ M 0 0) :
    2 ≤ d.exponent.val := by
  by_contra hn
  have hj : d.exponent.val = 0 ∨ d.exponent.val = 1 := by omega
  have h3 : (3 : O) ∣ M 0 0 + 3 * q * M 1 0 :=
    dvd_add ha (by use q * M 1 0; ring)
  have hl2 : lam ^ 2 ∣ M 0 0 + 3 * q * M 1 0 := lambda_sq_dvd_three.trans h3
  have htop : lam ∣ d.matrix 0 0 := by
    rcases hj with hj | hj
    · have hf := d.first
      simp only [hj, pow_zero, one_mul] at hf
      rw [hf] at hl2
      exact (dvd_pow_self lam (by decide : (2 : ℕ) ≠ 0)).trans hl2
    · have hf := d.first
      simp only [hj, pow_one] at hf
      rw [hf, pow_two] at hl2
      exact (mul_dvd_mul_iff_left PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero).mp hl2
  have hbottom : lam ∣ d.matrix 1 0 := by
    rw [cubeData_lower d PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero]
    exact dvd_mul_of_dvd_left (dvd_pow_self lam (by omega : 3 - d.exponent.val ≠ 0)) _
  exact PrimaryIdealUnitReindex.lambda_prime_actual.not_isUnit
    ((matrix_column_coprime d.matrix).isUnit_of_dvd' htop hbottom)

theorem cubeData_three_trace_relation {M : SL(2,O)} {q a₀ : O}
    (d : RamifiedCubeCuspData M lam q) (ha : M 0 0 = 3 * a₀)
    (hj : d.exponent.val = 3) :
    a₀ + q * M 1 0 = delta * d.matrix 0 0 := by
  have hf := d.first
  rw [ha, hj, cube_eq_three_trace] at hf
  apply mul_left_cancel₀ (by norm_num : (3 : O) ≠ 0)
  linear_combination hf

/-- On the exponent-three stratum the cube in the numerator is genuinely
trivial in the original cubic symbol; the ordinary factor is unchanged. -/
theorem cubeData_three_symbol {M : SL(2,O)} {q : O}
    (d : RamifiedCubeCuspData M lam q)
    (hc : lam ^ 2 ∣ M 1 0 - 1) (hj : d.exponent.val = 3) :
    symbol (d.matrix 0 0) (M 1 0) = symbol (M 0 0) (M 1 0) := by
  have hl : lam ∣ (3 : O) :=
    (dvd_pow_self lam (by decide : (2 : ℕ) ≠ 0)).trans lambda_sq_dvd_three
  have hcop : IsCoprime lam (M 1 0) :=
    ((primary_coprime_three _ hc).of_isCoprime_of_dvd_right hl).symm
  have hf := d.first
  rw [hj] at hf
  have hs : symbol (lam ^ 3 * d.matrix 0 0) (M 1 0) = symbol (M 0 0) (M 1 0) := by
    apply symbol_congr
    refine ⟨3 * q, ?_⟩
    linear_combination -hf
  simpa only [symbol_mul_numerator _ _ _ hc, symbol_pow_numerator _ _ hc,
    symbol_cube_of_isCoprime _ _ hc hcop, one_mul] using hs

end QRHShort.CloudBatch.ReflectionRamifiedCubeHighColumns







