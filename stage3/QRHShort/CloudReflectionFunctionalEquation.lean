    intro hh
    have he : eisEmbedding w = -2 := by linear_combination -hh
    have hp := congrArg eisEmbedding ramified_omega_relation
    norm_num only [map_add, map_pow, map_one, map_zero] at hp
    rw [he] at hp
    norm_num at hp
