      wirtingerBar (fun w => liftedConjugateResidual q₁ hq₁ B hB ψ w v hv) z -
        κ * wirtingerBar (fun w => liftedConjugateResidual q₂ hq₂ B hB ψ w v hv) z := by
  have h1 (q : O) (hq : q ≠ 0) :=
    liftedConjugateResidual_line_differentiable q hq B hB ψ z 1 v hv
