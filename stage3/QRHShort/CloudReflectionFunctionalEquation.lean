    exact primary_part_eq_of_ramified_eq _ _ _ _ u.isUnit
      ((OAI.ActualEisensteinCubic.omega_primitive.isUnit (by decide)).pow _) hm hN _ _ he'
  · rcases hc with ⟨k, he, _⟩
    have he' := hfreq 1 (3 * k) (by
      simpa only [embedding_one, one_mul, Nat.cast_mul, Nat.cast_ofNat] using he)
    exact ⟨n, b, hnb, primary_part_eq_of_ramified_eq _ _ _ _ u.isUnit isUnit_one hm hN _ _ he'⟩
  · rcases hc with ⟨k, j, hk, he, _⟩
    have he' := hfreq (-(omega ^ j.val)) (3 * k - 1) (by
      have hc : ((3 * k - 1 : ℕ) : ℤ) - 3 = 3 * (k : ℤ) - 4 := by omega
      simpa only [embedding_neg, embedding_pow, neg_one_mul, hc] using he)
    refine ⟨n, b, hnb, ?_⟩
    exact primary_part_eq_of_ramified_eq _ _ _ _ u.isUnit
      (((OAI.ActualEisensteinCubic.omega_primitive.isUnit (by decide)).pow _).neg) hm hN _ _ he'
  · rcases hc with ⟨k, he, _⟩
    have he' := hfreq (-1) (3 * k) (by
      simpa only [embedding_neg, embedding_one, neg_one_mul, Nat.cast_mul, Nat.cast_ofNat] using he)
    exact ⟨n, b, hnb, primary_part_eq_of_ramified_eq _ _ _ _ u.isUnit isUnit_neg_one hm hN _ _ he'⟩

