  refine ⟨⟨!![a, -e; c, d], ?_⟩, rfl, rfl⟩
  simp only [Matrix.det_fin_two, Matrix.of_apply, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.cons_val_fin_one]
  linear_combination hde

def cuspMatrix (M c₀ : O) (p : AdmissibleCuspPair M c₀) : SL(2, O) :=
  (exists_cusp_matrix p.val.1 (c₀ * p.val.2) p.property.2).choose

theorem cuspMatrix_spec (M c₀ : O) (p : AdmissibleCuspPair M c₀) :
    cuspMatrix M c₀ p 0 0 = p.val.1 ∧ cuspMatrix M c₀ p 1 0 = c₀ * p.val.2 :=
  (exists_cusp_matrix p.val.1 (c₀ * p.val.2) p.property.2).choose_spec

/-- The representative rows and their matrices are fixed before the varying
numerator or squarefree factor. Both residues are recorded modulo M*c₀,
which also fixes the later finite additive phases. -/
theorem exists_fixed_cusp_completion_pool (M c₀ : O) (hM : M ≠ 0) (hc₀ : c₀ ≠ 0) :
    ∃ N : ℕ, ∃ pool : Fin N → AdmissibleCuspPair M c₀,
      ∀ (a r : O), IsCoprime r (M * c₀) → IsCoprime a (c₀ * r) →
        ∃ i : Fin N, ∃ g : SL(2, O),
          g 0 0 = a ∧ g 1 0 = c₀ * r ∧
          M * c₀ ∣ a - (pool i).val.1 ∧ M * c₀ ∣ r - (pool i).val.2 ∧
          M * c₀ ∣ g 1 1 - cuspMatrix M c₀ (pool i) 1 1 ∧
          (g : Matrix (Fin 2) (Fin 2) O).map (Ideal.Quotient.mk (principal M)) =
            (cuspMatrix M c₀ (pool i) : Matrix (Fin 2) (Fin 2) O).map
              (Ideal.Quotient.mk (principal M)) := by
  have hI : principal (M * c₀) ≠ ⊥ :=
    Ideal.span_singleton_eq_bot.not.mpr (mul_ne_zero hM hc₀)
  letI : Finite (O ⧸ principal (M * c₀)) := Ring.HasFiniteQuotients.finiteQuotient hI
  let Q := (O ⧸ principal (M * c₀)) × (O ⧸ principal (M * c₀))
  let key : AdmissibleCuspPair M c₀ → Q := fun p =>
    (Ideal.Quotient.mk _ p.val.1, Ideal.Quotient.mk _ p.val.2)
  let T := Set.range key
  letI : Fintype T := Fintype.ofFinite T
  let e : Fin (Fintype.card T) ≃ T := (Fintype.equivFin T).symm
  let pool : Fin (Fintype.card T) → AdmissibleCuspPair M c₀ :=
    fun i => (e i).property.choose
  have hpool (i : Fin (Fintype.card T)) : key (pool i) = (e i).val :=
    (e i).property.choose_spec
  refine ⟨Fintype.card T, pool, ?_⟩
  intro a r hr har
  let p : AdmissibleCuspPair M c₀ := ⟨(a, r), hr, har⟩
  let t : T := ⟨key p, ⟨p, rfl⟩⟩
  let i := e.symm t
  have hkey : key (pool i) = key p := by
    rw [hpool]
    change (e (e.symm t)).val = t.val
    rw [e.apply_symm_apply]
  have ha : M * c₀ ∣ a - (pool i).val.1 := by
    apply Ideal.mem_span_singleton.mp
    apply Ideal.Quotient.eq.mp
    exact (congrArg Prod.fst hkey).symm
  have hrr : M * c₀ ∣ r - (pool i).val.2 := by
    apply Ideal.mem_span_singleton.mp
    apply Ideal.Quotient.eq.mp
    exact (congrArg Prod.snd hkey).symm
  let g₀ := cuspMatrix M c₀ (pool i)
  have hg₀ := cuspMatrix_spec M c₀ (pool i)
  change g₀ 0 0 = (pool i).val.1 ∧ g₀ 1 0 = c₀ * (pool i).val.2 at hg₀
  have hdet₀ : (pool i).val.1 * g₀ 1 1 - g₀ 0 1 * (c₀ * (pool i).val.2) = 1 := by
    have hd := g₀.property
    simpa only [Matrix.det_fin_two, hg₀.1, hg₀.2] using hd
  obtain ⟨b, d, hdet, hd, hg⟩ := exists_fixed_matrix_completion
    M c₀ (pool i).val.1 (pool i).val.2 (g₀ 1 1) (g₀ 0 1) hc₀ hdet₀
    a r ha ((dvd_mul_right M c₀).trans hrr) hr har.of_mul_right_right
  let g : SL(2, O) := ⟨!![a, b; c₀ * r, d], by
    simpa only [Matrix.det_fin_two, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one] using hdet⟩
  refine ⟨i, g, rfl, rfl, ha, hrr, hd, ?_⟩
  have he₀ : (g₀ : Matrix (Fin 2) (Fin 2) O) =
      !![(pool i).val.1, g₀ 0 1; c₀ * (pool i).val.2, g₀ 1 1] := by
    apply Matrix.ext
    intro j k
    fin_cases j <;> fin_cases k
    · exact hg₀.1
    · rfl
    · exact hg₀.2
    · rfl
  change (g : Matrix (Fin 2) (Fin 2) O).map (Ideal.Quotient.mk (principal M)) =
    (g₀ : Matrix (Fin 2) (Fin 2) O).map (Ideal.Quotient.mk (principal M))
  rw [he₀]
  exact hg

theorem relative_mem_levelThree_of_matrix_congr (M : O) (h₃ : (3 : O) ∣ M)
    (g h : SL(2, O))
    (he : (g : Matrix (Fin 2) (Fin 2) O).map (Ideal.Quotient.mk (principal M)) =
      (h : Matrix (Fin 2) (Fin 2) O).map (Ideal.Quotient.mk (principal M))) :
    g * h⁻¹ ∈ LevelThree := by
  let red := Matrix.SpecialLinearGroup.map (n := Fin 2)
    (Ideal.Quotient.mk (principal (3 : O)))
  have hred : red g = red h := by
    apply Subtype.ext
    apply Matrix.ext
    intro i j
    change Ideal.Quotient.mk (principal (3 : O)) (g i j) =
      Ideal.Quotient.mk (principal (3 : O)) (h i j)
    apply quotient_eq_of_dvd_sub
    have heij := congrArg (fun A : Matrix (Fin 2) (Fin 2) (O ⧸ principal M) => A i j) he
    have hd : M ∣ g i j - h i j := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq.mp heij)
    exact h₃.trans hd
  change red (g * h⁻¹) = 1
  rw [map_mul, map_inv, hred, mul_inv_cancel]

end QRHShort.CloudBatch.ReflectionCuspCompletion










