abbrev SourceFamily (c : ArithmeticContext) :=
  (P : Finset (Ideal O)) → (j : Ideal O → Fin 6) → PrimeTwistSet c.S P →
    (v : ℝ) → 0 < v → ℂ

def poolValue {N : ℕ} (data : Fin N → ReflectionDatum)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6)
    (β : Fin N → Finset (Ideal O) → ℂ) (v : ℝ) : ℂ :=
  ∑ i : Fin N, ∑ A ∈ P.powerset, if AdmissibleActive P j A then
    normalizedReflectionRow (data i) (β i A) A j v else 0

/-- A profile pool with precisely the original order of uniform choices.
The represented family may depend on positivity and prime-set proofs. -/
def UniformProfilePool (c : ArithmeticContext) (F : SourceFamily c) : Prop :=
  ∃ (N : ℕ) (data : Fin N → ReflectionDatum) (K : ℝ), 0 ≤ K ∧
    ∀ P j (hP : PrimeTwistSet c.S P),
      ∃ β : Fin N → Finset (Ideal O) → ℂ,
        (∀ i A, AdmissibleActive P j A → ‖β i A‖ ≤ K) ∧
        ∀ v hv, F P j hP v hv = poolValue data P j β v

theorem normalizedReflectionRow_mul (d : ReflectionDatum) (a b : ℂ)
    (A : Finset (Ideal O)) (j : Ideal O → Fin 6) (v : ℝ) :
    normalizedReflectionRow d (a * b) A j v = a * normalizedReflectionRow d b A j v := by
  unfold normalizedReflectionRow
  ring

theorem poolValue_mul {N : ℕ} (data : Fin N → ReflectionDatum)
