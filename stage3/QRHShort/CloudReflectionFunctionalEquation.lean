def IntegerModThree (x : Eis) : Prop := ∃ r : ℤ, (3 : Eis) ∣ x - (r : Eis)

private theorem three_not_dvd_one : ¬ (3 : Eis) ∣ 1 := by
  intro h
  have hl : lam ∣ (3 : Eis) :=
    (dvd_pow_self lam (by decide : (2 : ℕ) ≠ 0)).trans lambda_sq_dvd_three
  exact PrimaryIdealUnitReindex.lambda_prime_actual.not_isUnit
    (isUnit_of_dvd_one (hl.trans h))

private theorem integer_column_of_primary_top (G : levelTwo)
    (T : SL(2,Eis)) (hT : T 1 0 = 0)
    (ha : lam ^ 2 ∣ ((G : SL(2,Eis)) * T) 0 0 - 1) :
    IntegerModThree (((G : SL(2,Eis)) * T) 1 0) := by
  have h0 : ((G : SL(2,Eis)) * T) 0 0 = (G : SL(2,Eis)) 0 0 * T 0 0 := by
    simp [Matrix.mul_apply, Fin.sum_univ_two, hT]
  have h1 : ((G : SL(2,Eis)) * T) 1 0 = (G : SL(2,Eis)) 1 0 * T 0 0 := by
    simp [Matrix.mul_apply, Fin.sum_univ_two, hT]
  have ha3 := three_dvd_primary_sub_one _ ha
  rw [h0] at ha3
  let r : ℤ := levelTwoRight G 0 0
  let s : ℤ := levelTwoRight G 1 0
  have hr := levelTwo_entry_integer G 0 0
  have hs := levelTwo_entry_integer G 1 0
  rcases integer_congruence_primary_cases _ r hr with hz | hp | hn
  · exact False.elim (three_not_dvd_one (by
      have hga := dvd_mul_of_dvd_left hz (T 0 0)
      convert dvd_sub hga ha3 using 1 <;> ring))
  · have htop : (3 : Eis) ∣ T 0 0 - 1 := by
      have hg := three_dvd_primary_sub_one _ hp
      have hh := dvd_sub ha3 (dvd_mul_of_dvd_left hg (T 0 0))
      convert hh using 1 <;> ring
    refine ⟨s, ?_⟩
    rw [h1]
    have hh := dvd_add (dvd_mul_of_dvd_left hs (T 0 0))
      (dvd_mul_of_dvd_right htop (s : Eis))
    convert hh using 1 <;> ring
  · have htop : (3 : Eis) ∣ T 0 0 + 1 := by
      have hg := dvd_neg.mpr (three_dvd_primary_sub_one _ hn)
      have hh := dvd_sub (dvd_mul_of_dvd_left hg (T 0 0)) ha3
      convert hh using 1 <;> ring
    refine ⟨-s, ?_⟩
    rw [h1]
    have hh := dvd_add (dvd_mul_of_dvd_left hs (T 0 0))
      (dvd_mul_of_dvd_right htop (s : Eis))
    convert hh using 1 <;> push_cast <;> ring

/-- An arbitrary integral cusp with primary top and nonrational bottom
modulo three is genuinely an auxiliary cusp, hence has zero constant term. -/
theorem sourceCuspConstant_zero_of_primary_noninteger
    (M : SL(2,Eis)) (ha : lam ^ 2 ∣ M 0 0 - 1)
    (hc : ¬ IntegerModThree (M 1 0)) : sourceCuspConstant M = 0 := by
  obtain ⟨G, j, T, hT, _, _, hM⟩ := three_cusp_decomposition M
  apply (sourceCuspConstant_zero_iff M G j T hT hM).mpr
  intro hj
  subst j
  have he : M = (G : SL(2,Eis)) * T := by
    have hz : cuspRepresentative 0 = (1 : SL(2,Eis)) := by
      apply Subtype.ext
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [cuspRepresentative, cuspParameter, lowerCuspMatrix]
    simpa only [hz, mul_one] using hM
  apply hc
  rw [he] at ha ⊢
  exact integer_column_of_primary_top G T hT ha

/-- The complementary rational-bottom class has its literal Kubota scalar;
