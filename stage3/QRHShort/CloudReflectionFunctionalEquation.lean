open OAI.CubicEisenstein
local notation "lam" => OAI.ActualEisensteinCubic.lambda

def ramifiedTopUnit (η : Oˣ) (a : ℕ) : Oˣ :=
  η * (ramifiedOmegaUnit ^ a)⁻¹ * ramifiedOmegaUnit

def ramifiedTopElement (η : Oˣ) (a r : ℕ) (m : O) : O :=
  (ramifiedTopUnit η a : O) * lam ^ r * m

private theorem omegaUnit_cube : ramifiedOmegaUnit ^ 3 = (1 : Oˣ) := by
  apply Units.ext
  simpa only [Units.val_pow_eq_pow_val, Units.val_one, ramifiedOmegaUnit_val] using
    (OAI.ActualEisensteinCubic.omega_primitive.pow_eq_one : omega ^ 3 = (1 : O))

theorem ramifiedTopUnit_inverse (η : Oˣ) (a : ℕ) :
    ramifiedSourceDenominatorUnit η a * ramifiedTopUnit η a = 1 := by
  unfold ramifiedSourceDenominatorUnit ramifiedTopUnit
  rw [pow_add]
  calc
    _ = (η⁻¹ * η) * ((ramifiedOmegaUnit ^ a) * (ramifiedOmegaUnit ^ a)⁻¹) *
        (ramifiedOmegaUnit ^ 2 * ramifiedOmegaUnit) := by ac_rfl
    _ = ramifiedOmegaUnit ^ 2 * ramifiedOmegaUnit := by
      simp only [inv_mul_cancel, mul_inv_cancel, one_mul]
    _ = 1 := by rw [← pow_succ, omegaUnit_cube]

/-- All exponents above n+2 give an actual integral point, not another
negative or truncated denominator exponent. -/
theorem ramified_top_numerator (η : Oˣ) (a n r : ℕ) (m : O) :
