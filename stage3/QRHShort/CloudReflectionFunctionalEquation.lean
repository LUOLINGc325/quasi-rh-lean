    sourceCuspConstant M = sourceCuspConstant N := by
      rw [← he]
      exact sourceCuspConstant_upper_right _ T hT
    _ = _ := by
      rw [hN, levelTwoComplexCharacter_primary G hNG]
      change eisEmbedding (symbol (N 1 0) (N 0 0)) * _ = _
      rw [hN0, hN1]

/-- A bottom of exact lambda valuation one cannot be rational modulo three. -/
theorem not_integerModThree_of_once (c : Eis) (hc : lam ∣ c) (hc3 : ¬ (3 : Eis) ∣ c) :
    ¬ IntegerModThree c := by
  rintro ⟨r, hr⟩
  rcases integer_congruence_primary_cases c r hr with h | h | h
  · exact hc3 h
  · exact PrimaryIdealUnitReindex.lambda_prime_actual.not_isUnit
      ((coprime_of_dvd_sub_one lam c ((dvd_pow_self lam (by decide : (2 : ℕ) ≠ 0)).trans h)).isUnit_of_dvd'
        (dvd_refl lam) hc)
  · have hneg : lam ∣ -c := dvd_neg.mpr hc
    exact PrimaryIdealUnitReindex.lambda_prime_actual.not_isUnit
      ((coprime_of_dvd_sub_one lam (-c) ((dvd_pow_self lam (by decide : (2 : ℕ) ≠ 0)).trans h)).isUnit_of_dvd'
        (dvd_refl lam) hneg)

theorem sourceCuspConstant_zero_of_primary_once
    (M : SL(2,Eis)) (ha : lam ^ 2 ∣ M 0 0 - 1)
    (hc : lam ∣ M 1 0) (hc3 : ¬ (3 : Eis) ∣ M 1 0) :
    sourceCuspConstant M = 0 :=
  sourceCuspConstant_zero_of_primary_noninteger M ha (not_integerModThree_of_once _ hc hc3)

theorem sourceCuspConstant_zero_of_once
    (M : SL(2,Eis)) (hc : lam ∣ M 1 0) (hc3 : ¬ (3 : Eis) ∣ M 1 0) :
    sourceCuspConstant M = 0 := by
  have hcop : IsCoprime (M 0 0) (M 1 0) := by
    refine ⟨M 1 1, -M 0 1, ?_⟩
    have hd := M.property
    rw [Matrix.det_fin_two] at hd
    linear_combination hd
  have ha : ¬ lam ∣ M 0 0 := fun h =>
    PrimaryIdealUnitReindex.lambda_prime_actual.not_isUnit (hcop.isUnit_of_dvd' h hc)
  have hg : CompletedGauss.primaryGenerator (Ideal.span {M 0 0}) ≠ 0 :=
    PrimaryIdealUnitReindex.primaryGenerator_span_ne_zero_iff _ |>.mpr ha
  have hspec := CompletedGauss.primaryGenerator_spec (Ideal.span {M 0 0}) hg
  have hassoc : Associated (M 0 0) (CompletedGauss.primaryGenerator (Ideal.span {M 0 0})) :=
    Ideal.span_singleton_eq_span_singleton.mp hspec.1.symm
  obtain ⟨u, hu⟩ := hassoc
  have hp : lam ^ 2 ∣ (M 0 0) * (u : Eis) - 1 := by rw [hu]; exact hspec.2
  let T : SL(2,Eis) := ⟨!![(u : Eis), 0; 0, ((u⁻¹ : Eisˣ) : Eis)], by
    simp [Matrix.det_fin_two]⟩
  have ht0 (i : Fin 2) : (M * T) i 0 = M i 0 * (u : Eis) := by
    change (∑ k : Fin 2, M i k * T k 0) = _
    simp [Fin.sum_univ_two, T]
  have hnew := sourceCuspConstant_zero_of_primary_once (M * T)
    (by rw [ht0]; exact hp) (by rw [ht0]; exact dvd_mul_of_dvd_left hc _)
    (by
      rw [ht0]
      intro hh
      have hh' := dvd_mul_of_dvd_left hh (((u⁻¹ : Eisˣ) : Eis))
      exact hc3 (by simpa only [mul_assoc, Units.mul_inv, mul_one] using hh'))
  rwa [sourceCuspConstant_upper_right _ T (by rfl)] at hnew

