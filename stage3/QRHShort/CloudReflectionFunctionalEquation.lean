local notation "O" => OAI.ActualEisensteinCubic.O
local notation "lam" => OAI.ActualEisensteinCubic.lambda
local notation "delta" => QRHShort.lambda

def HighIntegerClass (a₀ c q : O) : Prop :=
  ∃ n : ℤ, lam ^ 3 ∣ a₀ + q * c - delta * (n : O)

theorem trace_ne_zero : delta ≠ 0 := by
  intro he
  have hz := cube_eq_three_trace
  rw [he, mul_zero] at hz
  exact pow_ne_zero 3 PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero hz

theorem highIntegerClass_trace_dvd (a₀ c q : O) (h : HighIntegerClass a₀ c q) :
    delta ∣ a₀ + q * c := by
  obtain ⟨n, k, hk⟩ := h
  refine ⟨(n : O) + 3 * k, ?_⟩
  rw [cube_eq_three_trace] at hk
  linear_combination hk

theorem cubeData_three_of_trace_dvd {M : SL(2,O)} {q a₀ : O}
    (d : RamifiedCubeCuspData M lam q) (ha : M 0 0 = 3 * a₀)
    (hr : delta ∣ a₀ + q * M 1 0) : d.exponent.val = 3 := by
  have hj := cubeData_exponent_ge_two d ⟨a₀, ha⟩
  by_contra hn
  have hj2 : d.exponent.val = 2 := by have := d.exponent.isLt; omega
  obtain ⟨s, hs⟩ := hr
  have htop : d.matrix 0 0 = lam * s := by
    apply mul_left_cancel₀ (pow_ne_zero 2 PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero)
    have hf := d.first
    rw [ha, hj2] at hf
    calc
      lam ^ 2 * d.matrix 0 0 = 3 * (a₀ + q * M 1 0) := by linear_combination -hf
      _ = 3 * (delta * s) := by rw [hs]
      _ = lam ^ 2 * (lam * s) := by rw [← mul_assoc, ← cube_eq_three_trace]; ring
  have hbottom : d.matrix 1 0 = lam * M 1 0 := by
    rw [cubeData_lower d PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero, hj2]
    norm_num
  exact PrimaryIdealUnitReindex.lambda_prime_actual.not_isUnit
    ((matrix_column_coprime d.matrix).isUnit_of_dvd' ⟨s, htop⟩ ⟨M 1 0, hbottom⟩)

theorem cubeData_three_of_integer_class {M : SL(2,O)} {q a₀ : O}
    (d : RamifiedCubeCuspData M lam q) (ha : M 0 0 = 3 * a₀)
    (hr : HighIntegerClass a₀ (M 1 0) q) : d.exponent.val = 3 :=
  cubeData_three_of_trace_dvd d ha (highIntegerClass_trace_dvd _ _ _ hr)

theorem cubeData_three_integer_iff {M : SL(2,O)} {q a₀ : O}
    (d : RamifiedCubeCuspData M lam q) (ha : M 0 0 = 3 * a₀)
    (hj : d.exponent.val = 3) :
    (∃ n : ℤ, (3 : O) ∣ d.matrix 0 0 - (n : O)) ↔ HighIntegerClass a₀ (M 1 0) q := by
  have hr := cubeData_three_trace_relation d ha hj
  unfold HighIntegerClass
  apply exists_congr
  intro n
  rw [hr, ← mul_sub, cube_eq_three_trace, mul_comm (3 : O) delta]
  exact (mul_dvd_mul_iff_left trace_ne_zero).symm

theorem lambda_primary_not_three (c : O) (hc : lam ^ 2 ∣ c - 1) :
    ¬ (3 : O) ∣ lam * c := by
  intro hd
  have hLam2 := lambda_sq_dvd_three.trans hd
  rw [pow_two] at hLam2
  have hLam := (mul_dvd_mul_iff_left PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero).mp hLam2
  have hl3 : lam ∣ (3 : O) :=
    (dvd_pow_self lam (by decide : (2 : ℕ) ≠ 0)).trans lambda_sq_dvd_three
  have hcop := (primary_coprime_three c hc).of_isCoprime_of_dvd_right hl3
  exact PrimaryIdealUnitReindex.lambda_prime_actual.not_isUnit
    (hcop.isUnit_of_dvd' hLam (dvd_refl lam))

end QRHShort.CloudBatch.ReflectionRamifiedCubeHighSupport







