    Ideal.mem_span_singleton.mp (Ideal.Quotient.eq.mp (residueLift_spec _ _))
  have hδ : Ideal.Quotient.mk (principal (boundedRamifiedModulus K)) y =
      Ideal.Quotient.mk (principal (boundedRamifiedModulus K)) h :=
    Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr
      ((dvd_mul_right (boundedRamifiedModulus K) B).trans hd))
  have hB : Ideal.Quotient.mk (principal B) y = Ideal.Quotient.mk (principal B) h :=
    Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr
      ((dvd_mul_left B (boundedRamifiedModulus K)).trans hd))
  change star (boundedRamifiedResidue K C i (Ideal.Quotient.mk _ y)) * ψ (Ideal.Quotient.mk _ y) = _
  rw [hδ, hB]

theorem zeroBadResidue_norm_bound (K : ℕ) (C : Fin (K + 1) → RamifiedNineGroup → ℂ)
    (i : RamifiedNineGroup) (B : O) (ψ : (O ⧸ principal B) → ℂ)
