    (i : RamifiedSixBranch) (j : RamifiedNineGroup) (z : ℂ) (h : O) :
    ‖ramifiedProfileMultiplier C side i j z h‖ ≤ ramifiedProfileWeightBound C side i j := by
  rw [ramifiedProfileMultiplier, norm_mul, norm_star, breve_eq_breveE, breveE_norm, mul_one]
  exact ramifiedCuspTauWeight_norm_bound C side i j h

