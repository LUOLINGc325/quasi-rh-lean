theorem supported_trace_lambda (c : ArithmeticContext) (p : Ideal O) (hp : Prime p)
    (hd : p ∣ principal lambda) : p ∈ c.S := by
  exact supported_unit_trace_power c 1 1 p hp (by simpa using hd)

def zeroLiftedResidue (K : ℕ) (C : Fin (K + 1) → RamifiedNineGroup → ℂ)
