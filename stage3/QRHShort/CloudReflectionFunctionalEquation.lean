theorem primary_cube_completion_constant_sum_zero
    (A : SL(2,Eis)) (ha : lam ^ 2 ∣ A 0 0 - 1)
    (hc : ¬ IntegerModThree (A 1 0))
    (N : Eis ⧸ Ideal.span {lam ^ 3} → SL(2,Eis))
    (hN0 : ∀ x, N x 0 0 = A 0 0 + 3 * GaussianShiftedPartition.representative (lam ^ 3) x * A 1 0)
