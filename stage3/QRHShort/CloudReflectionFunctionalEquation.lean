    convert (isCoprime_mul_unit_left_right hu r (M * c₀)).mpr hr using 1 <;> ring
  have haru : IsCoprime (u * a) r :=
    (isCoprime_mul_unit_left_left hu a r).mpr har.of_mul_right_right
