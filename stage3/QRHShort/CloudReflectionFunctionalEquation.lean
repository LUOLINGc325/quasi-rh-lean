    · exact ⟨0, Nat.zero_le _, a, by simp, Or.inr h⟩

/-- Every prime cube-average summand admits pure integral cusp data, including
ramified primes. The completing matrix may lie in a different cusp class. -/
theorem exists_ramifiedCubeCuspData (M : SL(2, O)) (p q : O) (hp : Prime p) :
    ∃ d : RamifiedCubeCuspData M p q, d.exponent.val = 3 ∨ ¬p ∣ d.matrix 0 0 := by
  let a := M 0 0 + 3 * q * M 1 0
  have haC : IsCoprime a (M 1 0) := by
    have hd : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
      simpa only [Matrix.det_fin_two] using M.property
    refine ⟨M 1 1, -(M 0 1 + 3 * q * M 1 1), ?_⟩
    dsimp [a]
    linear_combination hd
  obtain ⟨j, hj, b, hab, hb⟩ := bounded_power_factor p a 3
  have hbC : IsCoprime b (M 1 0) := by
    rw [hab] at haC
    exact haC.of_mul_left_right
  have hbY : IsCoprime b (p ^ (3 - j) * M 1 0) := by
    rcases hb with h | h
    · simpa [h] using hbC
    · exact ((hp.coprime_iff_not_dvd.mpr h).symm.pow_right).mul_right hbC
  obtain ⟨N, hN0, hN1⟩ := exists_cusp_matrix b (p ^ (3 - j) * M 1 0) hbY
  have hfirst : M 0 0 + 3 * q * M 1 0 = p ^ j * N 0 0 := by
    rw [hN0]
    exact hab
  have hsecond : p ^ 3 * M 1 0 = p ^ j * N 1 0 := by
    rw [hN1, ← mul_assoc, ← pow_add, Nat.add_sub_of_le hj]
  refine ⟨⟨⟨j, by omega⟩, N, hfirst, hsecond⟩, ?_⟩
