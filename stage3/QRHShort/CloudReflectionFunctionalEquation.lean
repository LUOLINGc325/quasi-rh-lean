namespace QRHShort.CloudBatch.ReflectionResidual
open ReflectionFE ReflectionSourceRamified OAI.CubicEisenstein

/-- At one fixed ramified valuation, the actual source seed vector has a
finite literal-tau expansion. No growing eigen-relation for S is asserted. -/
theorem source_fixed_valuation_seed_span (r : ℕ) :
    ∃ C : RamifiedNineGroup → ℂ, ∀ a : ZMod 3,
      sourceResidualFourierCoefficient (omega ^ a.val * lambda ^ r) =
        ∑ j : RamifiedNineGroup, C j *
          tauLattice (ramifiedUpShift j * (omega ^ a.val * lambda ^ r)) := by
  let F : RamifiedNineAlgebra := AddMonoidAlgebra.ofCoeff
    (Finsupp.equivFunOnFinite.symm (fun i : RamifiedNineGroup =>
      sourceResidualFourierCoefficient (omega ^ i.1.val * lambda ^ r) / ramifiedArchScale ^ r))
  obtain ⟨w, hw⟩ := literalNineKernel_finite_span F
  let A : ℂ := (((3 : ℝ) ^ (5 / 2 : ℝ) : ℝ) : ℂ)
  have hA : A ≠ 0 := by
    dsimp [A]
    exact_mod_cast (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 3) (5 / 2 : ℝ)).ne'
  refine ⟨fun j => w j / (A * ramifiedArchScale ^ (-j.2).val), ?_⟩
  intro a
  have hf : sourceResidualFourierCoefficient (omega ^ a.val * lambda ^ r) / ramifiedArchScale ^ r =
      F.coeff (a, (r : ZMod 3)) := by simp [F, Finsupp.equivFunOnFinite]
  have hs : sourceResidualFourierCoefficient (omega ^ a.val * lambda ^ r) / ramifiedArchScale ^ r =
      ∑ j : RamifiedNineGroup, w j *
        (tauLattice (ramifiedUpShift j * (omega ^ a.val * lambda ^ r)) /
          (A * (ramifiedArchScale ^ r * ramifiedArchScale ^ (-j.2).val))) := by
    rw [hf, hw]
    apply Finset.sum_congr rfl
    intro j hj
    rw [tauLattice_upShift_normalized]
  calc
    _ = ramifiedArchScale ^ r *
        (sourceResidualFourierCoefficient (omega ^ a.val * lambda ^ r) / ramifiedArchScale ^ r) := by
      field_simp [ramifiedArchScale_ne_zero]
    _ = _ := by
      rw [hs, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      field_simp [hA, ramifiedArchScale_ne_zero]

private theorem fixed_upShift_frequency (j : RamifiedNineGroup) (a : ZMod 3) (r : ℕ) :
    ramifiedUpShift j * (omega ^ a.val * lambda ^ r) =
      omega ^ (a - j.1).val * lambda ^ (r + (-j.2).val) := by
  have hw : omega ^ (-j.1).val * omega ^ a.val = omega ^ (a - j.1).val := by
    have hc : omega ^ (3 : ℕ) = 1 := OAI.ActualEisensteinCubic.omega_primitive.pow_eq_one
    rw [← pow_add, pow_eq_pow_mod _ hc, ← ZMod.val_add]
    congr 1
    abel
  unfold ramifiedUpShift
  calc
    _ = (omega ^ (-j.1).val * omega ^ a.val) * lambda ^ (r + (-j.2).val) := by
      rw [pow_add]
      ring
    _ = _ := by rw [hw]

private theorem fixed_tau_upShift_primary (j : RamifiedNineGroup) (a : ZMod 3) (r : ℕ)
    (n b : O) (hnb : PrimaryCubeData n b) :
    tauLattice (ramifiedUpShift j * (omega ^ a.val * lambda ^ r * (n * b ^ 3))) =
      (‖embedding b‖ : ℂ) *
        (cubicSymbol (principal n) (ramifiedUpShift j * (omega ^ a.val * lambda ^ r)) *
          star (cubicGauss 1 n) / (‖embedding n‖ : ℂ)) *
        tauLattice (ramifiedUpShift j * (omega ^ a.val * lambda ^ r)) := by
  rw [← mul_assoc, fixed_upShift_frequency]
  exact tauLattice_ramified_primary ⟨(a - j.1).val, ZMod.val_lt _⟩ _ n b hnb

private theorem fixed_source_cube (b h : O) (hb : IsPrimary b) :
    sourceResidualFourierCoefficient (h * b ^ 3) =
      (‖embedding b‖ : ℂ) * sourceResidualFourierCoefficient h := by
  by_cases hh : h = 0
  · subst h
    simp [sourceResidualFourierCoefficient, cubicBesselNormalizer, cuspFrequency]
  · have hb0 := OAI.CubicJacobiGlobal.primary_ne_zero b (primary_compat hb)
    simpa only [oai_embedding_eq] using
      sourceResidualFourierCoefficient_primary_cube b hb0 (primary_compat hb) h hh

/-- All infinitely many ordinary squarefree-cube indices are included at the
fixed valuation. The shift character is explicit until its primary quotient
