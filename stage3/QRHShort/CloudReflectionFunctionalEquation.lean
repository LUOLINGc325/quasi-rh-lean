    (‖γ‖ * (1 / 3)) * ‖α‖ ≤ (1 * (1 / 3)) * 1 :=
      mul_le_mul (mul_le_mul_of_nonneg_right hγ (by norm_num)) hα
        (norm_nonneg _) (by norm_num)
    _ ≤ 1 := by norm_num

