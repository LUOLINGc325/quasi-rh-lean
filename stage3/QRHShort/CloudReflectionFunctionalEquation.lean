open ReflectionCuspControlled ReflectionCuspControlledRows ReflectionCuspProjectedGeometry
open ReflectionCuspAuxiliaryRows ReflectionCuspPhasePool ReflectionRamifiedControlledProfile
open OAI.CubicEisenstein

theorem manuscriptCuspMatrix_eq_native (j : Fin 3) :
    manuscriptCuspMatrix j = OAI.EisensteinCuspModThree.cuspRepresentative j := by
  fin_cases j <;> rfl

/-- The native derivative family is literally the conjugated manuscript cusp
function at positive height, with no coefficient identification assumption. -/
theorem sourceCuspZFamily_literal (j : Fin 3) (z : ℂ) (v : ℝ) (hv : 0 < v) :
    sourceCuspZFamily j z v =
      wirtingerZ (fun z => star (sourceCuspFunction j (upperPoint z v hv))) z := by
  rw [sourceCuspZFamily, OAI.CubicEisenstein.cuspZProfile_positive _ z v hv]
  rw [← manuscriptCuspMatrix_eq_native]
  rfl

noncomputable local instance quotientField (P : Ideal O) [P.IsMaximal] :
    Field (O ⧸ P) := Ideal.Quotient.field P
noncomputable local instance quotientFintype (P : Ideal O) [P.IsMaximal] :
    Fintype (O ⧸ P) := Fintype.ofFinite _

/-- An actual source projection unit row is transported to an auxiliary
native series with the original literal local factors, keeping the full
complex Jacobian, q-height and bad-prime phase. -/
theorem controlled_projected_auxiliary_physical_row
    {ι : Type*} [Fintype ι] {p : ι → O} {N a₀ c₀ : O} {mode : Bool}
    [∀ i, (Ideal.span {p i} : Ideal O).IsMaximal]
    (c : ArithmeticContext) (D : ControlledStratumArithmetic p N a₀ c₀ mode)
    (hN : (9 : O) * c₀ ∣ N)
    (hr : OAI.ActualEisensteinCubic.lambda ^ 2 ∣ (∏ i, p i) - 1)
    (hbase : if mode then OAI.ActualEisensteinCubic.lambda ^ 2 ∣ a₀ - 1
      else OAI.ActualEisensteinCubic.lambda ^ 2 ∣ c₀ - 1)
    (G₀ : LevelThree) (r : SL(2, ℤ)) (side : Bool)
    (hκ : kubotaMultiplier G₀ = 1)
    (hfixed : ControlledStratumArithmetic.fixedCusp a₀ c₀ mode =
      (G₀ : SL(2, O)) * rationalMatrix r * manuscriptCuspMatrix (if side then 2 else 1))
    (hp : ∀ i, p i ≠ 0) (hc₀ : c₀ ≠ 0)
    (hP : ∀ i, Prime (Ideal.span {p i} : Ideal O))
    (hout : ∀ i, Outside c.S (Ideal.span {p i}))
    (hcop : Pairwise (Function.onFun IsCoprime (fun i => (Ideal.span {p i} : Ideal O))))
    (j : ι → Fin 6) (q : ℂ) (hq : q ≠ 0) (v : ℝ) (hv : 0 < v) :
    (∑ u : ∀ i, (O ⧸ Ideal.span {p i})ˣ,
      ControlledStratumArithmetic.fourierWeight hp
        (fun i => ReflectionFE.outside_lambda_not_mem c (hP i) (hout i))
        (fun i => (j i).val) u *
      wirtingerBar (fun z => star (cubicSourceResidualFunction
        (upperPoint (z / q + unitFourierPoint a₀ c₀ p u)
          (v / ‖q‖) (div_pos hv (norm_pos_iff.mpr hq))))) 0) =
      (-q / (embedding (c₀ * ∏ i, p i) ^ 2 * (v : ℂ) ^ 2)) *
        (controlledActiveScalar c D hp hP hout j *
          ∑' h : O, weightedAuxiliaryNativeTerm side
            (fun x => fixedResiduePhase c₀ hc₀
              (Ideal.Quotient.mk _ (-(D.matrix (fun _ => 1) 1 1) * D.U)) x *
                ∏ i, thetaLocalFactor (Ideal.span {p i}) (j i) x) 0
            (1 / (effectiveScale q (embedding (c₀ * ∏ i, p i)) * v)) h) := by
  have hden : embedding (c₀ * ∏ i, p i) ≠ 0 :=
    embedding_eq_zero.not.mpr
      (mul_ne_zero hc₀ (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)))
  have ht : 0 < 1 / (effectiveScale q (embedding (c₀ * ∏ i, p i)) * v) :=
    one_div_pos.mpr (mul_pos (effectiveScale_pos _ _ hq hden) hv)
  rw [controlled_projected_unit_row D hN hr hbase G₀ r (if side then 2 else 1)
    hκ hfixed hp hc₀ _ q hq v hv]
  simp_rw [← sourceCuspZFamily_literal (if side then 2 else 1) _ _ ht]
  rw [controlled_auxiliary_literal_row c D hN hr hbase hp hc₀ hP hout hcop j side _ ht]

end QRHShort.CloudBatch.ReflectionCuspAuxiliaryPhysicalRow




end
