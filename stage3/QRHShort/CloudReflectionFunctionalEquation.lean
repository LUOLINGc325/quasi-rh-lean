/- Frozen auxiliary cusp fragment ReflectionDualShiftReindex.lean SHA256 92770835f99ffd4b6296e1fbae17ce3e28950431369bbab9b1d320e5e2aa56ae -/




noncomputable section
open Classical
open scoped BigOperators

namespace QRHShort.CloudBatch.ReflectionDualShiftReindex
open ReflectionFE ReflectionResidual ReflectionThetaDifferentiation
open ReflectionSourceProjectionLift ReflectionDualFiniteMultiplier
open ReflectionDualBesselProfile ReflectionLatticeBesselHeight

/-- The extra fixed lambda changes the tau lattice into the original dual lattice. -/
def dualCoefficientShift (q : O) : O := lambda * q

private theorem lambda_embedding_ne_zero : embedding lambda ≠ 0 := by
  rw [ThetaRealizationProof.embedding_lambda]
  exact mul_ne_zero (by exact_mod_cast (ne_of_gt (Real.sqrt_pos.2
    (by norm_num : (0 : ℝ) < 3)))) Complex.I_ne_zero

theorem dualCoefficientShift_ne_zero {q : O} (hq : q ≠ 0) : dualCoefficientShift q ≠ 0 :=
  mul_ne_zero (embedding_eq_zero.not.mp lambda_embedding_ne_zero) hq

/-- Both the complex shift and the fixed lambda are retained in the frequency identity. -/
theorem dual_frequency_shift (q m : O) :
    embedding lambda ^ (-4 : ℤ) * embedding (dualCoefficientShift q * m) =
      ThetaRealizationProof.frequency (q * m) := by
  simp only [dualCoefficientShift, embedding_mul, ThetaRealizationProof.frequency]
  norm_num only [zpow_neg, zpow_ofNat]
  field_simp [lambda_embedding_ne_zero]
  <;> ring

theorem literal_frequency_mul (q m : O) :
    ThetaRealizationProof.frequency (q * m) =
      embedding q * ThetaRealizationProof.frequency m := by
  simp only [ThetaRealizationProof.frequency, embedding_mul]
  ring

/-- The minus sign in the frozen zero-cusp coefficient disappears by the
proved literal parity of tau, rather than by an assumed coefficient match. -/
theorem dual_coefficient_tau_shift (q m : O) :
    cuspCoefficient .zero
        (embedding lambda ^ (-4 : ℤ) * embedding (dualCoefficientShift q * m)) =
      star (tauLattice (q * m)) := by
  change star (tau (-(embedding lambda ^ (-4 : ℤ) *
    embedding (dualCoefficientShift q * m)))) = _
  rw [dual_frequency_shift, tau_neg]
  rfl

/-- Exact mode scaling in both horizontal coordinate and height. Only q,
not the extra coefficient lambda, contributes to the physical height ratio. -/
theorem dual_shift_mode (q : O) (hq : q ≠ 0) (m : O) (z : ℂ) (v : ℝ) :
    thetaMode (embedding lambda ^ (-4 : ℤ) * embedding (dualCoefficientShift q * m))
      (z / embedding q) (v / ‖embedding q‖) =
        (‖embedding q‖ : ℂ)⁻¹ * thetaMode (ThetaRealizationProof.frequency m) z v := by
  have hqE : embedding q ≠ 0 := embedding_eq_zero.not.mpr hq
  have hqN : ‖embedding q‖ ≠ 0 := norm_ne_zero_iff.mpr hqE
  have hqC : (‖embedding q‖ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hqN
  have harg : 4 * Real.pi * (‖embedding q‖ * ‖ThetaRealizationProof.frequency m‖) *
      (v / ‖embedding q‖) = 4 * Real.pi * ‖ThetaRealizationProof.frequency m‖ * v := by
    field_simp [hqN]
    <;> ring
  have hphase : (embedding q * ThetaRealizationProof.frequency m) * (z / embedding q) =
      ThetaRealizationProof.frequency m * z := by
    field_simp [hqE]
    <;> ring
  unfold thetaMode
  rw [dual_frequency_shift, literal_frequency_mul, norm_mul, harg, hphase]
  push_cast
  field_simp [hqC]
  <;> ring

/-- The actual coefficient series for the Z derivative of the conjugated native modes.
F(m)=lambda^(-3)*emb(m) is the negative of the original native cusp frequency. -/
def shiftedTauZTerm (q : O) (φ : O → ℂ) (v : ℝ) (m : O) : ℂ :=
  if m = 0 then 0 else
    (((2 * Real.pi : ℝ) : ℂ) * Complex.I) * ThetaRealizationProof.frequency m *
      star (tauLattice (q * m)) * φ m * thetaMode (ThetaRealizationProof.frequency m) 0 v

theorem shiftedTauZTerm_reindex (q : O) (hq : q ≠ 0) (φ : O → ℂ) (v : ℝ) (m : O) :
    shiftedTauZTerm q φ v m =
      ((‖embedding q‖ : ℂ) / embedding q) *
        cuspZTerm .zero (liftProjectedMultiplier (dualCoefficientShift q) φ)
          (v / ‖embedding q‖) (dualCoefficientShift q * m) := by
  have ha := dualCoefficientShift_ne_zero hq
  have hqE : embedding q ≠ 0 := embedding_eq_zero.not.mpr hq
  have hqN : ‖embedding q‖ ≠ 0 := norm_ne_zero_iff.mpr hqE
  have hqC : (‖embedding q‖ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hqN
  by_cases hm : m = 0
  · simp only [shiftedTauZTerm, hm, ite_true, mul_zero, cuspZTerm, latticeBesselTerm]
  have hqm : dualCoefficientShift q * m ≠ 0 := mul_ne_zero ha hm
  unfold cuspZTerm
  rw [latticeBesselTerm, ite_eq_right hqm]
  simp only [cuspZCoefficient]
  rw [dual_coefficient_tau_shift, liftProjectedMultiplier_mul _ ha]
  have hmode := dual_shift_mode q hq m 0 v
  simp only [zero_div] at hmode
  rw [hmode, dual_frequency_shift, literal_frequency_mul, shiftedTauZTerm, ite_eq_right hm]
  field_simp [hqE, hqC]
  <;> ring

/-- The full zero-extended quotient lift preserves polynomial growth. -/
theorem liftProjectedMultiplier_polynomial_bound (a : O) (ha : a ≠ 0)
    (φ : O → ℂ) (C : ℝ) (p : ℕ) (hC : 0 ≤ C)
    (hφ : ∀ m : O, m ≠ 0 → ‖φ m‖ ≤ C * ‖embedding m‖ ^ p)
    (H : O) (hH : H ≠ 0) :
    ‖liftProjectedMultiplier a φ H‖ ≤
      (C / ‖embedding a‖ ^ p) * ‖embedding H‖ ^ p := by
  have haN : ‖embedding a‖ ≠ 0 := norm_ne_zero_iff.mpr (embedding_eq_zero.not.mpr ha)
  by_cases hd : a ∣ H
  · let m := Classical.choose hd
    have he : H = a * m := Classical.choose_spec hd
    have hm : m ≠ 0 := by intro hm; exact hH (by rw [he, hm, mul_zero])
    have hnorm : ‖embedding m‖ = ‖embedding H‖ / ‖embedding a‖ := by
      rw [he, embedding_mul, norm_mul]
      field_simp [haN]
    rw [liftProjectedMultiplier, dif_pos hd]
    calc
      _ ≤ C * ‖embedding m‖ ^ p := hφ m hm
      _ = _ := by rw [hnorm, div_pow]; ring
  · simp only [liftProjectedMultiplier, dif_neg hd, norm_zero]
    positivity

/-- A nonzero lifted term has an actual preimage under the injective index map. -/
theorem cuspZTerm_lift_support (a : O) (φ : O → ℂ) (v : ℝ) :
    Function.support (cuspZTerm .zero (liftProjectedMultiplier a φ) v) ⊆
      Set.range (fun m : O => a * m) := by
  intro H hH
  by_cases hd : a ∣ H
  · exact ⟨Classical.choose hd, (Classical.choose_spec hd).symm⟩
  · apply (hH ?_).elim
    simp only [cuspZTerm, latticeBesselTerm, cuspZCoefficient,
      liftProjectedMultiplier, dif_neg hd, mul_zero, zero_mul, ite_self]

/-- The shifted tau derivative series is genuinely summable, and its exact
reindexing is the original literal zero-cusp Z profile with the decimation mask. -/
theorem shiftedTauZSeries_reindex (q : O) (hq : q ≠ 0) (φ : O → ℂ)
    (C : ℝ) (p : ℕ) (hC : 0 ≤ C)
    (hφ : ∀ m : O, m ≠ 0 → ‖φ m‖ ≤ C * ‖embedding m‖ ^ p)
    (v : ℝ) (hv : 0 < v) :
    Summable (shiftedTauZTerm q φ v) ∧
      (∑' m : O, shiftedTauZTerm q φ v m) =
        ((‖embedding q‖ : ℂ) / embedding q) *
          cuspZProfile .zero (liftProjectedMultiplier (dualCoefficientShift q) φ)
            (v / ‖embedding q‖) := by
  let a := dualCoefficientShift q
  have ha : a ≠ 0 := dualCoefficientShift_ne_zero hq
  have hqN : 0 < ‖embedding q‖ := norm_pos_iff.mpr (embedding_eq_zero.not.mpr hq)
  have hC' : 0 ≤ C / ‖embedding a‖ ^ p := by positivity
  have hsum := cuspZTerm_summable_polynomial .zero (liftProjectedMultiplier a φ)
    (C / ‖embedding a‖ ^ p) p hC'
    (liftProjectedMultiplier_polynomial_bound a ha φ C p hC hφ)
    (v / ‖embedding q‖) (div_pos hv hqN)
  have hi : Function.Injective (fun m : O => a * m) := fun _ _ he => mul_left_cancel₀ ha he
  have hsub := hsum.comp_injective hi
  refine ⟨?_, ?_⟩
  · apply (hsub.mul_left ((‖embedding q‖ : ℂ) / embedding q)).congr
    intro m
    simpa only [Function.comp_apply] using (shiftedTauZTerm_reindex q hq φ v m).symm
  · calc
      _ = ∑' m : O, ((‖embedding q‖ : ℂ) / embedding q) *
          cuspZTerm .zero (liftProjectedMultiplier a φ) (v / ‖embedding q‖) (a * m) :=
        tsum_congr (fun m => shiftedTauZTerm_reindex q hq φ v m)
      _ = ((‖embedding q‖ : ℂ) / embedding q) *
          ∑' m : O, cuspZTerm .zero (liftProjectedMultiplier a φ) (v / ‖embedding q‖) (a * m) :=
        tsum_mul_left
      _ = ((‖embedding q‖ : ℂ) / embedding q) *
          ∑' H : O, cuspZTerm .zero (liftProjectedMultiplier a φ) (v / ‖embedding q‖) H := by
        congr 1
        exact hi.tsum_eq (cuspZTerm_lift_support a φ _)
      _ = _ := rfl

theorem shiftedTauZSeries_eq_cuspZProfile (q : O) (hq : q ≠ 0) (φ : O → ℂ)
    (C : ℝ) (p : ℕ) (hC : 0 ≤ C)
    (hφ : ∀ m : O, m ≠ 0 → ‖φ m‖ ≤ C * ‖embedding m‖ ^ p)
    (v : ℝ) (hv : 0 < v) :
    (∑' m : O, shiftedTauZTerm q φ v m) =
      ((‖embedding q‖ : ℂ) / embedding q) *
        cuspZProfile .zero (liftProjectedMultiplier (dualCoefficientShift q) φ)
          (v / ‖embedding q‖) :=
  (shiftedTauZSeries_reindex q hq φ C p hC hφ v hv).2

theorem shift_derivative_factor_norm (q : O) (hq : q ≠ 0) :
    ‖((‖embedding q‖ : ℂ) / embedding q)‖ = 1 := by
  rw [norm_div, Complex.norm_of_nonneg (norm_nonneg _),
    div_self (norm_ne_zero_iff.mpr (embedding_eq_zero.not.mpr hq))]

end QRHShort.CloudBatch.ReflectionDualShiftReindex












