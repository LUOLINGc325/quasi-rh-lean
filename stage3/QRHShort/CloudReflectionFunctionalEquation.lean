/-- Actual primary generators identify exactly the original cube-pair support. -/
def sourceCubeIdealEquiv (c : ArithmeticContext) : SourceCubePairs c ≃ SourceIdealPairs c where
  toFun p := ⟨(principal p.val.1, principal p.val.2),
    ⟨p.property.2.1, p.property.1.2.2.2.2⟩, p.property.2.2⟩
  invFun p := ⟨(primaryGenerator p.val.1, primaryGenerator p.val.2), by
    have hn := primaryGenerator_spec_outside c p.property.1.1
    have hb := primaryGenerator_spec_outside c p.property.2
    have hn0 : primaryGenerator p.val.1 ≠ 0 := by
      intro hz
      apply p.property.1.1.1
      rw [← hn.1, hz]
      simp [principal]
    have hb0 : primaryGenerator p.val.2 ≠ 0 := by
      intro hz
      apply p.property.2.1
      rw [← hb.1, hz]
      simp [principal]
    refine ⟨⟨hn0, hb0, hn.2, hb.2, ?_⟩, ?_, ?_⟩
    · rw [hn.1]
      exact p.property.1.2
    · rw [hn.1]
      exact p.property.1.1
    · rw [hb.1]
      exact p.property.2⟩
  left_inv p := by
    apply Subtype.ext
    exact Prod.ext (primaryGenerator_principal p.property.1.2.2.1)
      (primaryGenerator_principal p.property.1.2.2.2.1)
  right_inv p := by
    apply Subtype.ext
    exact Prod.ext (primaryGenerator_spec_outside c p.property.1.1).1
      (primaryGenerator_spec_outside c p.property.2).1

theorem sourceCubeIdealEquiv_apply (c : ArithmeticContext) (p : SourceCubePairs c) :
    (sourceCubeIdealEquiv c p).val = (principal p.val.1, principal p.val.2) := rfl

theorem sourceCubeIdealEquiv_symm_apply (c : ArithmeticContext) (p : SourceIdealPairs c) :
    ((sourceCubeIdealEquiv c).symm p).val =
      (primaryGenerator p.val.1, primaryGenerator p.val.2) := rfl

theorem sourceCubePairs_summable_iff (c : ArithmeticContext)
    {E : Type*} [NormedAddCommGroup E] [CompleteSpace E]
    (F : Ideal O → Ideal O → E) :
    Summable (fun p : SourceCubePairs c => F (principal p.val.1) (principal p.val.2)) ↔
      Summable (fun p : Ideal O × Ideal O =>
        if SquarefreeOutside c.S p.1 ∧ Outside c.S p.2 then F p.1 p.2 else 0) := by
  have he0 := (sourceCubeIdealEquiv c).summable_iff
    (f := fun p : SourceIdealPairs c => F p.val.1 p.val.2)
  have he : Summable (fun p : SourceCubePairs c =>
      F (principal p.val.1) (principal p.val.2)) ↔
      Summable (fun p : SourceIdealPairs c => F p.val.1 p.val.2) := by
    simpa only [Function.comp_def, sourceCubeIdealEquiv_apply] using he0
  have hi :
      ({p : Ideal O × Ideal O | SquarefreeOutside c.S p.1 ∧ Outside c.S p.2}.indicator
        (fun p => F p.1 p.2)) =
      (fun p => if SquarefreeOutside c.S p.1 ∧ Outside c.S p.2 then F p.1 p.2 else 0) := by
    funext p
    by_cases h : SquarefreeOutside c.S p.1 ∧ Outside c.S p.2 <;> simp [h]
  have hs := (summable_subtype_iff_indicator
    (s := {p : Ideal O × Ideal O | SquarefreeOutside c.S p.1 ∧ Outside c.S p.2})
    (f := fun p => F p.1 p.2))
  rw [hi] at hs
  exact he.trans hs

theorem sourceCubePairs_tsum_eq_ideal_pairs (c : ArithmeticContext)
    {E : Type*} [NormedAddCommGroup E] [CompleteSpace E]
    (F : Ideal O → Ideal O → E) :
    (∑' p : SourceCubePairs c, F (principal p.val.1) (principal p.val.2)) =
      ∑' p : Ideal O × Ideal O,
        if SquarefreeOutside c.S p.1 ∧ Outside c.S p.2 then F p.1 p.2 else 0 := by
  calc
    _ = ∑' p : SourceIdealPairs c, F p.val.1 p.val.2 :=
      (sourceCubeIdealEquiv c).tsum_eq (fun p => F p.val.1 p.val.2)
    _ = _ := by
      have hs := tsum_subtype
        {p : Ideal O × Ideal O | SquarefreeOutside c.S p.1 ∧ Outside c.S p.2}
        (fun p => F p.1 p.2)
      exact hs.trans (tsum_congr fun p => by
        by_cases h : SquarefreeOutside c.S p.1 ∧ Outside c.S p.2 <;> simp [h])

end QRHShort.CloudBatch.ReflectionSourceReindex






