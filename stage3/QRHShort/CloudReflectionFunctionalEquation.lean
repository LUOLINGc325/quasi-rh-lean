theorem zeroCuspKernel_at_zero_neg (V : ℝ) (h : O) :
    zeroCuspKernel 0 V (-h) = -zeroCuspKernel 0 V h := by
  by_cases hh : h = 0
  · subst h
    simp [zeroCuspKernel]
  · have hn : -h ≠ 0 := neg_ne_zero.mpr hh
    simp only [zeroCuspKernel, if_neg hh, if_neg hn, cuspFrequency, map_neg,
      neg_div, norm_neg, mul_zero]
    ring

theorem sourceCuspZTerm_at_zero_neg (V : ℝ) (hV : 0 < V) (h : O) :
    sourceCuspZTerm 0 0 V (-h) = -sourceCuspZTerm 0 0 V h := by
  rw [sourceCuspZTerm_zero_factor 0 V hV (-h), sourceCuspZTerm_zero_factor 0 V hV h,
    sourceResidualFourierCoefficient_neg, zeroCuspKernel_at_zero_neg]
  ring

/-- The rational zero-residue cusp contributes no horizontal derivative:
the actual source coefficients are even and their Z-kernel is odd. -/
theorem sourceCuspZFamily_at_zero (V : ℝ) (hV : 0 < V) :
    sourceCuspZFamily 0 0 V = 0 := by
  rw [sourceCuspZFamily_series 0 0 V hV]
  have he := (Equiv.neg O).tsum_eq (fun h : O => sourceCuspZTerm 0 0 V h)
  simp only [Equiv.neg_apply, sourceCuspZTerm_at_zero_neg V hV, tsum_neg] at he
  linear_combination -he / 2

/-- On 3cO the genuine finite inverse-residue multiplier is invariant under
negation. This uses its proved period, not an assumed parity for a local twist. -/
theorem primaryDeepTerm_neg (c : O) (hc : c ≠ 0) (h₃ : (3 : O) ∣ c)
    (u : Oˣ) (n : ℕ) (t q : O) (V : ℝ) (hV : 0 < V) (h : O) :
    primaryDeepTerm c h₃ u n t q V (-h) = -primaryDeepTerm c h₃ u n t q V h := by
  by_cases hh : 3 * c ∣ h
  · have hn : 3 * c ∣ -h := dvd_neg.mpr hh
    have hdiff : 3 * c ∣ -h - h := by
      obtain ⟨a, ha⟩ := hh
      refine ⟨-2 * a, ?_⟩
      rw [ha]
      ring
    have hr := primaryWeightedZeroRow_frequency_congr c hc h₃ u n t (-h) h hdiff
    simp only [primaryDeepTerm, if_pos hh, if_pos hn, primaryPhysicalTerm,
      hr, sourceCuspZTerm_at_zero_neg V hV h]
    ring
  · have hn : ¬3 * c ∣ -h := fun he => hh (dvd_neg.mp he)
    simp only [primaryDeepTerm, if_neg hh, if_neg hn, neg_zero]

/-- The whole deep tail vanishes after the genuine h↦−h permutation. It is
not asserted that each growing-mode coefficient is zero or already tau. -/
theorem primary_deep_series_zero (c : O) (hc : c ≠ 0) (h₃ : (3 : O) ∣ c)
    (u : Oˣ) (n : ℕ) (t q : O) (V : ℝ) (hV : 0 < V) :
    (∑' h : O, primaryDeepTerm c h₃ u n t q V h) = 0 := by
  have he := (Equiv.neg O).tsum_eq (primaryDeepTerm c h₃ u n t q V)
  simp only [Equiv.neg_apply, primaryDeepTerm_neg c hc h₃ u n t q V hV, tsum_neg] at he
  linear_combination -he / 2

