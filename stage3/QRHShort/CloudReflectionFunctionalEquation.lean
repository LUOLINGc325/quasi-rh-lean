  ∀ (c : ArithmeticContext) (ξ : RayCharacter c),
    ∃ N : ℕ, ∃ data : Fin N → ReflectionDatum, ∃ K : ℝ, 0 ≤ K ∧
      ∀ (P : Finset (Ideal O)) (j : Ideal O → Fin 6), PrimeTwistSet c.S P →
        ∃ β : Fin N → Finset (Ideal O) → ℂ,
          (∀ h A, AdmissibleActive P j A → ‖β h A‖ ≤ K) ∧
          LiteralProfileReflection c ξ data P j β

theorem reflectionFunctionalEquation_of_fixed_profile_pool
    (hpool : FixedPoolProfileReflection) : ReflectionFunctionalEquationStatement := by
  intro _ c ξ
  obtain ⟨N, data, K, hK, hp⟩ := hpool c ξ
  refine ⟨N, data, K / 81, by positivity, ?_⟩
  intro P j hP
  obtain ⟨β, hβ, hgeometry⟩ := hp P j hP
  refine ⟨fun h A => (-Complex.I / 81) * β h A, ?_, sourceFunction c ξ P j, ?_⟩
  · intro h A hA
    exact reflection_coefficient_norm_le (β h A) K (hβ h A hA)
  · exact reflection_interfaces_of_literal_profiles c ξ data P j hP β hgeometry

