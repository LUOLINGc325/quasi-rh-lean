    (hdiv : lam ∣ M 0 0) (hnot : ¬lam ^ 2 ∣ M 0 0) (v : ℝ) (hv : 0 < v) :
    (∫ z in periodDomain,
      cubeAverage lam OAI.PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero
        cubicSourceResidualFunction (integralComplexMatrix M •
          upperPoint (3 * (eisEmbedding (lam ^ 3) * z)) v hv)) =
      (1 / 3 : ℂ) * sourceCuspConstant M * (v : ℂ) ^ (2 / 3 : ℂ) := by
  rw [once_cube_average_zero_all M hdiv hnot v hv,
    sourceCuspConstant_zero_of_top_once M hdiv hnot]
  ring

