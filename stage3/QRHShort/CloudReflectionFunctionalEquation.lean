    (fun i : ProfilePairIndex N P => data i.1) (fun i => i.2.val)
    (fun i => Finset.mem_powerset.mp i.2.property) (indexedCoefficient P j β)
    (literalProfileReflection_indexed c ξ data P j β hgeometry)
