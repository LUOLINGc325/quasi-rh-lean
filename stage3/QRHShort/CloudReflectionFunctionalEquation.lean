      refine dvd_trans (show (3 : Eis) ∣ lam ^ 2 from ?_) (pow_dvd_pow lam (by decide : 2 ≤ 3))
      refine ⟨-w, ?_⟩
      change (w - 1) ^ 2 = 3 * -w
      linear_combination ramified_omega_relation
