/-- The cubic identity of the ninth-root phase makes the ramified
three-by-three circulant invertible; the second cyclic index is independent. -/
private theorem ramified_nine_unit {R : Type*} [CommRing R] (a u v l : R)
    (ha : 3 * a ^ 3 = 1) (huv : u * v = 1) (hs : u ^ 3 + v ^ 3 = -1)
    (hl : l ^ 3 = 1) : IsUnit (1 + a * l ^ 2 * (1 + u + v)) := by
