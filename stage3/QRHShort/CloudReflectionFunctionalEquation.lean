    simpa only [hT] using hE
  have hv : ∀ P ∈ normalizedFactors T, (normalizedFactors T).count P % 3 ≠ 2 := by
    intro P hP
    exact ramifiedFunction_valuation_ne_two ramifiedDifferenceCoefficient
