reflection denominator has modulus one, uniformly in the active primes. -/
theorem norm_positive_denominator_ratio (z : ℂ) (hz : z ≠ 0) :
    ‖((‖z‖ ^ 2 : ℝ) : ℂ) / z ^ 2‖ = 1 := by
