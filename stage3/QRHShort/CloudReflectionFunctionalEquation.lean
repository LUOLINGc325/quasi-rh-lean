    (fun u => ControlledStratumArithmetic.fourierWeight hp hg j u *
      star (OAI.CubicKubota.complexCharacter (D.relativeGamma hN hr hbase u)))
    (fun u => -embedding (D.matrix u 1 1) / embedding (c₀ * ∏ i, p i)) v hv
