theorem sourceMultiplier_cube (c : ArithmeticContext) (ξ : RayCharacter c)
    (P : Finset (Ideal O)) (j : Ideal O → Fin 6) (hP : PrimeTwistSet c.S P)
    (n b : O) (hn : IsPrimary n) (hb : IsPrimary b)
    (hno : Outside c.S (principal n)) (hbo : Outside c.S (principal b)) :
    sourceMultiplier c ξ P j (n * b ^ 3) =
      sexticSymbol (principal n) lambda ^ (2 : ℕ) *
        productTwist c ξ P j (principal n) *
        productTwist c ξ P j (principal b) ^ (3 : ℕ) := by
  have hnb := outside_mul c hno (outside_cube c hbo)
  have hp : IsPrimary (n * b ^ 3) := primary_mul hn (primary_cube hb)
