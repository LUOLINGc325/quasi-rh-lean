namespace QRHShort.CloudBatch.ReflectionFE

theorem selected_embedding_omega_im : (embedding omega).im = Real.sqrt 3 / 2 := by
  let w := embedding omega
  have hp : w ^ 2 + w + 1 = 0 := by
    simpa only [embedding_add, embedding_pow, embedding_one, embedding_zero] using
      congrArg embedding omega_sq_add_omega_add_one
  have hr : w.re ^ 2 - w.im ^ 2 + w.re + 1 = 0 := by
    simpa only [pow_two, Complex.add_re, Complex.mul_re, Complex.one_re,
      Complex.zero_re] using congrArg Complex.re hp
  have hi : 2 * w.re * w.im + w.im = 0 := by
    have h := congrArg Complex.im hp
    simp only [pow_two, Complex.add_im, Complex.mul_im, Complex.one_im,
      Complex.zero_im] at h
    nlinarith
  have hne : w.im ≠ 0 := by
    intro h
    rw [h] at hr
    nlinarith [sq_nonneg (w.re + (1 : ℝ) / 2)]
  have hre : w.re = -(1 : ℝ) / 2 := by
    have hf : (2 * w.re + 1) * w.im = 0 := by nlinarith
    have hz := (mul_eq_zero.mp hf).resolve_right hne
    linarith
  have hnonneg : 0 ≤ w.im := by
    dsimp [w, embedding]
    split_ifs with h
    · exact h.le
    · simpa only [Complex.star_def, Complex.conj_im] using
        neg_nonneg.mpr (le_of_not_gt h)
  have hsqrt : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  have hsq : w.im ^ 2 = (3 : ℝ) / 4 := by nlinarith
  change w.im = _
  nlinarith [Real.sqrt_nonneg (3 : ℝ)]

theorem embedding_omega_explicit :
    QRHShort.embedding omega = ((-1 : ℂ) + (Real.sqrt 3 : ℂ) * Complex.I) / 2 := by
  have hp : QRHShort.embedding omega ^ 2 + QRHShort.embedding omega + 1 = 0 := by
    simpa only [QRHShort.embedding_add, QRHShort.embedding_pow,
      QRHShort.embedding_one, QRHShort.embedding_zero] using
      congrArg QRHShort.embedding QRHShort.omega_sq_add_omega_add_one
  have hi : (2 * (QRHShort.embedding omega).re + 1) *
      (QRHShort.embedding omega).im = 0 := by
    have h := congrArg Complex.im hp
    simp only [pow_two, Complex.add_im, Complex.mul_im, Complex.one_im,
      Complex.zero_im] at h
    nlinarith
  have him : (QRHShort.embedding omega).im ≠ 0 := by
    rw [selected_embedding_omega_im]
    exact div_ne_zero (ne_of_gt (Real.sqrt_pos.mpr (by norm_num))) (by norm_num)
  have hre : (QRHShort.embedding omega).re = -(1 : ℝ) / 2 := by
    have h := (mul_eq_zero.mp hi).resolve_right him
    linarith
  apply Complex.ext
  · simp [hre, Complex.div_re]
  · simp [selected_embedding_omega_im, Complex.div_im]

/-- The upstream concrete positive embedding agrees with the frozen selected
embedding, rather than merely being an unspecified conjugate embedding. -/
theorem oai_embedding_eq (a : O) :
    OAI.ConcreteTraceCRT.eisEmbedding a = QRHShort.embedding a := by
  have hg : OAI.EisensteinEmbedding.pb.gen = omega := by
    simp [OAI.EisensteinEmbedding.pb, QRHShort.omega]
  have hi (z : ℤ) : QRHShort.embedding (z : O) = (z : ℂ) := by
    simpa only [QRHShort.embeddingHom_apply] using map_intCast QRHShort.embeddingHom z
  obtain ⟨x, y, rfl⟩ := OAI.EisensteinEmbedding.exists_ab a
  change OAI.EisensteinEmbedding.embedding _ _ _ = _
  rw [OAI.EisensteinEmbedding.embedding_apply_ab, hg, QRHShort.embedding_add,
    QRHShort.embedding_mul, hi, hi, embedding_omega_explicit]
  rfl

theorem outside_lambda_not_mem (c : ArithmeticContext) {P : Ideal O}
    (hP : Prime P) (hout : Outside c.S P) :
    OAI.ActualEisensteinCubic.lambda ∉ P := by
  intro h
  exact hout.2 P (c.above_three P hP (Ideal.dvd_span_singleton.mpr
    (P.mem_of_dvd omega_sub_one_dvd_three h))) (dvd_refl P)

theorem outside_quotient_char_ne_two (c : ArithmeticContext) {P : Ideal O}
    [P.IsMaximal] (hP : Prime P) (hout : Outside c.S P) :
    ringChar (O ⧸ P) ≠ 2 := by
  apply OAI.ActualEisensteinCubic.quotient_char_ne_two_of_two_not_mem P
  intro h
  exact hout.2 P (c.above_two P hP (Ideal.dvd_span_singleton.mpr h)) (dvd_refl P)

theorem canonicalSextic_eq_symbol (c : ArithmeticContext) {P : Ideal O}
    [P.IsMaximal] (hP : Prime P) (hout : Outside c.S P)
    (hg : OAI.ActualEisensteinCubic.lambda ∉ P) (a : O) :
    OAI.ActualEisensteinCubic.canonicalSextic P hg (Ideal.Quotient.mk P a) =
      sexticSymbol P a := by
  rw [sexticSymbol_prime hP, sexticAtPrime_eq_sexticChar P hP hg
    (outside_quotient_char_ne_two c hP hout)
    (outside_quotient_rootSix_isPrimitiveRoot c hP hout)]
  exact oai_embedding_eq _

theorem localCharacterPower_nat_eq (c : ArithmeticContext) {P : Ideal O}
    [P.IsMaximal] (hP : Prime P) (hout : Outside c.S P)
    (hg : OAI.ActualEisensteinCubic.lambda ∉ P) (n : ℕ) (a : O) :
    localCharacterPower P (n : ℤ) a =
      (OAI.ActualEisensteinCubic.canonicalSextic P hg ^ n) (Ideal.Quotient.mk P a) := by
  letI : Field (O ⧸ P) := Ideal.Quotient.field P
  by_cases ha : a ∈ P
  · simp [localCharacterPower, ha, Ideal.Quotient.eq_zero_iff_mem.mpr ha,
      MulChar.map_zero]
  · have hu : IsUnit (Ideal.Quotient.mk P a) :=
      isUnit_iff_ne_zero.mpr (Ideal.Quotient.eq_zero_iff_mem.not.mpr ha)
    rw [localCharacterPower, if_neg ha, ← canonicalSextic_eq_symbol c hP hout hg,
      ← hu.unit_spec, MulChar.pow_apply_coe, zpow_natCast]

theorem localCharacterPower_neg_nat_eq (c : ArithmeticContext) {P : Ideal O}
    [P.IsMaximal] (hP : Prime P) (hout : Outside c.S P)
    (hg : OAI.ActualEisensteinCubic.lambda ∉ P) (n : ℕ) (a : O) :
    localCharacterPower P (-(n : ℤ)) a =
      (OAI.ActualEisensteinCubic.canonicalSextic P hg ^ n)⁻¹
        (Ideal.Quotient.mk P a) := by
  rw [MulChar.inv_apply_eq_inv', ← localCharacterPower_nat_eq c hP hout hg]
  by_cases ha : a ∈ P <;> simp [localCharacterPower, ha, zpow_neg]

@[simp] theorem residueLift_spec (P : Ideal O) (x : O ⧸ P) :
    Ideal.Quotient.mk P (residueLift P x) = x :=
  Classical.choose_spec (Ideal.Quotient.mk_surjective x)

noncomputable local instance reflectionQuotientField (P : Ideal O) [P.IsMaximal] :
    Field (O ⧸ P) := Ideal.Quotient.field P

noncomputable local instance reflectionQuotientFintype (P : Ideal O) [P.IsMaximal] :
    Fintype (O ⧸ P) := Fintype.ofFinite _

theorem quotient_card_normIdeal (P : Ideal O) [P.IsMaximal] :
    (Fintype.card (O ⧸ P) : ℝ) = normIdeal P := by
  simp only [normIdeal, Ideal.absNorm_apply, Submodule.cardQuot_apply,
    Nat.card_eq_fintype_card]

theorem thetaLocalFactor_eq_bracket (c : ArithmeticContext) {P : Ideal O}
    [P.IsMaximal] (hP : Prime P) (hout : Outside c.S P)
    (hg : OAI.ActualEisensteinCubic.lambda ∉ P) (j : Fin 6) (a : O) :
    thetaLocalFactor P j a = OAI.LocalReflectionBrackets.bracket
      (OAI.ActualEisensteinCubic.canonicalSextic P hg) j.val (Ideal.Quotient.mk P a) := by
  have hroot : OAI.LocalReflectionBrackets.rootCard (O ⧸ P) =
      Real.sqrt (normIdeal P) := congrArg Real.sqrt (quotient_card_normIdeal P)
  by_cases hj0 : j.val = 0
  · simp only [thetaLocalFactor, OAI.LocalReflectionBrackets.bracket, hj0,
      show (0 : ℕ) ≠ 4 by decide, reduceIte, hroot]
    congr 1
    simpa using localCharacterPower_neg_nat_eq c hP hout hg 2 a
  by_cases hj4 : j.val = 4
  · simp only [thetaLocalFactor, OAI.LocalReflectionBrackets.bracket, hj4,
      reduceIte, hroot]
    have hcard : (Fintype.card (O ⧸ P) : ℂ) = (normIdeal P : ℂ) := by
      exact_mod_cast quotient_card_normIdeal P
    by_cases ha : a ∈ P <;> simp [ha, hcard, Ideal.Quotient.eq_zero_iff_mem]
  · have he : -(j.val : ℤ) - 2 = -((j.val + 2 : ℕ) : ℤ) := by omega
    simp only [thetaLocalFactor, OAI.LocalReflectionBrackets.bracket,
      if_neg hj0, if_neg hj4, he]
    exact localCharacterPower_neg_nat_eq c hP hout hg (j.val + 2) a

/-- The finite reflection row written using the frozen local characters.
Both sums are finite; exponent zero remains zero at the nonunits. -/
def localReflectionRow (P : Ideal O) [P.IsMaximal]
    (ψ : AddChar (O ⧸ P) ℂ) (j : Fin 6) (σ ε : (O ⧸ P)ˣ) (a : O) : ℂ :=
  (normIdeal P : ℂ)⁻¹ * ∑ h : (O ⧸ P)ˣ,
    (∑ t : O ⧸ P, localCharacterPower P (j.val : ℤ) (residueLift P t) *
      ψ (-(h * t))) *
      localCharacterPower P (-2) (residueLift P (σ * h)) *
      ψ (((ε : O ⧸ P) * Ideal.Quotient.mk P a) * ((h⁻¹ : (O ⧸ P)ˣ) : O ⧸ P))

theorem localReflectionRow_eq_activeRow (c : ArithmeticContext) {P : Ideal O}
    [P.IsMaximal] (hP : Prime P) (hout : Outside c.S P)
    (hg : OAI.ActualEisensteinCubic.lambda ∉ P)
    (ψ : AddChar (O ⧸ P) ℂ) (j : Fin 6) (σ ε : (O ⧸ P)ˣ) (a : O) :
    localReflectionRow P ψ j σ ε a = OAI.LocalReflectionBrackets.activeRow
      (OAI.ActualEisensteinCubic.canonicalSextic P hg) ψ j.val σ ε
        (Ideal.Quotient.mk P a) := by
  have hcard : (Fintype.card (O ⧸ P) : ℂ) = (normIdeal P : ℂ) := by
    exact_mod_cast quotient_card_normIdeal P
  unfold localReflectionRow OAI.LocalReflectionBrackets.activeRow
  rw [hcard]
  have hneg (x : O) : localCharacterPower P (-2) x =
      (OAI.ActualEisensteinCubic.canonicalSextic P hg ^ 2)⁻¹
        (Ideal.Quotient.mk P x) := by
    simpa using localCharacterPower_neg_nat_eq c hP hout hg 2 x
  simp_rw [localCharacterPower_nat_eq c hP hout hg,
    hneg, residueLift_spec, inv_pow]

/-- The genuine local Gauss transformation produces precisely the frozen
three-case factor. Its scalar has norm one, uniformly in all local data. -/
theorem localReflectionRow_factor (c : ArithmeticContext) {P : Ideal O}
    [P.IsMaximal] (hP : Prime P) (hout : Outside c.S P)
    (ψ : AddChar (O ⧸ P) ℂ) (hψ : ψ.IsPrimitive)
    (j : Fin 6) (σ ε : (O ⧸ P)ˣ) :
    ∃ γ : ℂ, ‖γ‖ = 1 ∧ ∀ a : O,
      localReflectionRow P ψ j σ ε a = γ * thetaLocalFactor P j a := by
  let hg := outside_lambda_not_mem c hP hout
  let χ := OAI.ActualEisensteinCubic.canonicalSextic P hg
  let γ := ((χ⁻¹) ^ 2) σ * OAI.LocalReflectionBrackets.phase χ ψ j.val ε
  refine ⟨γ, ?_, ?_⟩
  · dsimp [γ]
    rw [norm_mul, OAI.FiniteRayExpansion.norm_char_unit,
      OAI.LocalReflectionBrackets.canonical_phase_norm P hg
        (outside_quotient_char_ne_two c hP hout) ψ hψ j.val j.isLt ε, one_mul]
  · intro a
    rw [localReflectionRow_eq_activeRow c hP hout hg,
      OAI.LocalReflectionBrackets.canonical_A5_normalized P hg
        (outside_quotient_char_ne_two c hP hout) ψ hψ j.val j.isLt σ ε,
      thetaLocalFactor_eq_bracket c hP hout hg]

/-- The actual primitive trace character, using the frozen positive embedding. -/
def reflectionTraceChar (q : O) (hq : q ≠ 0) : AddChar (O ⧸ principal q) ℂ :=
  OAI.ConcreteTraceCRT.eisTraceModChar OAI.ShortDraftTrace.breveE
    OAI.ConcreteBreveE.breveE_period_coordinates q hq

theorem reflectionTraceChar_mk (q : O) (hq : q ≠ 0) (a : O) :
    reflectionTraceChar q hq (Ideal.Quotient.mk (principal q) a) =
      additiveCharacter (embedding a / embedding q) := by
  change OAI.ShortDraftTrace.breveE (OAI.ConcreteTraceCRT.eisEmbedding a /
    (OAI.ConcreteTraceCRT.eisEmbedding q * OAI.ConcreteTraceCRT.eisLam)) = _
  rw [← div_div]
  change OAI.ShortDraftTrace.breveE
    ((OAI.ConcreteTraceCRT.eisEmbedding a / OAI.ConcreteTraceCRT.eisEmbedding q) /
      (1 + 2 * OAI.ShortDraftTrace.ω₃)) = _
  rw [OAI.ShortDraftTrace.breveE_div_lam_eq_e, oai_embedding_eq, oai_embedding_eq]
  unfold additiveCharacter
  congr 1
  push_cast
  ring

theorem reflectionTraceChar_primitive (q : O) (hq : q ≠ 0)
    [(principal q).IsMaximal] : (reflectionTraceChar q hq).IsPrimitive :=
  OAI.PrimitiveTrace.eisTraceModChar_breveE_primitive (principal q) q rfl hq

theorem reflectionTraceChar_lift (q : O) (hq : q ≠ 0) (x : O ⧸ principal q) :
    reflectionTraceChar q hq x =
      additiveCharacter (embedding (residueLift (principal q) x) / embedding q) := by
  rw [← residueLift_spec (principal q) x, reflectionTraceChar_mk, residueLift_spec]

/-- The local finite sum with literal residue lifts and the exact additive
character in the frozen Gauss sums. -/
def literalLocalReflectionRow (q : O) [(principal q).IsMaximal]
    (j : Fin 6) (σ ε : (O ⧸ principal q)ˣ) (a : O) : ℂ :=
  (normElement q : ℂ)⁻¹ * ∑ h : (O ⧸ principal q)ˣ,
    (∑ t : O ⧸ principal q,
      localCharacterPower (principal q) (j.val : ℤ) (residueLift (principal q) t) *
      additiveCharacter (embedding (residueLift (principal q) (-(h * t))) / embedding q)) *
      localCharacterPower (principal q) (-2) (residueLift (principal q) (σ * h)) *
      additiveCharacter (embedding (residueLift (principal q)
        (((ε : O ⧸ principal q) * Ideal.Quotient.mk (principal q) a) *
          ((h⁻¹ : (O ⧸ principal q)ˣ) : O ⧸ principal q))) / embedding q)

theorem literalLocalReflectionRow_eq (q : O) (hq : q ≠ 0)
    [(principal q).IsMaximal] (j : Fin 6) (σ ε : (O ⧸ principal q)ˣ) (a : O) :
    literalLocalReflectionRow q j σ ε a =
      localReflectionRow (principal q) (reflectionTraceChar q hq) j σ ε a := by
  simp only [literalLocalReflectionRow, localReflectionRow, normElement,
    reflectionTraceChar_lift]

/-- No primitive-character hypothesis is needed for the literal local sum:
the trace character has been constructed and its primitivity proved. -/
theorem literal_local_gauss_factor (c : ArithmeticContext) (q : O)
    [(principal q).IsMaximal] (hP : Prime (principal q))
    (hout : Outside c.S (principal q)) (j : Fin 6) (σ ε : (O ⧸ principal q)ˣ) :
    ∃ γ : ℂ, ‖γ‖ = 1 ∧ ∀ a : O,
      literalLocalReflectionRow q j σ ε a = γ * thetaLocalFactor (principal q) j a := by
  have hq : q ≠ 0 := Ideal.span_singleton_eq_bot.not.mp hP.ne_zero
  obtain ⟨γ, hγ, heq⟩ := localReflectionRow_factor c hP hout
    (reflectionTraceChar q hq) (reflectionTraceChar_primitive q hq) j σ ε
  refine ⟨γ, hγ, ?_⟩
  intro a
  rw [literalLocalReflectionRow_eq q hq]
  exact heq a

def localZeroFrequency (P : Ideal O) [P.IsMaximal] (j : Fin 6) : ℂ :=
  (normIdeal P : ℂ)⁻¹ * ∑ t : O ⧸ P,
    localCharacterPower P (j.val : ℤ) (residueLift P t)

theorem localZeroFrequency_eq_canonical (c : ArithmeticContext) {P : Ideal O}
    [P.IsMaximal] (hP : Prime P) (hout : Outside c.S P)
    (hg : OAI.ActualEisensteinCubic.lambda ∉ P) (j : Fin 6) :
    localZeroFrequency P j = OAI.LocalReflectionBrackets.zeroFourierCoefficient
      (OAI.ActualEisensteinCubic.canonicalSextic P hg) j.val := by
  have hcard : (Fintype.card (O ⧸ P) : ℂ) = (normIdeal P : ℂ) := by
    exact_mod_cast quotient_card_normIdeal P
  unfold localZeroFrequency OAI.LocalReflectionBrackets.zeroFourierCoefficient
  simp_rw [localCharacterPower_nat_eq c hP hout hg, residueLift_spec, hcard]

/-- Inactive primes are permitted exactly at exponent zero. -/
theorem localZeroFrequency_eq (c : ArithmeticContext) {P : Ideal O}
    [P.IsMaximal] (hP : Prime P) (hout : Outside c.S P) (j : Fin 6) :
    localZeroFrequency P j = if j.val = 0 then 1 - (normIdeal P : ℂ)⁻¹ else 0 := by
  have hcard : (Fintype.card (O ⧸ P) : ℂ) = (normIdeal P : ℂ) := by
    exact_mod_cast quotient_card_normIdeal P
  rw [localZeroFrequency_eq_canonical c hP hout (outside_lambda_not_mem c hP hout),
    OAI.LocalReflectionBrackets.canonical_zeroFourierCoefficient P
      (outside_lambda_not_mem c hP hout) (outside_quotient_char_ne_two c hP hout)
      j.val j.isLt, hcard]

theorem norm_localZeroFrequency_le_one (c : ArithmeticContext) {P : Ideal O}
    [P.IsMaximal] (hP : Prime P) (hout : Outside c.S P) (j : Fin 6) :
    ‖localZeroFrequency P j‖ ≤ 1 := by
  by_cases hj : j.val = 0
  · rw [localZeroFrequency_eq_canonical c hP hout
      (outside_lambda_not_mem c hP hout), hj]
    exact OAI.LocalReflectionBrackets.zeroFourierCoefficient_zero_norm_le_one _
  · rw [localZeroFrequency_eq c hP hout, if_neg hj, norm_zero]
    norm_num

theorem kubotaMultiplier_ramified_active (c : ArithmeticContext) (M : SL(2, O))
    (u c₀ r : O) (A : Finset (Ideal O))
    (hM : M * (lowerCuspMatrix u)⁻¹ ∈ OAI.ReflectionFEKubota.levelThree)
    (ha : IsPrimary (M 0 0)) (hr : IsPrimary r)
    (hc : M 1 0 = u * (c₀ * r)) (hgen : principal r = ∏ P ∈ A, P)
    (hA : ∀ P ∈ A, Prime P ∧ Outside c.S P) :
    kubotaMultiplier ⟨M * (lowerCuspMatrix u)⁻¹, hM⟩ =
      (cubicSymbol (principal (M 0 0 - u * M 0 1)) (-u) *
        cubicSymbol (principal (M 0 0)) c₀) *
          ∏ P ∈ A, localCharacterPower P 2 (M 0 0) := by
  rw [kubotaMultiplier_factor_ramified M u c₀ r hM ha hr hc, hgen,
    cubicSymbol_active_product c A hA]

theorem kubotaMultiplier_unramified_active (c : ArithmeticContext) (M : SL(2, O))
    (u c₀ r : O) (A : Finset (Ideal O))
    (hM : M * (weylCuspMatrix u)⁻¹ ∈ OAI.ReflectionFEKubota.levelThree)
    (hcprimary : IsPrimary (M 1 0)) (hr : IsPrimary r)
    (hc : M 1 0 = c₀ * r) (h9 : (9 : O) ∣ M 0 0 * M 1 1)
    (hgen : principal r = ∏ P ∈ A, P)
    (hA : ∀ P ∈ A, Prime P ∧ Outside c.S P) :
    kubotaMultiplier ⟨M * (weylCuspMatrix u)⁻¹, hM⟩ =
      cubicSymbol (principal c₀) (M 0 0) *
        ∏ P ∈ A, localCharacterPower P 2 (M 0 0) := by
