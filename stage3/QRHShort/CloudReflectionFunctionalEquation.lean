theorem tau_ramified_primary_cube (n b : O) (hnb : PrimaryCubeData n b)
    (k : ℕ) (hk : 1 ≤ k) (j : Fin 3) :
    tau (embedding omega ^ j.val * embedding lambda ^ ((3 : ℤ) * k - 4) *
        embedding (n * b ^ 3)) =
