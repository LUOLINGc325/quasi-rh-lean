noncomputable section
open Classical
open scoped BigOperators

namespace QRHShort.CloudBatch.ReflectionRamifiedCubeCount
open QRHShort ReflectionRamifiedFourierSupport ReflectionResidual
open OAI.ActualEisensteinCoordinates
local notation "lam" => OAI.ActualEisensteinCubic.lambda

def traceDelta : O := 1 + 2 * omega

theorem lambda_cube_eq_three_delta : lam ^ 3 = 3 * traceDelta := by
  change (omega - 1) ^ 3 = 3 * (1 + 2 * omega)
  linear_combination (omega - 4) * omega_sq_add_omega_add_one

private theorem lambda_ne_zero : lam ≠ 0 :=
  OAI.PrimaryIdealUnitReindex.lambda_prime_actual.ne_zero

theorem traceDelta_ne_zero : traceDelta ≠ 0 := by
  intro h
  have h0 : lam ^ 3 = 0 := by rw [lambda_cube_eq_three_delta, h, mul_zero]
  exact pow_ne_zero 3 lambda_ne_zero h0

abbrev CubeQuotient := O ⧸ principal (lam ^ 3)

instance cubeQuotientFinite : Finite CubeQuotient :=
  Ring.HasFiniteQuotients.finiteQuotient
    (Ideal.span_singleton_eq_bot.not.mpr (pow_ne_zero 3 lambda_ne_zero))

noncomputable instance cubeQuotientFintype : Fintype CubeQuotient := Fintype.ofFinite _

private theorem three_dvd_integer_iff (n : ℤ) :
    (3 : O) ∣ (n : O) ↔ (3 : ℤ) ∣ n := by
  have he : (n : O) = eval n 0 := by simp [eval]
  rw [three_dvd_iff_coords, he, OAI.ShortDraftLatticeCount.coords_eval]
  simp

def integerMultiple : ℤ →+ CubeQuotient where
  toFun n := Ideal.Quotient.mk (principal (lam ^ 3)) (traceDelta * (n : O))
  map_zero' := by simp
  map_add' a b := by simp [mul_add]

theorem integerMultiple_three : integerMultiple 3 = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  apply Ideal.mem_span_singleton.mpr
  refine ⟨1, ?_⟩
  change traceDelta * 3 = lam ^ 3 * 1
  rw [lambda_cube_eq_three_delta]
  ring

/-- The integer prototype is ZMod 3, rather than the nine-point ring O/(3). -/
def integerClass : ZMod 3 →+ CubeQuotient :=
  ZMod.lift 3 ⟨integerMultiple, integerMultiple_three⟩

theorem integerClass_intCast (n : ℤ) :
    integerClass (n : ZMod 3) =
      Ideal.Quotient.mk (principal (lam ^ 3)) (traceDelta * (n : O)) := by
  exact ZMod.lift_coe _ _ _

theorem integerClass_injective : Function.Injective integerClass := by
  intro x y hxy
  obtain ⟨a, rfl⟩ := ZMod.intCast_surjective x
  obtain ⟨b, rfl⟩ := ZMod.intCast_surjective y
  rw [integerClass_intCast, integerClass_intCast] at hxy
  obtain ⟨k, hk⟩ := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq.mp hxy)
  have hc : (a : O) - (b : O) = 3 * k := by
    apply mul_left_cancel₀ traceDelta_ne_zero
    rw [mul_sub]
    calc
      traceDelta * (a : O) - traceDelta * (b : O) = lam ^ 3 * k := hk
      _ = traceDelta * (3 * k) := by rw [lambda_cube_eq_three_delta]; ring
  have hd : (3 : ℤ) ∣ a - b :=
    (three_dvd_integer_iff (a - b)).mp ⟨k, by push_cast; exact hc⟩
  apply sub_eq_zero.mp
  rw [← Int.cast_sub, ZMod.intCast_zmod_eq_zero_iff_dvd]
  exact hd

def integerClasses : Finset CubeQuotient := Finset.univ.image integerClass

theorem mem_integerClasses (r : CubeQuotient) :
    r ∈ integerClasses ↔
      ∃ n : ℤ, r = Ideal.Quotient.mk (principal (lam ^ 3)) (traceDelta * (n : O)) := by
  constructor
  · intro hr
    obtain ⟨x, _, hx⟩ := Finset.mem_image.mp hr
    obtain ⟨n, rfl⟩ := ZMod.intCast_surjective x
    exact ⟨n, hx.symm.trans (integerClass_intCast n)⟩
  · rintro ⟨n, rfl⟩
    exact Finset.mem_image.mpr ⟨(n : ZMod 3), Finset.mem_univ _, integerClass_intCast n⟩

theorem integerClasses_card : integerClasses.card = 3 := by
  rw [integerClasses, Finset.card_image_of_injective _ integerClass_injective]
  norm_num

theorem integer_congruence_count :
    (∑ r : CubeQuotient, if ∃ n : ℤ,
      r = Ideal.Quotient.mk (principal (lam ^ 3)) (traceDelta * (n : O))
      then (1 : ℕ) else 0) = 3 := by
  simp_rw [← mem_integerClasses]
  have hh : (Finset.univ.filter fun r : CubeQuotient => r ∈ integerClasses) =
      integerClasses := by
    ext r
    simp
  simpa only [Finset.sum_boole, hh, Nat.cast_id] using integerClasses_card

def affineEquiv (a0 c : O) (hc : IsCoprime c lam) : CubeQuotient ≃ CubeQuotient :=
  (Units.mulRight (quotient_unit_of_isCoprime (lam ^ 3) c hc.pow_right).unit).trans
    (Equiv.addLeft (Ideal.Quotient.mk (principal (lam ^ 3)) a0))

theorem affineEquiv_apply (a0 c : O) (hc : IsCoprime c lam) (q : CubeQuotient) :
    affineEquiv a0 c hc q = Ideal.Quotient.mk (principal (lam ^ 3)) a0 +
      q * Ideal.Quotient.mk (principal (lam ^ 3)) c := by
  simp [affineEquiv, Units.mulRight, IsUnit.unit_spec]

theorem affine_integer_congruence_count (a0 c : O) (hc : IsCoprime c lam) :
    (∑ q : CubeQuotient, if ∃ n : ℤ,
      Ideal.Quotient.mk (principal (lam ^ 3)) a0 +
        q * Ideal.Quotient.mk (principal (lam ^ 3)) c =
          Ideal.Quotient.mk (principal (lam ^ 3)) (traceDelta * (n : O))
      then (1 : ℕ) else 0) = 3 := by
  let f : CubeQuotient → ℕ := fun r => if ∃ n : ℤ,
    r = Ideal.Quotient.mk (principal (lam ^ 3)) (traceDelta * (n : O)) then 1 else 0
  have he := Fintype.sum_equiv (affineEquiv a0 c hc) (fun q => f (affineEquiv a0 c hc q)) f
    (fun _ => rfl)
  simpa only [f, affineEquiv_apply] using he.trans integer_congruence_count

theorem affine_integer_divisibility_count (a0 c : O) (hc : IsCoprime c lam) :
    (∑ q : CubeQuotient, if ∃ n : ℤ,
      lam ^ 3 ∣ a0 + residueLift (principal (lam ^ 3)) q * c - traceDelta * (n : O)
      then (1 : ℕ) else 0) = 3 := by
  have he (q : CubeQuotient) :
      (∃ n : ℤ, lam ^ 3 ∣ a0 + residueLift (principal (lam ^ 3)) q * c - traceDelta * (n : O)) ↔
      ∃ n : ℤ, Ideal.Quotient.mk (principal (lam ^ 3)) a0 +
        q * Ideal.Quotient.mk (principal (lam ^ 3)) c =
          Ideal.Quotient.mk (principal (lam ^ 3)) (traceDelta * (n : O)) := by
    apply exists_congr
    intro n
    rw [← Ideal.mem_span_singleton, ← Ideal.Quotient.eq]
    change (Ideal.Quotient.mk (principal (lam ^ 3))
      (a0 + residueLift (principal (lam ^ 3)) q * c) =
        Ideal.Quotient.mk (principal (lam ^ 3)) (traceDelta * (n : O))) ↔ _
    have hq : Ideal.Quotient.mk (principal (lam ^ 3))
        (residueLift (principal (lam ^ 3)) q) = q :=
      Classical.choose_spec (Ideal.Quotient.mk_surjective q)
    simpa only [map_add, map_mul, hq]
  simp_rw [he]
  exact affine_integer_congruence_count a0 c hc

theorem affine_integer_divisibility_count_complex (a0 c : O) (hc : IsCoprime c lam) :
    (∑ q : CubeQuotient, if ∃ n : ℤ,
      lam ^ 3 ∣ a0 + residueLift (principal (lam ^ 3)) q * c - traceDelta * (n : O)
      then (1 : ℂ) else 0) = 3 := by
  exact_mod_cast affine_integer_divisibility_count a0 c hc

end QRHShort.CloudBatch.ReflectionRamifiedCubeCount
end
